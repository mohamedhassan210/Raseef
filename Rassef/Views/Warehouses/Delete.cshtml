@model Rassef.ViewModels.Warehouse.WarehouseListVM
@{
    ViewData["Title"] = "حذف مستودع";
    Layout = "_SupOrTra";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/addCar.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/companyCars.css" asp-append-version="true">

<main class="page-container">

    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">حذف مستودع</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيف" class="logo-raseefy">
        </div>
    </header>

    <div class="nav-actions-container" style="justify-content: flex-end;">
        <a href="@Url.Action("Index", "Warehouses")" class="action-btn" aria-label="رجوع">
            رجوع
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="form-card mt-3">

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="background-color: #fde8e8; color: #dc3545; padding: 12px 20px; border-radius: 10px; font-weight: 700; margin-bottom: 16px;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        @if (Model != null && Model.Id > 0)
        {
            <p class="fw-bold mb-4" style="font-size: 18px; color: #333;">
                هل أنت متأكد من حذف المستودع التالي؟
            </p>

            <div class="row mb-4 gy-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold">اسم المستودع</label>
                    <input type="text" class="form-control custom-input" value="@Model.Name" readonly>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">الموقع</label>
                    <input type="text" class="form-control custom-input" value="@Model.Location" readonly>
                </div>
                @if (Model.DepartmentsCount > 0 || Model.DocksCount > 0)
                {
                    <div class="col-12">
                        <div style="background-color: #fff3cd; color: #856404; padding: 12px 20px; border-radius: 10px; font-weight: 700;">
                            تنبيه: هذا المستودع يحتوي على @Model.DepartmentsCount قسم و @Model.DocksCount رصيف مرتبطة به.
                            لن يتم تنفيذ الحذف إذا كانت هذه الارتباطات موجودة.
                        </div>
                    </div>
                }
            </div>

            <form asp-action="Delete" asp-controller="Warehouses" method="post"
                  onsubmit="return confirm('هل أنت متأكد من حذف هذا المستودع؟');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="d-flex gap-3">
                    <button type="submit" class="w-100 btn btn-danger mt-2" style="border-radius: 12px; font-weight: 700; font-size: 16px; padding: 12px;">
                        تأكيد الحذف
                    </button>
                    <a href="@Url.Action("Index", "Warehouses")" class="w-100 submit-btn mt-2" style="text-decoration:none; text-align:center;">
                        إلغاء
                    </a>
                </div>
            </form>
        }

    </section>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
