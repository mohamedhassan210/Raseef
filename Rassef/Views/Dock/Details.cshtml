@model Rassef.ViewModels.Dock.DockDetailsVM
@{
    ViewData["Title"] = "تفاصيل الرصيف";
    Layout = "_SupOrTra";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/addCar.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/companyCars.css" asp-append-version="true">

<main class="page-container">

    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">تفاصيل الرصيف</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيف" class="logo-raseefy">
        </div>
    </header>

    <div class="nav-actions-container" style="justify-content: flex-end;">
        <a href="@Url.Action("Index", "Dock")" class="action-btn" aria-label="رجوع">
            رجوع
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="form-card mt-3">

        @if (Model != null && Model.Id > 0)
        {
            <div class="row mb-4 gy-4">

                <div class="col-md-6">
                    <label class="form-label fw-bold">اسم الرصيف</label>
                    <input type="text" class="form-control custom-input" value="@Model.DockName" readonly>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">المستودع</label>
                    <input type="text" class="form-control custom-input" value="@Model.WarehouseName" readonly>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">القسم</label>
                    <input type="text" class="form-control custom-input" value="@Model.DepartmentName" readonly>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">الحالة</label>
                    <input type="text" class="form-control custom-input" value="@Model.DockStatusName" readonly>
                </div>

            </div>

            <div class="d-flex gap-3 mt-3">
                <a href="@Url.Action("Update", "Dock", new { id = Model.Id })" class="w-100 submit-btn mt-2" style="text-decoration:none; text-align:center;">
                    تعديل
                </a>
                <a href="@Url.Action("Delete", "Dock", new { id = Model.Id })" class="w-100 mt-2 btn btn-danger" style="border-radius: 12px; font-weight: 700; font-size: 16px;">
                    حذف
                </a>
            </div>
        }
        else
        {
            <p style="color: #dc3545; font-weight: 700;">هذا الرصيف غير موجود.</p>
        }

    </section>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
