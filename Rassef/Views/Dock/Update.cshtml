@model Rassef.ViewModels.Dock.UpdateDockVM
@{
    ViewData["Title"] = "تعديل رصيف";
    Layout = "_SupOrTra";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/addCar.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/companyCars.css" asp-append-version="true">

<style>
    .custom-dropdown {
        position: relative;
        width: 100%;
        font-family: 'IBM Plex Sans Arabic', sans-serif;
    }

        .custom-dropdown .dropdown-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 16px;
            border: 1.5px solid #e8c8a8;
            border-radius: 12px;
            background: #fff;
            cursor: pointer;
            user-select: none;
            font-size: 15px;
            min-height: 44px;
        }

            .custom-dropdown .dropdown-header:hover {
                border-color: var(--primary-color, #E67E22);
            }

        .custom-dropdown .dropdown-arrow {
            transition: transform 0.2s;
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .custom-dropdown.open .dropdown-arrow {
            transform: rotate(180deg);
        }

        .custom-dropdown .dropdown-list {
            display: none;
            position: absolute;
            top: calc(100% + 4px);
            right: 0;
            left: 0;
            background: #fff;
            border: 1.5px solid #e8c8a8;
            border-radius: 12px;
            z-index: 200;
            max-height: 220px;
            overflow-y: auto;
            box-shadow: 0 4px 16px rgba(0,0,0,0.10);
        }

        .custom-dropdown.open .dropdown-list {
            display: block;
        }

        .custom-dropdown .dropdown-list .dropdown-item {
            padding: 10px 16px;
            cursor: pointer;
            font-size: 15px;
            border-bottom: 1px solid #faede2;
            transition: background 0.15s;
        }

            .custom-dropdown .dropdown-list .dropdown-item:last-child {
                border-bottom: none;
            }

            .custom-dropdown .dropdown-list .dropdown-item:hover {
                background: #fdf1e7;
            }

            .custom-dropdown .dropdown-list .dropdown-item.selected {
                background: #fde8cb;
                font-weight: 700;
            }

    .placeholder-color {
        color: #aaa;
    }

    .selected-value {
        color: #333;
    }
</style>

<main class="page-container">

    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">تعديل رصيف</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيف" class="logo-raseefy">
        </div>
    </header>

    <div class="nav-actions-container" style="justify-content: flex-end;">
        <a href="@Url.Action("Index", "Dock")" class="action-btn" aria-label="رجوع">
            رجوع
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="form-card mt-3">
        <form asp-action="Update" asp-controller="Dock" method="post" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background-color: #fde8e8; color: #dc3545; padding: 12px 20px; border-radius: 10px; font-weight: 700; margin-bottom: 16px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="row mb-4 gy-4">

                <div class="col-md-6">
                    <label asp-for="DockName" class="form-label fw-bold">اسم الرصيف</label>
                    <input asp-for="DockName" type="text" class="form-control custom-input" placeholder="ادخل اسم الرصيف" required>
                    <span asp-validation-for="DockName" class="text-danger"></span>
                </div>

                <!-- القسم -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">القسم</label>

                    <select id="departmentSelect" name="DepartmentId" class="d-none" required>
                        <option value="" disabled>اختر القسم</option>
                        @if (Model.Departments != null)
                        {
                            foreach (var d in Model.Departments)
                            {
                                <option value="@d.Value" selected="@(d.Value == Model.DepartmentId.ToString())">
                                    @d.Text
                                </option>
                            }
                        }
                    </select>

                    <div class="custom-dropdown" id="departmentDropdown">
                        <div class="dropdown-header" id="departmentDropdownHeader">
                            <span class="selected-value placeholder-color" id="departmentSelectedText">اختر القسم</span>
                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="18 15 12 9 6 15"></polyline>
                            </svg>
                        </div>
                        <div class="dropdown-list" id="departmentDropdownList"></div>
                    </div>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>

                <!-- المستودع -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">المستودع</label>

                    <select id="warehouseSelect" name="WarehouseId" class="d-none" required>
                        <option value="" disabled>اختر المستودع</option>
                        @if (Model.Warehouses != null)
                        {
                            foreach (var w in Model.Warehouses)
                            {
                                <option value="@w.Value" selected="@(w.Value == Model.WarehouseId.ToString())">
                                    @w.Text
                                </option>
                            }
                        }
                    </select>

                    <div class="custom-dropdown" id="warehouseDropdown">
                        <div class="dropdown-header" id="warehouseDropdownHeader">
                            <span class="selected-value placeholder-color" id="warehouseSelectedText">اختر المستودع</span>
                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="18 15 12 9 6 15"></polyline>
                            </svg>
                        </div>
                        <div class="dropdown-list" id="warehouseDropdownList"></div>
                    </div>
                    <span asp-validation-for="WarehouseId" class="text-danger"></span>
                </div>

                <!-- حالة الرصيف -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">حالة الرصيف</label>

                    <select id="statusSelect" name="DockStatusId" class="d-none" required>
                        <option value="" disabled>اختر حالة الرصيف</option>
                        @if (Model.DockStatus != null)
                        {
                            foreach (var s in Model.DockStatus)
                            {
                                <option value="@s.Value" selected="@(s.Value == Model.DockStatusId.ToString())">
                                    @s.Text
                                </option>
                            }
                        }
                    </select>

                    <div class="custom-dropdown" id="statusDropdown">
                        <div class="dropdown-header" id="statusDropdownHeader">
                            <span class="selected-value placeholder-color" id="statusSelectedText">اختر حالة الرصيف</span>
                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="18 15 12 9 6 15"></polyline>
                            </svg>
                        </div>
                        <div class="dropdown-list" id="statusDropdownList"></div>
                    </div>
                    <span asp-validation-for="DockStatusId" class="text-danger"></span>
                </div>

            </div>

            <button type="submit" class="w-100 submit-btn mt-4">حفظ التعديلات</button>
        </form>
    </section>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function setupDropdown(selectId, dropdownId, headerId, listId, selectedTextId, placeholder) {
            const select       = document.getElementById(selectId);
            const dropdown     = document.getElementById(dropdownId);
            const header       = document.getElementById(headerId);
            const list         = document.getElementById(listId);
            const selectedText = document.getElementById(selectedTextId);
            if (!select || !dropdown || !header || !list || !selectedText) return;

            Array.from(select.options).forEach(opt => {
                if (!opt.value) return;
                const item = document.createElement('div');
                item.className = 'dropdown-item' + (opt.selected ? ' selected' : '');
                item.textContent = opt.text;
                item.dataset.value = opt.value;
                item.addEventListener('click', () => {
                    select.value = opt.value;
                    selectedText.textContent = opt.text;
                    selectedText.classList.remove('placeholder-color');
                    selectedText.classList.add('selected-value');
                    list.querySelectorAll('.dropdown-item').forEach(i => i.classList.remove('selected'));
                    item.classList.add('selected');
                    dropdown.classList.remove('open');
                });
                list.appendChild(item);
            });

            if (select.value) {
                const sel = select.options[select.selectedIndex];
                if (sel && sel.value) {
                    selectedText.textContent = sel.text;
                    selectedText.classList.remove('placeholder-color');
                }
            }

            header.addEventListener('click', () => dropdown.classList.toggle('open'));
            document.addEventListener('click', e => {
                if (!dropdown.contains(e.target)) dropdown.classList.remove('open');
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            setupDropdown('departmentSelect', 'departmentDropdown', 'departmentDropdownHeader', 'departmentDropdownList', 'departmentSelectedText', 'اختر القسم');
            setupDropdown('warehouseSelect', 'warehouseDropdown', 'warehouseDropdownHeader', 'warehouseDropdownList', 'warehouseSelectedText', 'اختر المستودع');
            setupDropdown('statusSelect', 'statusDropdown', 'statusDropdownHeader', 'statusDropdownList', 'statusSelectedText', 'اختر حالة الرصيف');
        });
    </script>
}