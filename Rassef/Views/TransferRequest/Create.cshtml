@model CreateTransferRequestVM
@{
    ViewData["Title"] = "إضافة طلب تحويل";
    Layout = "_SupOrTra";
    ViewData["ActiveSidebar"] = "TransferRequests";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/addCar.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/companyCars.css" asp-append-version="true">

<style>
    /* Custom dropdown — copied verbatim from SupplierRequest/Create.cshtml */
    .custom-dropdown { position: relative; width: 100%; font-family: 'IBM Plex Sans Arabic', sans-serif; }
    .custom-dropdown .dropdown-header { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; border: 1.5px solid #e8c8a8; border-radius: 12px; background: #fff; cursor: pointer; user-select: none; font-size: 15px; min-height: 44px; }
    .custom-dropdown .dropdown-header:hover { border-color: var(--primary-color, #E67E22); }
    .custom-dropdown .dropdown-arrow { transition: transform 0.2s; width: 18px; height: 18px; flex-shrink: 0; }
    .custom-dropdown.open .dropdown-arrow { transform: rotate(180deg); }
    .custom-dropdown .dropdown-list { display: none; position: absolute; top: calc(100% + 4px); right: 0; left: 0; background: #fff; border: 1.5px solid #e8c8a8; border-radius: 12px; z-index: 200; max-height: 220px; overflow-y: auto; box-shadow: 0 4px 16px rgba(0,0,0,0.10); }
    .custom-dropdown.open .dropdown-list { display: block; }
    .custom-dropdown .dropdown-list .dropdown-item { padding: 10px 16px; cursor: pointer; font-size: 15px; border-bottom: 1px solid #faede2; transition: background 0.15s; }
    .custom-dropdown .dropdown-list .dropdown-item:last-child { border-bottom: none; }
    .custom-dropdown .dropdown-list .dropdown-item:hover { background: #fdf1e7; }
    .custom-dropdown .dropdown-list .dropdown-item.selected { background: #fde8cb; font-weight: 700; }
    .custom-dropdown .dropdown-list .dropdown-item.disabled { cursor: default; color: #aaa; }
    .placeholder-color { color: #aaa; }
    .selected-value    { color: #333; }
</style>

<main class="page-container">

    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">إضافة طلب تحويل</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيف" class="logo-raseefy">
        </div>
    </header>

    <div class="nav-actions-container" style="justify-content: flex-end;">
        <a href="@Url.Action("Index", "TransferRequest")" class="action-btn" aria-label="رجوع">
            رجوع
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="form-card mt-3">
        <form asp-action="Create" asp-controller="TransferRequest" method="post" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background-color: #fde8e8; color: #dc3545; padding: 12px 20px; border-radius: 10px; font-weight: 700; margin-bottom: 16px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="row mb-4 gy-4">

                <!-- القسم -->
                @await Html.PartialAsync("_SelectDropdown", new SelectDropdownVM("DepartmentId", "القسم", Model.Departments, Model.DepartmentId, "اختر القسم"))

                <!-- الرصيف — بيتفلتر تلقائياً حسب القسم المختار فوق، ويتعطل
                     أي رصيف ممتلئ أو تحت الصيانة -->
                @await Html.PartialAsync("_SelectDropdown", new SelectDropdownVM("DockId", "الرصيف (اختياري)", new List<SelectListItem>(), Model.DockId, "اختر القسم الأول", required: false))

                @await Html.PartialAsync("_SelectDropdown", new SelectDropdownVM("PermitTypeId", "نوع الإذن", Model.PermitTypes, Model.PermitTypeId, "اختر نوع الإذن"))
                @await Html.PartialAsync("_SelectDropdown", new SelectDropdownVM("TruckId", "الشاحنة", Model.Trucks, Model.TruckId, "اختر الشاحنة", required: false))
                @await Html.PartialAsync("_SelectDropdown", new SelectDropdownVM("DriverId", "السائق", Model.Drivers, Model.DriverId, "اختر السائق", required: false))

                <div class="col-md-6">
                    <label asp-for="PermitNumber" class="form-label fw-bold">رقم الإذن</label>
                    <input asp-for="PermitNumber" type="text" class="form-control custom-input" placeholder="سيُنشأ تلقائياً لو تُرك فارغاً">
                    <span asp-validation-for="PermitNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="AvizNumber" class="form-label fw-bold">رقم الأفيز</label>
                    <input asp-for="AvizNumber" type="text" class="form-control custom-input" placeholder="سيُنشأ تلقائياً لو تُرك فارغاً">
                    <span asp-validation-for="AvizNumber" class="text-danger"></span>
                </div>

            </div>

            <button type="submit" class="w-100 submit-btn mt-4">إضافة طلب التحويل</button>
        </form>
    </section>

</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // بيانات كل الأرصفة (كل الأقسام) مع سعتها وحالتها الحالية — بتوصل
        // مرة واحدة مع الصفحة، وبتتفلتر في المتصفح حسب القسم المختار بدل
        // ما نعمل Request جديد لكل تغيير في القسم.
        window.allDocks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.AllDocks.Select(d => new {
                id = d.Id,
                name = d.DockName,
                departmentId = d.DepartmentId,
                occupancy = d.Occupancy,
                maxTruckCount = d.MaxTruckCount,
                isUnderMaintenance = d.IsUnderMaintenance,
                isSelectable = d.IsSelectable,
                disabledReasonLabel = d.DisabledReasonLabel
            })
        ));

        // setupDropdown — syncs a styled custom dropdown UI with a hidden native <select>.
        // نفس الدالة بالظبط من SupplierRequest/Create.cshtml.
        function setupDropdown(selectId, dropdownId, headerId, listId, selectedTextId) {
            const select = document.getElementById(selectId);
            const dropdown = document.getElementById(dropdownId);
            const header = document.getElementById(headerId);
            const list = document.getElementById(listId);
            const selectedText = document.getElementById(selectedTextId);

            if (!select || !dropdown || !header || !list || !selectedText) return;

            Array.from(select.options).forEach(opt => {
                if (!opt.value) return;
                const item = document.createElement('div');
                item.className = 'dropdown-item' + (opt.selected ? ' selected' : '');
                item.textContent = opt.text;
                item.dataset.value = opt.value;

                item.addEventListener('click', () => {
                    select.value = opt.value;
                    selectedText.textContent = opt.text;
                    selectedText.classList.remove('placeholder-color');
                    selectedText.classList.add('selected-value');
                    list.querySelectorAll('.dropdown-item').forEach(i => i.classList.remove('selected'));
                    item.classList.add('selected');
                    dropdown.classList.remove('open');
                    select.dispatchEvent(new Event('change', { bubbles: true }));
                });

                list.appendChild(item);
            });

            if (select.value) {
                const sel = select.options[select.selectedIndex];
                if (sel && sel.value) {
                    selectedText.textContent = sel.text;
                    selectedText.classList.remove('placeholder-color');
                }
            }

            header.addEventListener('click', () => dropdown.classList.toggle('open'));

            document.addEventListener('click', e => {
                if (!dropdown.contains(e.target)) dropdown.classList.remove('open');
            });
        }

        // بيعيد بناء قائمة الأرصفة حسب القسم المختار، ويعطّل (Dim) أي رصيف
        // ممتلئ أو تحت الصيانة بدل ما يمسحه من القائمة خالص.
        function refreshDocks(departmentId) {
            const select = document.getElementById('DockIdSelect');
            const list = document.getElementById('DockIdDropdownList');
            const selectedText = document.getElementById('DockIdSelectedText');
            if (!select || !list || !selectedText) return;

            const previouslySelected = select.value;
            select.innerHTML = '';
            list.innerHTML = '';

            const placeholderOpt = document.createElement('option');
            placeholderOpt.value = '';
            placeholderOpt.disabled = true;
            placeholderOpt.textContent = 'بدون رصيف محدد';
            select.appendChild(placeholderOpt);

            const docks = (window.allDocks || []).filter(d => String(d.departmentId) === String(departmentId));

            if (!departmentId) {
                selectedText.textContent = 'اختر القسم الأول';
                selectedText.classList.add('placeholder-color');
                selectedText.classList.remove('selected-value');
                select.value = '';
                return;
            }

            if (docks.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'dropdown-item disabled text-muted';
                empty.textContent = 'لا توجد أرصفة لهذا القسم';
                list.appendChild(empty);
            }

            let stillValid = false;

            docks.forEach(dock => {
                const opt = document.createElement('option');
                opt.value = dock.id;
                opt.textContent = dock.name + dock.disabledReasonLabel;
                if (!dock.isSelectable) opt.disabled = true;
                select.appendChild(opt);

                const item = document.createElement('div');
                item.className = 'dropdown-item' + (dock.isSelectable ? '' : ' disabled');
                item.textContent = dock.name + ' — ' + dock.occupancy + '/' + dock.maxTruckCount + dock.disabledReasonLabel;
                item.dataset.value = dock.id;

                if (dock.isSelectable) {
                    item.addEventListener('click', () => {
                        select.value = dock.id;
                        selectedText.textContent = dock.name;
                        selectedText.classList.remove('placeholder-color');
                        selectedText.classList.add('selected-value');
                        list.querySelectorAll('.dropdown-item').forEach(i => i.classList.remove('selected'));
                        item.classList.add('selected');
                        document.getElementById('DockIdDropdown')?.classList.remove('open');
                    });

                    if (String(dock.id) === String(previouslySelected)) {
                        stillValid = true;
                        item.classList.add('selected');
                    }
                }

                list.appendChild(item);
            });

            if (stillValid) {
                select.value = previouslySelected;
                const match = docks.find(d => String(d.id) === String(previouslySelected));
                if (match) {
                    selectedText.textContent = match.name;
                    selectedText.classList.remove('placeholder-color');
                    selectedText.classList.add('selected-value');
                }
            } else {
                select.value = '';
                selectedText.textContent = 'بدون رصيف محدد';
                selectedText.classList.add('placeholder-color');
                selectedText.classList.remove('selected-value');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            ['DepartmentId', 'DockId', 'PermitTypeId', 'TruckId', 'DriverId']
                .forEach(field => setupDropdown(
                    field + 'Select',
                    field + 'Dropdown',
                    field + 'DropdownHeader',
                    field + 'DropdownList',
                    field + 'SelectedText'
                ));

            const departmentSelect = document.getElementById('DepartmentIdSelect');
            if (departmentSelect) {
                departmentSelect.addEventListener('change', () => refreshDocks(departmentSelect.value));
                refreshDocks(departmentSelect.value);
            }
        });
    </script>
}
