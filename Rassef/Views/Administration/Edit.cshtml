@model Rassef.ViewModels.Administration.Employee.EmployeeEditVM
@{
    ViewData["Title"] = "تعديل الموظف";
    Layout = "_SupOrTra";
    var positions = ViewBag.Positions as IEnumerable<Rassef.Models.Entities.Position> ?? new List<Rassef.Models.Entities.Position>();
    var groups = ViewBag.Groups as IEnumerable<Rassef.Models.Identity.UserGroup> ?? new List<Rassef.Models.Identity.UserGroup>();
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="~/css/editEmployee.css" asp-append-version="true">
}

<main class="page-container">
    <!-- Header -->
    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">تعديل الموظف</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="logo-raseefy" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
        </div>
    </header>

    <!-- Navigation Action -->
    <div class="nav-actions-container" style="justify-content: flex-end;">
        <a href="@Url.Action("Details", "Administration", new { id = Model?.Id })" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <!-- Form Card -->
    <section id="formSection" class="form-card mt-3">
        <form method="post" action="@Url.Action("Edit", "Administration")" id="editEmployeeForm" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model?.Id" />

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger text-end mb-4">
                    <ul class="mb-0" style="list-style-type: none; padding-right: 0;">
                        @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@modelError.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="row mb-4 gy-4">

                <!-- اسم الموظف -->
                <div class="col-md-6 order-md-1">
                    <label for="empName" class="form-label fw-bold">اسم الموظف</label>
                    <div class="position-relative">
                        <input type="text" class="form-control custom-input" id="empName" name="Name" value="@Model?.Name" placeholder="ادخل اسم الموظف رباعي" required autocomplete="off">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال اسم الموظف.</div>
                    </div>
                </div>

                <!-- رقم الهاتف -->
                <div class="col-md-6 order-md-2">
                    <label for="empPhone" class="form-label fw-bold">رقم الهاتف</label>
                    <div class="position-relative">
                        <input type="tel" class="form-control custom-input" id="empPhone" name="Phone" value="@Model?.Phone" placeholder="ادخل رقم الهاتف (11 رقم - 01xxxxxxxxx)" pattern="^01[0125][0-9]{8}$" maxlength="11" inputmode="numeric" required autocomplete="tel" dir="rtl">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال رقم هاتف مصري صحيح (11 رقم يبدأ بـ 010 أو 011 أو 012 أو 015).</div>
                    </div>
                </div>

                <!-- البريد الإلكتروني -->
                <div class="col-md-6 order-md-3">
                    <label for="empEmail" class="form-label fw-bold">البريد الإلكتروني</label>
                    <div class="position-relative">
                        <input type="email" class="form-control custom-input text-end" id="empEmail" name="Email" value="@Model?.Email" placeholder="ادخل البريد الإلكتروني للموظف" required autocomplete="email">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال بريد إلكتروني صحيح.</div>
                    </div>
                </div>

                <!-- الرقم القومي -->
                <div class="col-md-6 order-md-4">
                    <label for="empNationalId" class="form-label fw-bold">الرقم القومي</label>
                    <div class="position-relative">
                        <input type="text" class="form-control custom-input" id="empNationalId" name="NationalId" value="@Model?.NationalId" placeholder="ادخل الرقم القومي (14 رقم)" pattern="^[0-9]{14}$" maxlength="14" minlength="14" inputmode="numeric" required autocomplete="off">
                        <div class="invalid-feedback text-center mt-2">الرقم القومي يجب أن يتكون من 14 رقمًا بالضبط.</div>
                    </div>
                </div>

                <!-- الدور الوظيفي -->
                <div class="col-md-6 order-md-5">
                    <label class="form-label fw-bold" for="empRoleSelect">الدور الوظيفي</label>
                    <div class="position-relative custom-dropdown-container">
                        <select class="visually-hidden-select" id="empRoleSelect" name="PositionId" required>
                            @if (Model == null || Model.PositionId == 0)
                            {
                                <option value="" disabled selected>اختار الدور</option>
                            }
                            else
                            {
                                <option value="" disabled>اختار الدور</option>
                            }
                            @foreach (var pos in positions)
                            {
                                if (Model?.PositionId == pos.Id)
                                {
                                    <option value="@pos.Id" selected>@pos.PositionName</option>
                                }
                                else
                                {
                                    <option value="@pos.Id">@pos.PositionName</option>
                                }
                            }
                        </select>
                        <div class="custom-dropdown" id="roleDropdown" aria-haspopup="listbox" aria-expanded="false">
                            <div class="dropdown-header">
                                @{
                                    var selPos = positions.FirstOrDefault(p => p.Id == Model?.PositionId);
                                }
                                <span class="selected-value @(selPos != null ? "" : "text-muted")" id="roleSelectedText">@(selPos != null ? selPos.PositionName : "اختار الدور")</span>
                                <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="18 15 12 9 6 15"></polyline>
                                </svg>
                            </div>
                            <div class="dropdown-list" role="listbox">
                                @if (positions.Any())
                                {
                                    @foreach (var pos in positions)
                                    {
                                        <div class="dropdown-item @(Model?.PositionId == pos.Id ? "selected" : "")" role="option" data-value="@pos.Id" data-text="@pos.PositionName">@pos.PositionName</div>
                                    }
                                }
                                else
                                {
                                    <div class="dropdown-item disabled text-muted">لا توجد أدوار مضافة</div>
                                }
                            </div>
                        </div>
                        <div class="invalid-feedback text-center mt-2 dropdown-error-msg">يرجى اختيار دور الموظف.</div>
                    </div>
                </div>

                <!-- مجموعة الصلاحيات -->
                <div class="col-md-6 order-md-6">
                    <label class="form-label fw-bold" for="empGroupSelect">مجموعة الصلاحيات</label>
                    <div class="position-relative custom-dropdown-container">
                        <select class="visually-hidden-select" id="empGroupSelect" name="GroupId" required>
                            @if (Model == null || Model.GroupId == 0)
                            {
                                <option value="" disabled selected>اختار المجموعة</option>
                            }
                            else
                            {
                                <option value="" disabled>اختار المجموعة</option>
                            }
                            @foreach (var grp in groups)
                            {
                                if (Model?.GroupId == grp.Id)
                                {
                                    <option value="@grp.Id" selected>@grp.Name</option>
                                }
                                else
                                {
                                    <option value="@grp.Id">@grp.Name</option>
                                }
                            }
                        </select>
                        <div class="custom-dropdown" id="groupDropdown" aria-haspopup="listbox" aria-expanded="false">
                            <div class="dropdown-header">
                                @{
                                    var selGrp = groups.FirstOrDefault(g => g.Id == Model?.GroupId);
                                }
                                <span class="selected-value @(selGrp != null ? "" : "text-muted")" id="groupSelectedText">@(selGrp != null ? selGrp.Name : "اختار المجموعة")</span>
                                <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="18 15 12 9 6 15"></polyline>
                                </svg>
                            </div>
                            <div class="dropdown-list" role="listbox">
                                @if (groups.Any())
                                {
                                    @foreach (var grp in groups)
                                    {
                                        <div class="dropdown-item @(Model?.GroupId == grp.Id ? "selected" : "")" role="option" data-value="@grp.Id" data-text="@grp.Name">@grp.Name</div>
                                    }
                                }
                                else
                                {
                                    <div class="dropdown-item disabled text-muted">لا توجد مجموعات مضافة</div>
                                }
                            </div>
                        </div>
                        <div class="invalid-feedback text-center mt-2 dropdown-error-msg">يرجى اختيار مجموعة الصلاحيات.</div>
                    </div>
                </div>

                <!-- كود الموظف -->
                <div class="col-md-6 order-md-7">
                    <label for="empUserCode" class="form-label fw-bold">كود الموظف</label>
                    <div class="position-relative">
                        <input type="text" class="form-control custom-input text-end" id="empUserCode" name="UserCode" value="@Model?.UserCode" placeholder="ادخل كود الموظف" required autocomplete="off">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال كود الموظف.</div>
                    </div>
                </div>

                <!-- كود الفرع -->
                <div class="col-md-6 order-md-8">
                    <label for="empBranchCode" class="form-label fw-bold">كود الفرع</label>
                    <div class="position-relative">
                        <input type="text" class="form-control custom-input text-end" id="empBranchCode" name="BranchCode" value="@Model?.BranchCode" placeholder="ادخل كود الفرع (مثال: BR-01)" required autocomplete="off">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال كود الفرع.</div>
                    </div>
                </div>

            </div>

            <button type="submit" class="w-100 submit-btn mt-4">تحديث بيانات الموظف</button>
        </form>
    </section>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('editEmployeeForm');
            const phoneInput = document.getElementById('empPhone');
            const nationalIdInput = document.getElementById('empNationalId');

            // 1. تقييد الإدخال في رقم الهاتف للأرقام فقط وبحد أقصى 11 رقماً
            if (phoneInput) {
                phoneInput.addEventListener('input', (e) => {
                    phoneInput.value = phoneInput.value.replace(/[^0-9]/g, '').slice(0, 11);
                });
            }

            // 2. تقييد الإدخال في الرقم القومي للأرقام فقط وبحد أقصى 14 رقماً
            if (nationalIdInput) {
                nationalIdInput.addEventListener('input', (e) => {
                    nationalIdInput.value = nationalIdInput.value.replace(/[^0-9]/g, '').slice(0, 14);
                });
            }

            // 3. إعداد القوائم المنسدلة المخصصة
            function setupDropdown(dropdownId, selectId, selectedTextId) {
                const customDropdown = document.getElementById(dropdownId);
                const hiddenSelect = document.getElementById(selectId);
                if (!customDropdown || !hiddenSelect) return;

                const header = customDropdown.querySelector('.dropdown-header');
                const selectedText = selectedTextId ? document.getElementById(selectedTextId) : customDropdown.querySelector('.selected-value');
                const items = customDropdown.querySelectorAll('.dropdown-item');

                header.addEventListener('click', (e) => {
                    e.stopPropagation();
                    // Close other dropdowns
                    document.querySelectorAll('.custom-dropdown').forEach(d => {
                        if (d !== customDropdown) d.classList.remove('open');
                    });
                    customDropdown.classList.toggle('open');
                });

                items.forEach(item => {
                    item.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const val = item.getAttribute('data-value');
                        const text = item.getAttribute('data-text');
                        hiddenSelect.value = val;
                        if (selectedText) {
                            selectedText.textContent = text;
                            selectedText.classList.remove('text-muted');
                        }
                        items.forEach(i => i.classList.remove('selected'));
                        item.classList.add('selected');
                        customDropdown.classList.remove('open');
                        customDropdown.classList.remove('is-invalid-dropdown');
                    });
                });
            }

            setupDropdown('roleDropdown', 'empRoleSelect', 'roleSelectedText');
            setupDropdown('groupDropdown', 'empGroupSelect', 'groupSelectedText');

            document.addEventListener('click', () => {
                document.querySelectorAll('.custom-dropdown').forEach(d => d.classList.remove('open'));
            });

            // 4. التحقق عند إرسال النموذج
            if (form) {
                form.addEventListener('submit', (e) => {
                    let hasError = false;
                    const roleSelect = document.getElementById('empRoleSelect');
                    const roleDropdown = document.getElementById('roleDropdown');
                    const groupSelect = document.getElementById('empGroupSelect');
                    const groupDropdown = document.getElementById('groupDropdown');

                    if (roleSelect && !roleSelect.value) {
                        hasError = true;
                        if (roleDropdown) roleDropdown.classList.add('is-invalid-dropdown');
                    }
                    if (groupSelect && !groupSelect.value) {
                        hasError = true;
                        if (groupDropdown) groupDropdown.classList.add('is-invalid-dropdown');
                    }

                    // فحص الهاتف المصري (11 رقم يبدأ بـ 010 أو 011 أو 012 أو 015)
                    const egyptianPhoneRegex = /^01[0125][0-9]{8}$/;
                    if (phoneInput && !egyptianPhoneRegex.test(phoneInput.value.trim())) {
                        hasError = true;
                        phoneInput.setCustomValidity('invalid');
                    } else if (phoneInput) {
                        phoneInput.setCustomValidity('');
                    }

                    // فحص الرقم القومي (14 رقم بالضبط)
                    const nationalIdRegex = /^[0-9]{14}$/;
                    if (nationalIdInput && !nationalIdRegex.test(nationalIdInput.value.trim())) {
                        hasError = true;
                        nationalIdInput.setCustomValidity('invalid');
                    } else if (nationalIdInput) {
                        nationalIdInput.setCustomValidity('');
                    }

                    if (hasError || !form.checkValidity()) {
                        e.preventDefault();
                        form.classList.add('was-validated');
                    }
                });
            }
        });
    </script>
}