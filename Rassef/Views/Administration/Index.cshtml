@model IEnumerable<Rassef.ViewModels.Administration.Employee.EmployeeListVM>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيف — لوحة التحكم (كل الموظفين)</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true">
</head>
<body> 
     
    <div class="dashboard-page">

        <!-- ── 1. RIGHT SIDEBAR ── -->
        <partial name="_AdminSidebar" model='"Employees"' />

        <!-- ── 2. MAIN CONTENT AREA ── -->
        <main class="dashboard-main">

            <!-- Header Top Row -->
            <header class="dashboard-header">
                <button class="mobile-toggle" id="mobileToggle" aria-label="القائمة">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div class="header-right">
                    <h2 class="header-title">كل الموظفين</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>آخر تحديث منذ 10 ثواني</span>
                    </div>
                </div>

                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- Action & Controls Bar -->
            <div class="dashboard-actions-bar">
                <!-- Filter Dropdown -->
                <div class="dropdown-container">
                    <button class="dropdown-pill" id="filterDropdown">
                        <span id="sortBtnText">تصنيف عبر : الإسم</span>
                        <svg class="dropdown-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                    </button>
                    <ul class="dropdown-menu" id="sortMenu">
                        <li data-sort="name">الإسم</li>
                        <li data-sort="phone">رقم الهاتف</li>
                        <li data-sort="role">الدور</li>
                        <li data-sort="code">الكود</li>
                        <li data-sort="email">البريد الإلكتروني</li>
                        <li data-sort="nationalId">الرقم القومي</li>
                    </ul>
                </div>

                <!-- Search Bar -->
                <div class="dashboard-search-bar">
                    <input type="search" id="employeeSearch" placeholder="ادخل اسم الموظف" autocomplete="off">
                    <button class="dashboard-search-btn" aria-label="بحث">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" stroke="white" stroke-width="2.2" stroke-linecap="round" /></svg>
                    </button>
                </div>

                <!-- Export Button -->
                <button class="btn-action-export" id="exportBtn">
                    <span>تصدير</span>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                </button>

                <!-- Add Employee Button -->
                <a href="@Url.Action("Create", "Administration")" class="btn-action-add" id="addEmployeeBtn" style="text-decoration: none;">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    <span>إضافة موظف</span>
                </a>
            </div>

            <!-- Employees Table -->
            <div class="table-container">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th class="col-name">الإسم</th>
                            <th class="col-phone">رقم الهاتف</th>
                            <th class="col-email">البريد الألكتروني</th>  
                            <th class="col-role">الدور</th>
                            <th class="col-nid">الرقم القومي</th>
                            <th class="col-code">الكود</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>
                    <tbody id="employeeTableBody">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var emp in Model)
                            {
                                <tr class="table-row">
                                    <td class="col-name">@emp.Name</td>
                                    <td class="col-phone">@emp.Phone</td>
                                    <td class="col-email">@emp.Email</td>
                                    <td class="col-role">@emp.Role</td>
                                    <td class="col-nid">@emp.NationalId</td>
                                    <td class="col-code">@emp.UserCode</td>
                                    <td class="col-action">
                                        <a href="@Url.Action("Details", "Administration", new { id = emp.Id })" class="btn-table-details" style="text-decoration: none;">
                                            <span>تفاصيل</span>
                                            <span class="arrow">&larr;</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="empty-state">لا يوجد أي موظفين مسجلين حتى الآن</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination (Dynamic) -->
            <div class="pagination-container" id="paginationContainer">
                <button class="page-item"><span class="arrow">&gt;</span></button>
                <button class="page-item">40</button>
                <span class="page-dots">...</span>
                <button class="page-item">4</button>
                <button class="page-item">3</button>
                <button class="page-item">2</button>
                <button class="page-item active">1</button>
                <button class="page-item"><span class="arrow">&lt;</span></button>
            </div>

        </main>
    </div>


    <script>
        window.initialEmployeesData = @Html.Raw(Json.Serialize(Model != null ? Model.Select(e => new {
            id = e.Id,
            name = e.Name,
            phone = e.Phone,
            email = e.Email,
            role = e.Role,
            nationalId = e.NationalId,
            code = e.UserCode
        }).ToList() : new List<object>()));

        window.mvcRoutes = {
            createEmployeeUrl: '@Url.Action("Create", "Administration")',
            detailsEmployeeUrl: '@Url.Action("Details", "Administration")'
        };
    </script>

    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</body>
</html>