@{
    Layout = null; // لم يتم افتراض Layout بناءً على طلبك للحفاظ على هيكل الـ HTML كاملاً
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيف — لوحة التحكم (كل الموظفين)</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/dashboard.css">
</head>
<body>

    <div class="dashboard-page">

        <!-- ── 1. RIGHT SIDEBAR ── -->
        <aside class="dashboard-sidebar">
            <div class="sidebar-top">
                <h1 class="sidebar-title">لوحة التحكم</h1>
                <ul class="sidebar-menu">
                    <li>
                        <a href="@Url.Action("AddRoleOrView", "Authentication")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                            <span>الرجوع</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Administration")" class="sidebar-item active">
                            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="2.5" /><path d="M15 8h4M15 12h4M6 17h12" /></svg>
                            <span>كل الموظفين</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("TrucksIndex", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" /><polygon points="16 8 20 8 23 11 23 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                            <span>السيارات المسجلة</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("DriversIndex", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                            <span>السائقين المسجلين</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Suppliers", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
                            <span>الموردين</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("SupplierRequests", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" /></svg>
                            <span>طلبات التوريد</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("TransferRequests", "Administration")" class="sidebar-item" id="transferRequestsBtn">
                            <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" /></svg>
                            <span>طلبات التحويل</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- User Profile Widget (Bottom) -->
            <div class="sidebar-user">
                <div class="user-info-group">
                    <div class="user-avatar-box">
                        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    </div>
                    <div class="user-details">
                        <span class="user-name">محمد عبد صادق</span>
                        <span class="user-role">مدير الأحمال</span>
                    </div>
                </div>
                <div class="user-chevron">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
                </div>
            </div>
        </aside>

        <!-- ── 2. MAIN CONTENT AREA ── -->
        <main class="dashboard-main">

            <!-- Header Top Row -->
            <header class="dashboard-header">
                <button class="mobile-toggle" id="mobileToggle" aria-label="القائمة">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div class="header-right">
                    <h2 class="header-title">كل الموظفين</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>آخر تحديث منذ 10 ثواني</span>
                    </div>
                </div>

                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- Action & Controls Bar -->
            <div class="dashboard-actions-bar">
                <!-- Filter Dropdown -->
                <div class="dropdown-container">
                    <button class="dropdown-pill" id="filterDropdown">
                        <span id="sortBtnText">تصنيف عبر : الإسم</span>
                        <svg class="dropdown-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                    </button>
                    <ul class="dropdown-menu" id="sortMenu">
                        <li data-sort="name">الإسم</li>
                        <li data-sort="phone">رقم الهاتف</li>
                        <li data-sort="role">الدور</li>
                        <li data-sort="code">الكود</li>
                        <li data-sort="email">البريد الإلكتروني</li>
                        <li data-sort="nationalId">الرقم القومي</li>
                    </ul>
                </div>

                <!-- Search Bar -->
                <div class="dashboard-search-bar">
                    <button class="dashboard-search-btn" aria-label="بحث">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" stroke="white" stroke-width="2.2" stroke-linecap="round" /></svg>
                    </button>
                    <input type="search" id="employeeSearch" placeholder="ادخل اسم الموظف" autocomplete="off">
                </div>

                <!-- Export Button -->
                <button class="btn-action-orange" id="exportBtn">
                    <span>تصدير</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="12" y1="18" x2="12" y2="12" /><polyline points="9 15 12 18 15 15" /></svg>
                </button>

                <!-- Add Employee Button -->
                <button class="btn-action-orange" id="addEmployeeBtn">
                    <span>إضافة موظف</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                </button>
            </div>

            <!-- Employees Table -->
            <div class="table-container">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>الإسم</th>
                            <th>رقم الهاتف</th>
                            <th>البريد الإلكتروني</th>  
                            <th>الدور</th>
                            <th>الرقم القومي</th>
                            <th>الكود</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="employeeTableBody">
                        <!-- Dynamic / Sample Rows -->
                    </tbody>
                </table>
            </div>

            <!-- Pagination (Dynamic) -->
            <div class="pagination-container" id="paginationContainer">
                <!-- JS will populate this -->
            </div>

        </main>
    </div>

    <!-- تمرير مسارات MVC إلى الجافاسكريبت -->
    <script>
        window.mvcRoutes = {
            createEmployeeUrl: '@Url.Action("Create", "Administration")',
            detailsEmployeeUrl: '@Url.Action("Details", "Administration")'
        };
    </script>

    <script src="~/js/api.js"></script>
    <script src="~/js/app.js"></script>
    <script src="~/js/dashboard.js"></script>
</body>
</html>