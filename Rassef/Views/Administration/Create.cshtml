@model Rassef.ViewModels.Administration.Employee.EmployeeCreateVM
@{
    ViewData["Title"] = "إضافة موظف";
    Layout = "_SupOrTra";
    var positions = ViewBag.Positions as IEnumerable<Rassef.Models.Entities.Position> ?? new List<Rassef.Models.Entities.Position>();
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="~/css/addEmployee.css" asp-append-version="true">
}

<main class="page-container">
    <!-- Header -->
    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">إضافة موظف</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="logo-raseefy" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
        </div>
    </header> 

    <!-- Navigation Action -->
    <div class="nav-actions-container" style="justify-content: flex-end;">
        <a href="@Url.Action("Index", "Administration")" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <!-- Form Card -->
    <section class="form-card mt-3">
        <form method="post" action="@Url.Action("Create", "Administration")" id="addEmployeeForm" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger text-end mb-4">
                    <ul class="mb-0" style="list-style-type: none; padding-right: 0;">
                        @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@modelError.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="row mb-4 gy-4">

                <!-- اسم الموظف -->
                <div class="col-md-6 order-md-1">
                    <label for="empName" class="form-label fw-bold">اسم الموظف</label>
                    <div class="position-relative">
                        <input type="text" class="form-control custom-input" id="empName" name="Name" value="@Model?.Name" placeholder="ادخل اسم الموظف رباعي" required autocomplete="off">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال اسم الموظف.</div>
                    </div>
                </div>

                <!-- رقم الهاتف -->
                <div class="col-md-6 order-md-2">
                    <label for="empPhone" class="form-label fw-bold">رقم الهاتف</label>
                    <div class="position-relative">
                        <input type="tel" class="form-control custom-input" id="empPhone" name="Phone" value="@Model?.Phone" placeholder="ادخل رقم هاتف الموظف" pattern="^01[0125][0-9]{8}$" required autocomplete="tel" dir="rtl">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال رقم هاتف مصري صحيح (11 رقم).</div>
                    </div>
                </div>

                <!-- البريد الإلكتروني -->
                <div class="col-md-6 order-md-3">
                    <label for="empEmail" class="form-label fw-bold">البريد الإلكتروني</label>
                    <div class="position-relative">
                        <input type="email" class="form-control custom-input text-end" id="empEmail" name="Email" value="@Model?.Email" placeholder="ادخل البريد الإلكتروني للموظف" required autocomplete="email">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال بريد إلكتروني صحيح.</div>
                    </div>
                </div>

                <!-- الدور الوظيفي (من قاعدة البيانات) -->
                <div class="col-md-6 order-md-4">
                    <label class="form-label fw-bold" for="empRoleSelect">الدور الوظيفي</label>
                    <div class="position-relative custom-dropdown-container">
                        <select class="visually-hidden-select" id="empRoleSelect" name="PositionId" required>
                            @if (Model == null || Model.PositionId == 0)
                            {
                                <option value="" disabled selected>اختار الدور</option>
                            }
                            else
                            {
                                <option value="" disabled>اختار الدور</option>
                            }
                            @foreach (var pos in positions)
                            {
                                if (Model?.PositionId == pos.Id)
                                {
                                    <option value="@pos.Id" selected>@pos.PositionName</option>
                                }
                                else
                                {
                                    <option value="@pos.Id">@pos.PositionName</option>
                                }
                            }
                        </select>
                        <div class="custom-dropdown" id="roleDropdown" aria-haspopup="listbox" aria-expanded="false">
                            <div class="dropdown-header">
                                @{
                                    var selPos = positions.FirstOrDefault(p => p.Id == Model?.PositionId);
                                }
                                <span class="selected-value @(selPos != null ? "" : "text-muted")">@(selPos != null ? selPos.PositionName : "اختار الدور")</span>
                                <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="18 15 12 9 6 15"></polyline>
                                </svg>
                            </div>
                            <div class="dropdown-list" role="listbox">
                                @if (positions.Any())
                                {
                                    @foreach (var pos in positions)
                                    {
                                        <div class="dropdown-item @(Model?.PositionId == pos.Id ? "selected" : "")" role="option" data-value="@pos.Id" data-text="@pos.PositionName">@pos.PositionName</div>
                                    }
                                }
                                else
                                {
                                    <div class="dropdown-item disabled text-muted">لا توجد أدوار مضافة</div>
                                }
                            </div>
                        </div>
                        <div class="invalid-feedback text-center mt-2 dropdown-error-msg">يرجى اختيار دور الموظف.</div>
                    </div>
                </div>

                <!-- الرقم القومي -->
                <div class="col-md-6 order-md-5">
                    <label for="empNationalId" class="form-label fw-bold">الرقم القومي</label>
                    <div class="position-relative">
                        <input type="text" class="form-control custom-input" id="empNationalId" name="NationalId" value="@Model?.NationalId" placeholder="ادخل الرقم القومي (14 رقم)" pattern="^[0-9]{14}$" required autocomplete="off">
                        <div class="invalid-feedback text-center mt-2">الرقم القومي يجب أن يتكون من 14 رقمًا.</div>
                    </div>
                </div>

                <!-- كود الموظف -->
                <div class="col-md-6 order-md-6">
                    <label for="empUserCode" class="form-label fw-bold">كود الموظف</label>
                    <div class="position-relative">
                        <input type="text" class="form-control custom-input text-end" id="empUserCode" name="UserCode" value="@Model?.UserCode" placeholder="ادخل كود الموظف (مثال: EMP-101)" required autocomplete="off">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال كود الموظف.</div>
                    </div>
                </div>

            </div>

            <button type="submit" class="w-100 submit-btn mt-4">إضافة موظف جديد</button>
        </form>
    </section>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('addEmployeeForm');
            const customDropdown = document.getElementById('roleDropdown');
            const hiddenSelect = document.getElementById('empRoleSelect');
            const header = customDropdown ? customDropdown.querySelector('.dropdown-header') : null;
            const selectedText = customDropdown ? customDropdown.querySelector('.selected-value') : null;
            const items = customDropdown ? customDropdown.querySelectorAll('.dropdown-item') : [];

            if (header && customDropdown) {
                header.addEventListener('click', (e) => {
                    e.stopPropagation();
                    customDropdown.classList.toggle('open');
                });

                items.forEach(item => {
                    item.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const val = item.getAttribute('data-value');
                        const text = item.getAttribute('data-text');
                        if (hiddenSelect) hiddenSelect.value = val;
                        if (selectedText) {
                            selectedText.textContent = text;
                            selectedText.classList.remove('text-muted');
                        }
                        items.forEach(i => i.classList.remove('selected'));
                        item.classList.add('selected');
                        customDropdown.classList.remove('open');
                        customDropdown.classList.remove('is-invalid-dropdown');
                    });
                });

                document.addEventListener('click', () => {
                    customDropdown.classList.remove('open');
                });
            }

            if (form) {
                form.addEventListener('submit', (e) => {
                    if (hiddenSelect && !hiddenSelect.value) {
                        e.preventDefault();
                        if (customDropdown) customDropdown.classList.add('is-invalid-dropdown');
                        form.classList.add('was-validated');
                    }
                });
            }
        });
    </script>
}