@model Rassef.ViewModels.Administration.Employee.ChangePasswordVM
@{
    ViewData["Title"] = "تغيير كلمة المرور";
    Layout = "_SupOrTra";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="~/css/addEmployee.css" asp-append-version="true">
}

<main class="page-container">
    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">تغيير كلمة المرور</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="logo-raseefy" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
        </div>
    </header>

    <div class="nav-actions-container" style="justify-content: flex-end;">
        <a href="@Url.Action("Details", "Administration", new { id = Model.Id })" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="form-card mt-3">
        <p class="fw-bold mb-4" style="font-size: 16px; color: #333;">
            تغيير كلمة مرور: <span style="color: var(--primary-color, #E67E22);">@Model.EmployeeName</span>
        </p>

        <form method="post" action="@Url.Action("ChangePassword", "Administration")" id="changePasswordForm" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="EmployeeName" />

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger text-end mb-4">
                    <ul class="mb-0" style="list-style-type: none; padding-right: 0;">
                        @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@modelError.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="row mb-4 gy-4">

                <div class="col-md-6">
                    <label for="newPassword" class="form-label fw-bold">كلمة المرور الجديدة</label>
                    <div class="position-relative">
                        <input type="password" class="form-control custom-input" id="newPassword" name="NewPassword" placeholder="ادخل كلمة المرور الجديدة" required autocomplete="new-password">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال كلمة المرور الجديدة.</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label for="confirmPassword" class="form-label fw-bold">تأكيد كلمة المرور</label>
                    <div class="position-relative">
                        <input type="password" class="form-control custom-input" id="confirmPassword" name="ConfirmPassword" placeholder="أعد إدخال كلمة المرور" required autocomplete="new-password">
                        <div class="invalid-feedback text-center mt-2">كلمتا المرور غير متطابقتين.</div>
                    </div>
                </div>

            </div>

            <button type="submit" class="w-100 submit-btn mt-4">حفظ كلمة المرور الجديدة</button>
        </form>
    </section>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('changePasswordForm');
            const newPassword = document.getElementById('newPassword');
            const confirmPassword = document.getElementById('confirmPassword');

            if (form) {
                form.addEventListener('submit', (e) => {
                    if (newPassword.value !== confirmPassword.value) {
                        confirmPassword.setCustomValidity('mismatch');
                    } else {
                        confirmPassword.setCustomValidity('');
                    }

                    if (!form.checkValidity()) {
                        e.preventDefault();
                        form.classList.add('was-validated');
                    }
                });

                confirmPassword.addEventListener('input', () => {
                    confirmPassword.setCustomValidity('');
                });
            }
        });
    </script>
}