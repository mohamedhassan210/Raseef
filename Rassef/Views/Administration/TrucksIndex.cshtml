@model IEnumerable<Rassef.ViewModels.Administration.TruckListVM>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيف — لوحة التحكم (السيارات المسجلة)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css">
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <partial name="_AdminSidebar" model='"Trucks"' />

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <header class="dashboard-header">
                <div class="header-right">
                    <h2 class="header-title">السيارات المسجلة</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>إجمالي السيارات: @(Model?.Count() ?? 0)</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <div class="table-container">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>رقم اللوحة</th>
                            <th>نوع التبريد</th>
                            <th>الشركة / النوع</th>
                            <th>السعة التخزينية</th>
                            <th>الموظف المضيف</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="table-row">
                                    <td>@item.PlateNumber</td>
                                    <td>@item.IsRefrigerated</td>
                                    <td>@item.Company</td>
                                    <td>@item.StorageCapacity طن</td>
                                    <td>@item.HostEmployeeName</td>
                                    <td>
                                        <a href="@Url.Action("TruckDetails", "Administration", new { id = item.Id })" class="btn-table-details">
                                            <span>تفاصيل</span>
                                            <span>&larr;</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="empty-state">لا يوجد أي شاحنات مسجلة حتى الآن</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</body>
</html>
