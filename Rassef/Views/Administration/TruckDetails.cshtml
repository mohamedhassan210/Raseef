@model Rassef.ViewModels.Administration.Truck.TruckDetailsVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيف — تفاصيل الشاحنة</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/detailsPages.css" asp-append-version="true">
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <partial name="_AdminSidebar" model='"Trucks"' />

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <!-- HEADER -->
            <header class="dashboard-header">
                <div class="header-right">
                    <h2 class="header-title">تفاصيل الشاحنة</h2>
                    <!-- CHANGED — removed the hardcoded "10 seconds ago" freshness
                         claim (same fix as TrucksIndex). -->
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                    </div>
                </div>
                <div class="header-left-group">
                    <div class="header-left-logos">
                        <img src="~/img/fathallah logo.svg" alt="فتح الله Fathalla" class="header-logo-fathallah">
                        <img src="~/img/logo.svg" alt="رصيفي Raseefy" class="header-logo-raseef">
                    </div>
                    <div class="back-row">
                        <a href="@Url.Action("TrucksIndex", "Administration")" class="btn-back-orange">
                            <span>رجوع</span>
                            <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>
                </div>
            </header>

            <!-- SECTION TITLE & VISITS BAR -->
            <div class="section-header-bar">
                <div class="truck-visits-bar">
                    <a href="@Url.Action("SupplierRequests", "Administration")" class="btn-see-visits">
                        <span>رؤية</span>
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <span class="hero-visits-num">@Model.VisitsCount</span>
                    <span class="hero-visits-label">عدد الزيارات:</span>
                </div>
                <div class="section-title-tag">
                    معلومات الشاحنة
                </div>
            </div>

            <!-- TRUCK INFO GRID -->
            <div class="details-grid-truck">
                <!-- TOP RIGHT: رقم الشاحنة -->
                <div class="detail-card detail-card-interactive">
                    <div class="detail-card-icon">
                        <svg viewBox="0 0 24 24" class="svg-badge-icon">
                            <path d="M10 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            <rect x="17" y="7" width="6" height="2" rx="1"/>
                            <rect x="17" y="11" width="6" height="2" rx="1"/>
                            <rect x="17" y="15" width="4" height="2" rx="1"/>
                        </svg>
                    </div>
                    <div class="detail-card-body">
                        <span class="detail-card-label">رقم الشاحنة</span>
                        <span class="detail-card-value" style="direction: ltr; text-align: right;">@Model.PlateNumber</span>
                    </div>
                </div>

                <!-- TOP LEFT: النوع -->
                <div class="detail-card detail-card-interactive">
                    <div class="detail-card-icon">
                        <svg viewBox="0 0 24 24" class="svg-badge-icon">
                            <path d="M10 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            <rect x="17" y="7" width="6" height="2" rx="1"/>
                            <rect x="17" y="11" width="6" height="2" rx="1"/>
                            <rect x="17" y="15" width="4" height="2" rx="1"/>
                        </svg>
                    </div>
                    <div class="detail-card-body">
                        <span class="detail-card-label">النوع</span>
                        <span class="detail-card-value">@Model.IsRefrigerated</span>
                    </div>
                </div>

                <!-- BOTTOM RIGHT: نوع الشاحنة + سعة التخزين (STACKED) -->
                <div class="stacked-cards-container">
                    <!-- نوع الشاحنة -->
                    <div class="detail-card detail-card-compact detail-card-interactive">
                        <div class="detail-card-icon">
                            <svg viewBox="0 0 24 24" class="svg-badge-icon">
                                <path d="M10 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                <rect x="17" y="7" width="6" height="2" rx="1"/>
                                <rect x="17" y="11" width="6" height="2" rx="1"/>
                                <rect x="17" y="15" width="4" height="2" rx="1"/>
                            </svg>
                        </div>
                        <div class="detail-card-body">
                            <span class="detail-card-label">نوع الشاحنة</span>
                            <span class="detail-card-value">@Model.TruckTypeName</span>
                        </div>
                    </div>

                    <!-- سعة التخزين -->
                    <div class="detail-card detail-card-compact detail-card-interactive">
                        <div class="detail-card-icon">
                            <svg viewBox="0 0 24 24" class="svg-badge-icon">
                                <path d="M10 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                <rect x="17" y="7" width="6" height="2" rx="1"/>
                                <rect x="17" y="11" width="6" height="2" rx="1"/>
                                <rect x="17" y="15" width="4" height="2" rx="1"/>
                            </svg>
                        </div>
                        <div class="detail-card-body">
                            <span class="detail-card-label">سعة التخزين</span>
                            <span class="detail-card-value">@($"{Model.StorageCapacity} kg")</span>
                        </div>
                    </div>
                </div>

                <!-- BOTTOM LEFT: الموظف المضيف -->
                <div class="detail-card detail-card-interactive">
                    <div class="detail-card-icon">
                        <svg viewBox="0 0 24 24" class="svg-badge-icon">
                            <path d="M10 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            <rect x="17" y="7" width="6" height="2" rx="1"/>
                            <rect x="17" y="11" width="6" height="2" rx="1"/>
                            <rect x="17" y="15" width="4" height="2" rx="1"/>
                        </svg>
                    </div>
                    <div class="detail-card-body">
                        <span class="detail-card-label">الموظف المضيف</span>
                        <span class="detail-card-value">@Model.HostEmployeeName</span>
                    </div>
                </div>
            </div>

            <!-- ACTIONS FOOTER -->
            <div class="details-actions-footer">
                <form method="post" action="@Url.Action("TruckDeleteConfirmed", "Administration", new { id = Model.Id })"
                      onsubmit="return confirm('هل أنت متأكد من حذف بيانات هذه الشاحنة؟');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-action-delete">
                        <i class="fas fa-trash-alt"></i>
                        <span>حذف البيانات</span>
                    </button>
                </form>
                <a href="@Url.Action("TruckEdit", "Administration", new { id = Model.Id })" class="btn-action-edit">
                    <i class="fas fa-edit"></i>
                    <span>تعديل البيانات</span>
                </a>
            </div>
        </main>
    </div>
</body>
</html>
