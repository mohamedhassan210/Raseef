@model Rassef.ViewModels.Administration.Truck.TruckDetailsVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيف — تفاصيل الشاحنة</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/detailsPages.css" asp-append-version="true">
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <partial name="_AdminSidebar" model='"Trucks"' />

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <!-- HEADER -->
            <header class="dashboard-header">
                <div class="header-right">
                    <h2 class="header-title">تفاصيل الشاحنة</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>آخر تحديث منذ 10 ثواني</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- BACK BUTTON -->
            <div class="back-row">
                <a href="@Url.Action("TrucksIndex", "Administration")" class="btn-back-orange">
                    <span>رجوع</span>
                    <i class="fas fa-arrow-left"></i>
                </a>
            </div>

            <!-- SECTION TITLE & VISITS BAR -->
            <div class="section-header-bar">
                <div class="truck-visits-bar">
                    <a href="@Url.Action("SupplierRequests", "Administration")" class="btn-see-visits">
                        <span>رؤية</span>
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <span class="hero-visits-num">@(Model.VisitsCount > 0 ? Model.VisitsCount : 30)</span>
                    <span class="hero-visits-label">عدد الزيارات:</span>
                </div>
                <div class="section-title-tag">
                    معلومات الشاحنة
                </div>
            </div>

            <!-- TRUCK INFO GRID -->
            <div class="details-grid-truck">
                <!-- TOP RIGHT: رقم الشاحنة -->
                <div class="detail-card">
                    <div class="detail-card-icon">
                        <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>
                    </div>
                    <div class="detail-card-body">
                        <span class="detail-card-label">رقم الشاحنة</span>
                        <span class="detail-card-value" style="direction: ltr; text-align: right;">@Model.PlateNumber</span>
                    </div>
                </div>

                <!-- TOP LEFT: النوع -->
                <div class="detail-card">
                    <div class="detail-card-icon">
                        <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>
                    </div>
                    <div class="detail-card-body">
                        <span class="detail-card-label">النوع</span>
                        <span class="detail-card-value">@Model.IsRefrigerated</span>
                    </div>
                </div>

                <!-- BOTTOM RIGHT: الشركة + سعة التخزين (STACKED) -->
                <div class="stacked-cards-container">
                    <!-- الشركة -->
                    <div class="detail-card detail-card-compact">
                        <div class="detail-card-icon" style="width: 44px; height: 44px;">
                            <svg viewBox="0 0 24 24" style="width: 22px; height: 22px;"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>
                        </div>
                        <div class="detail-card-body">
                            <span class="detail-card-label" style="font-size: 13px;">الشركة</span>
                            <span class="detail-card-value" style="font-size: 15px;">@(string.IsNullOrWhiteSpace(Model.Company) || Model.Company == "غير محدد" ? "فتح الله" : Model.Company)</span>
                        </div>
                    </div>

                    <!-- سعة التخزين -->
                    <div class="detail-card detail-card-compact">
                        <div class="detail-card-icon" style="width: 44px; height: 44px;">
                            <svg viewBox="0 0 24 24" style="width: 22px; height: 22px;"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>
                        </div>
                        <div class="detail-card-body">
                            <span class="detail-card-label" style="font-size: 13px;">سعة التخزين</span>
                            <span class="detail-card-value" style="font-size: 15px;">@(Model.StorageCapacity > 0 ? $"{Model.StorageCapacity} kg" : "500 kg")</span>
                        </div>
                    </div>
                </div>

                <!-- BOTTOM LEFT: الموظف المضيف -->
                <div class="detail-card">
                    <div class="detail-card-icon">
                        <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>
                    </div>
                    <div class="detail-card-body">
                        <span class="detail-card-label">الموظف المضيف</span>
                        <span class="detail-card-value">@(string.IsNullOrWhiteSpace(Model.HostEmployeeName) || Model.HostEmployeeName == "غير محدد" ? "محمد السيد الشناوي" : Model.HostEmployeeName)</span>
                    </div>
                </div>
            </div>

            <!-- ACTIONS FOOTER -->
            <div class="details-actions-footer">
                <a href="@Url.Action("TruckEdit", "Administration", new { id = Model.Id })" class="btn-action-edit">
                    <i class="fas fa-edit"></i>
                    <span>تعديل البيانات</span>
                </a>
                <a href="@Url.Action("TruckDelete", "Administration", new { id = Model.Id })" class="btn-action-delete">
                    <i class="fas fa-trash-alt"></i>
                    <span>حذف البيانات</span>
                </a>
            </div>
        </main>
    </div>
</body>
</html>
