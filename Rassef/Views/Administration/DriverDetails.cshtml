@model Rassef.ViewModels.Administration.DriverDetailsVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيف — تفاصيل السائق</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/detailsPages.css" asp-append-version="true">
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <partial name="_AdminSidebar" model='"Drivers"' />

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">

            <!-- HEADER -->
            <header class="dashboard-header">
                <div class="header-right">
                    <h2 class="header-title">تفاصيل السائق</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>آخر تحديث منذ 10 ثواني</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- BACK BUTTON -->
            <div class="back-row">
                <a href="@Url.Action("DriversIndex", "Administration")" class="btn-back-orange">
                    <span>رجوع</span>
                    <i class="fas fa-arrow-left"></i>
                </a>
            </div>

            <!-- HERO CARD -->
            <div class="details-hero-card">
                <div class="hero-right-content">
                    <h1 class="hero-entity-title">@Model.FullName</h1>
                    <div class="hero-meta-row">
                        <span class="hero-badge-tag">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                            </svg>
                            <span>@(string.IsNullOrWhiteSpace(Model.Company) ? "فتح الله" : Model.Company)</span>
                        </span>
                        <span class="hero-code-text">الرقم : @Model.Phone</span>
                    </div>
                    <div class="hero-visits-group">
                        <span class="hero-visits-label">عدد الزيارات:</span>
                        <span class="hero-visits-num">@(Model.VisitsCount > 0 ? Model.VisitsCount : 30)</span>
                        <a href="@Url.Action("SupplierRequests", "Administration")" class="btn-see-visits">
                            <span>رؤية</span>
                            <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>
                </div>

                <div class="hero-avatar-circle">
                    <span>@(!string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName.Trim()[0] : 'م')</span>
                </div>
            </div>

            <!-- SECTION TITLE -->
            <div class="section-header-bar">
                <div class="section-title-tag">
                    معلومات الموظف
                </div>
            </div>

            <!-- 2x2 INFO GRID -->
            <div class="details-grid-2x2">

                <!-- الإسم -->
                <div class="detail-card">
                    <div class="detail-card-icon">
                        <svg viewBox="0 0 24 24" class="svg-badge-icon">
                            <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                        </svg>
                    </div>
                    <div class="detail-card-body">
                        <span class="detail-card-label">الإسم</span>
                        <span class="detail-card-value">@Model.FullName</span>
                    </div>
                </div>

                <!-- الشركة -->
                <div class="detail-card">
                    <div class="detail-card-icon">
                        <svg viewBox="0 0 24 24" class="svg-badge-icon">
                            <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                        </svg>
                    </div>
                    <div class="detail-card-body">
                        <span class="detail-card-label">الشركة</span>
                        <span class="detail-card-value">@(string.IsNullOrWhiteSpace(Model.Company) ? "فتح الله" : Model.Company)</span>
                    </div>
                </div>

                <!-- رقم الهاتف -->
                <div class="detail-card">
                    <div class="detail-card-icon">
                        <svg viewBox="0 0 24 24" class="svg-badge-icon">
                            <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                        </svg>
                    </div>
                    <div class="detail-card-body">
                        <span class="detail-card-label">رقم الهاتف</span>
                        <span class="detail-card-value" style="direction: ltr;">@Model.Phone</span>
                    </div>
                </div>

                <!-- الرقم القومي -->
                <div class="detail-card">
                    <div class="detail-card-icon">
                        <svg viewBox="0 0 24 24" class="svg-badge-icon">
                            <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                        </svg>
                    </div>
                    <div class="detail-card-body">
                        <span class="detail-card-label">الرقم القومي</span>
                        <span class="detail-card-value" style="direction: ltr;">@Model.NationalId</span>
                    </div>
                </div>

            </div>

            <!-- ACTIONS FOOTER -->
            <div class="details-actions-footer">
                <form method="post" action="@Url.Action("DriverDelete", "Administration", new { id = Model.Id })"
                      onsubmit="return confirm('هل أنت متأكد من حذف بيانات هذا السائق؟');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-action-delete">
                        <i class="fas fa-trash-alt"></i>
                        <span>حذف البيانات</span>
                    </button>
                </form>
                <a href="@Url.Action("DriverEdit", "Administration", new { id = Model.Id })" class="btn-action-edit">
                    <i class="fas fa-edit"></i>
                    <span>تعديل البيانات</span>
                </a>
            </div>

        </main>
    </div>
</body>
</html>
