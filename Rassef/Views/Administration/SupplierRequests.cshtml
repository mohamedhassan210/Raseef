@model IEnumerable<SupplierRequestListVM>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيف — لوحة التحكم (طلبات التوريد)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css">
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <aside class="dashboard-sidebar">
            <div class="sidebar-top">
                <h1 class="sidebar-title">لوحة التحكم</h1>
                <ul class="sidebar-menu">
                    <li>
                        <a href="@Url.Action("AddRoleOrView", "Authentication")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                            <span>الرجوع</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="2.5" /><path d="M15 8h4M15 12h4M6 17h12" /></svg>
                            <span>كل الموظفين</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("TrucksIndex", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" /><polygon points="16 8 20 8 23 11 23 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                            <span>السيارات المسجلة</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("DriversIndex", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                            <span>السائقين المسجلين</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Suppliers", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
                            <span>الموردين</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("SupplierRequests", "Administration")" class="sidebar-item active">
                            <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" /></svg>
                            <span>طلبات التوريد</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("TransferRequests", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" /></svg>
                            <span>طلبات التحويل</span>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="sidebar-user">
                <div class="user-info-group">
                    <div class="user-avatar-box">
                        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    </div>
                    <div class="user-details">
                        <span class="user-name">@(User.Identity?.Name ?? "المسؤول")</span>
                        <span class="user-role">لوحة الإدارة</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <header class="dashboard-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                <div class="header-right">
                    <h2 class="header-title">طلبات التوريد وإدارة الأدوار</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>إجمالي الطلبات: @(Model?.Count() ?? 0)</span>
                    </div>
                </div>
                <div class="header-actions" style="display: flex; gap: 12px; align-items: center;">
                    <button id="btnCallNext" class="btn-call-next" style="background: linear-gradient(135deg, #e47925, #f59e0b); color: #fff; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 700; font-family: inherit; font-size: 0.95rem; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(228, 121, 37, 0.3); transition: all 0.2s ease;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 4 15 12 5 20 5 4"></polygon><line x1="19" y1="5" x2="19" y2="19"></line></svg>
                        <span>استدعاء الدور التالي (Next ⏭️)</span>
                    </button>
                    <div class="header-left-logos">
                        <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                        <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                    </div>
                </div>
            </header>

            <!-- Alert Toast Container -->
            <div id="toastAlert" style="display: none; margin-bottom: 20px; padding: 14px 20px; border-radius: 10px; font-weight: 600; font-size: 0.95rem; align-items: center; gap: 10px; animation: fadeIn 0.3s ease;">
            </div>

            <div class="table-container">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>رقم التذكرة</th>
                            <th>نوع الطلب</th>
                            <th>المورد</th>
                            <th>السائق</th>
                            <th>الشاحنة</th>
                            <th>القسم</th>
                            <th>الرصيف</th>
                            <th>حالة الدور</th>
                            <th>رقم التصريح</th>
                            <th style="text-align: center;">الإجراءات والتحكم</th>
                        </tr>
                    </thead>
                    <tbody id="requestsTableBody">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var status = (item.TicketStatusName ?? item.RequestStatusName ?? "إنتظار").Replace("إ", "ا").Trim();
                                bool isCompleted = status.Contains("مكتمل") || status.Contains("تم") || status.Contains("خروج") || status.Contains("منتهي");
                                bool isInProgress = status.Contains("جاري") || status.Contains("تنفيذ") || status.Contains("تشغيل");
                                bool isWaiting = !isCompleted && !isInProgress;

                                string badgeBg = isCompleted ? "#e8f5e9" : (isInProgress ? "#e3f2fd" : "#fff8e1");
                                string badgeColor = isCompleted ? "#2e7d32" : (isInProgress ? "#1565c0" : "#f57f17");
                                string badgeText = isCompleted ? "مكتمل" : (isInProgress ? "جاري التنفيذ" : "إنتظار");

                                <tr class="table-row" id="row-@item.TicketId" data-ticket-id="@item.TicketId">
                                    <td style="font-weight: 800; font-size: 1.05rem; color: #1e293b;">@item.TicketNumber</td>
                                    <td>
                                        <span class="badge-type-supply" style="background: #fff3e0; color: #e47925; padding: 3px 8px; border-radius: 6px; font-weight: 600; font-size: 0.85rem; border: 1px solid #ffe0b2;">توريد</span>
                                    </td>
                                    <td style="font-weight: 600;">@item.SupplierName</td>
                                    <td>@item.DriverName</td>
                                    <td style="font-family: monospace; font-weight: 700;">@item.TruckPlateNumber</td>
                                    <td>@item.DepartmentName</td>
                                    <td style="font-weight: 700; color: #e47925;">@item.DockName</td>
                                    <td class="status-cell">
                                        <span class="status-badge-custom" style="background: @badgeBg; color: @badgeColor; padding: 5px 12px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 5px;">
                                            <span style="width: 7px; height: 7px; border-radius: 50%; background: @badgeColor;"></span>
                                            <span class="status-text">@badgeText</span>
                                        </span>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(item.PermitNumber) ? "—" : item.PermitNumber)</td>
                                    <td style="text-align: center;" class="actions-cell">
                                        @if (item.TicketId.HasValue && item.TicketId > 0)
                                        {
                                            @if (isWaiting)
                                            {
                                                <button class="btn-action-start" onclick="updateStatus(@item.TicketId.Value, 'جاري')" style="background: #e3f2fd; color: #1565c0; border: 1px solid #bbdefb; padding: 6px 14px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; transition: all 0.2s;">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                                    <span>بدء التفريغ (جاري)</span>
                                                </button>
                                            }
                                            else if (isInProgress)
                                            {
                                                <button class="btn-action-complete" onclick="updateStatus(@item.TicketId.Value, 'مكتمل')" style="background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; padding: 6px 14px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; transition: all 0.2s;">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                    <span>إنهاء وتفريغ (مكتمل)</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <span style="color: #64748b; font-size: 0.85rem; font-weight: 600;">✔️ تم بنجاح</span>
                                            }
                                        }
                                        else
                                        {
                                            <span style="color: #94a3b8; font-size: 0.85rem;">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="empty-state" style="text-align: center; padding: 30px; color: #64748b;">لا يوجد أي طلبات توريد حالياً</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <!-- Live Action Script -->
    <script>
        const toastAlert = document.getElementById('toastAlert');
        const btnCallNext = document.getElementById('btnCallNext');

        function showToast(message, isSuccess = true) {
            toastAlert.style.display = 'flex';
            toastAlert.style.background = isSuccess ? '#ecfdf5' : '#fef2f2';
            toastAlert.style.color = isSuccess ? '#065f46' : '#991b1b';
            toastAlert.style.border = isSuccess ? '1px solid #a7f3d0' : '1px solid #fecaca';
            toastAlert.innerHTML = `<span>${isSuccess ? '✅' : '⚠️'} ${message}</span>`;
            setTimeout(() => {
                toastAlert.style.display = 'none';
            }, 4000);
        }

        async function updateStatus(ticketId, targetStatus) {
            try {
                const res = await fetch('/Administration/UpdateTicketStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketId: ticketId, status: targetStatus })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || `تم تغيير الحالة إلى ${targetStatus}`, true);
                    updateRowUI(ticketId, targetStatus);
                } else {
                    showToast(data.message || 'حدث خطأ أثناء تغيير الحالة.', false);
                }
            } catch (err) {
                console.error(err);
                showToast('حدث خطأ في الاتصال بالخادم.', false);
            }
        }

        function updateRowUI(ticketId, status) {
            const row = document.getElementById(`row-${ticketId}`);
            if (!row) {
                setTimeout(() => window.location.reload(), 500);
                return;
            }

            const statusCell = row.querySelector('.status-cell');
            const actionsCell = row.querySelector('.actions-cell');
            const norm = status.replace('إ', 'ا').trim();

            if (norm.includes('جاري') || norm.includes('تنفيذ')) {
                statusCell.innerHTML = `
                    <span class="status-badge-custom" style="background: #e3f2fd; color: #1565c0; padding: 5px 12px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 5px;">
                        <span style="width: 7px; height: 7px; border-radius: 50%; background: #1565c0;"></span>
                        <span class="status-text">جاري التنفيذ</span>
                    </span>
                `;
                actionsCell.innerHTML = `
                    <button class="btn-action-complete" onclick="updateStatus(${ticketId}, 'مكتمل')" style="background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; padding: 6px 14px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; transition: all 0.2s;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>إنهاء وتفريغ (مكتمل)</span>
                    </button>
                `;
            } else if (norm.includes('مكتمل') || norm.includes('تم')) {
                statusCell.innerHTML = `
                    <span class="status-badge-custom" style="background: #e8f5e9; color: #2e7d32; padding: 5px 12px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 5px;">
                        <span style="width: 7px; height: 7px; border-radius: 50%; background: #2e7d32;"></span>
                        <span class="status-text">مكتمل</span>
                    </span>
                `;
                actionsCell.innerHTML = `<span style="color: #64748b; font-size: 0.85rem; font-weight: 600;">✔️ تم بنجاح</span>`;
            }
        }

        if (btnCallNext) {
            btnCallNext.addEventListener('click', async () => {
                btnCallNext.disabled = true;
                btnCallNext.innerHTML = 'جاري استدعاء الدور القادم... ⏳';

                try {
                    const res = await fetch('/Administration/CallNextSupplierRequest', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast(`📢 تم استدعاء الدور ${data.ticketNumber} للشاحنة ${data.truckPlate} (السائق: ${data.driverName}) على الرصيف ${data.dockName}`, true);
                        if (data.ticketId) {
                            updateRowUI(data.ticketId, 'جاري');
                        } else {
                            setTimeout(() => window.location.reload(), 1000);
                        }
                    } else {
                        showToast(data.message || 'لا توجد أدوار في قائمة الانتظار.', false);
                    }
                } catch (err) {
                    console.error(err);
                    showToast('حدث خطأ في الاتصال بالخادم.', false);
                } finally {
                    btnCallNext.disabled = false;
                    btnCallNext.innerHTML = `
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 4 15 12 5 20 5 4"></polygon><line x1="19" y1="5" x2="19" y2="19"></line></svg>
                        <span>استدعاء الدور التالي (Next ⏭️)</span>
                    `;
                }
            });
        }
    </script>
</body>
</html>
