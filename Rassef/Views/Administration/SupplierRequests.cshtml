@model IEnumerable<SupplierRequestListVM>
@{
    Layout = null;
    var list = Model?.ToList() ?? new List<SupplierRequestListVM>();

    int waitingCount = list.Count(x =>
    {
        var s = (x.TicketStatusName ?? x.RequestStatusName ?? "إنتظار").Replace("إ", "ا").Trim();
        return !s.Contains("مكتمل") && !s.Contains("تم") && !s.Contains("خروج") && !s.Contains("منتهي") && !s.Contains("جاري") && !s.Contains("تنفيذ");
    });

    int inProgressCount = list.Count(x =>
    {
        var s = (x.TicketStatusName ?? x.RequestStatusName ?? "إنتظار").Replace("إ", "ا").Trim();
        return s.Contains("جاري") || s.Contains("تنفيذ") || s.Contains("تشغيل");
    });

    int completedCount = list.Count(x =>
    {
        var s = (x.TicketStatusName ?? x.RequestStatusName ?? "إنتظار").Replace("إ", "ا").Trim();
        return s.Contains("مكتمل") || s.Contains("تم") || s.Contains("خروج") || s.Contains("منتهي");
    });

    // Distinct department names for the new department filter, derived from the loaded list
    // (no extra repository call). "غير محدد" excluded — see follow-up question about this.
    var departmentOptions = list
        .Select(x => x.DepartmentName)
        .Where(d => !string.IsNullOrWhiteSpace(d) && d != "غير محدد")
        .Distinct()
        .OrderBy(d => d)
        .ToList();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيف — لوحة التحكم (طلبات التوريد)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/requestsQueue.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/detailsPages.css" asp-append-version="true">

    <!--
        Department-filter dropdown styling — copied verbatim from the custom-dropdown
        component already established in Department/Dock/Warehouse form views (same
        border color, radius, orange accent, IBM Plex font). Placed after the linked
        stylesheets above so it wins the cascade even if requestsQueue.css happens to
        define .custom-dropdown differently elsewhere on this page — scoped only to
        this view, not touching any shared file. Width narrowed to 220px for the
        toolbar context (forms use w-100); flagged as the one visual deviation.
    -->
    <style>
        .custom-dropdown {
            position: relative;
            width: 220px;
            font-family: 'IBM Plex Sans Arabic', sans-serif;
        }

            .custom-dropdown .dropdown-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 10px 16px;
                border: 1.5px solid #e8c8a8;
                border-radius: 12px;
                background: #fff;
                cursor: pointer;
                user-select: none;
                font-size: 15px;
                min-height: 44px;
            }

                .custom-dropdown .dropdown-header:hover {
                    border-color: var(--primary-color, #E67E22);
                }

            .custom-dropdown .dropdown-arrow {
                transition: transform 0.2s;
                width: 18px;
                height: 18px;
                flex-shrink: 0;
            }

            .custom-dropdown.open .dropdown-arrow {
                transform: rotate(180deg);
            }

            .custom-dropdown .dropdown-list {
                display: none;
                position: absolute;
                top: calc(100% + 4px);
                right: 0;
                left: 0;
                background: #fff;
                border: 1.5px solid #e8c8a8;
                border-radius: 12px;
                z-index: 200;
                max-height: 220px;
                overflow-y: auto;
                box-shadow: 0 4px 16px rgba(0,0,0,0.10);
            }

            .custom-dropdown.open .dropdown-list {
                display: block;
            }

            .custom-dropdown .dropdown-list .dropdown-item {
                padding: 10px 16px;
                cursor: pointer;
                font-size: 15px;
                border-bottom: 1px solid #faede2;
                transition: background 0.15s;
            }

                .custom-dropdown .dropdown-list .dropdown-item:last-child {
                    border-bottom: none;
                }

                .custom-dropdown .dropdown-list .dropdown-item:hover {
                    background: #fdf1e7;
                }

                .custom-dropdown .dropdown-list .dropdown-item.selected {
                    background: #fde8cb;
                    font-weight: 700;
                }

        .placeholder-color {
            color: #aaa;
        }

        .selected-value {
            color: #333;
        }

        .custom-range-wrapper {
            display: none;
            align-items: flex-end;
            gap: 10px;
        }

        .custom-range-field {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .custom-range-field label {
                font-size: 13px;
                font-weight: 700;
                color: #555;
            }

        .custom-range-input {
            border: 1.5px solid #e8c8a8;
            border-radius: 12px;
            padding: 8px 12px;
            font-family: 'IBM Plex Sans Arabic', sans-serif;
            font-size: 14px;
            min-height: 40px;
            background: #fff;
        }

            .custom-range-input:focus {
                outline: none;
                border-color: var(--primary-color, #E67E22);
            }


        .btn-filter-pill-all {
            border: 1.5px dashed #999;
            background: #f5f5f5;
            color: #555;
        }

            .btn-filter-pill-all.active {
                background: #333;
                color: #fff;
                border-color: #333;
            }


    </style>
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <partial name="_AdminSidebar" model='"SupplierRequests"' />

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <!-- HEADER -->
            <header class="dashboard-header">
                <div class="header-right">
                    <h2 class="header-title">طلبات التوريد</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>آخر تحديث منذ 10 ثواني</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- TOOLBAR & FILTERS -->
            <div class="queue-toolbar">
                <div class="toolbar-right-group">
                    <!-- Date Filter Pills -->
                    <div class="date-filter-group" id="dateFilterGroup">
                        <button type="button" class="btn-filter-pill" data-filter="today">اليوم</button>
                        <button type="button" class="btn-filter-pill" data-filter="week">اسبوع</button>
                        <button type="button" class="btn-filter-pill" data-filter="month">شهر</button>
                        <button type="button" class="btn-filter-pill active" data-filter="custom">تحرير</button>
                        <button type="button" class="btn-filter-pill btn-filter-pill-all" data-filter="all">الكل</button>
                    </div>

                    <div class="custom-range-wrapper" id="customRangeWrapper">
                        <div class="custom-range-field">
                            <label for="customDateFrom">من</label>
                            <input type="date" id="customDateFrom" class="custom-range-input">
                        </div>
                        <div class="custom-range-field">
                            <label for="customDateTo">الي</label>
                            <input type="date" id="customDateTo" class="custom-range-input">
                        </div>
                    </div>

                    <!-- Department Filter (new) -->
                    <div class="custom-dropdown" id="departmentFilterDropdown">
                        <div class="dropdown-header" id="departmentFilterHeader">
                            <span class="selected-value" id="departmentFilterSelectedText">كل الأقسام</span>
                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="18 15 12 9 6 15"></polyline>
                            </svg>
                        </div>
                        <div class="dropdown-list" id="departmentFilterList">
                            <div class="dropdown-item selected" data-value="">كل الأقسام</div>
                            @foreach (var dept in departmentOptions)
                            {
                                <div class="dropdown-item" data-value="@dept">@dept</div>
                            }
                        </div>
                    </div>

                    <!-- Search Box -->
                    <div class="search-box-wrapper">
                        <input type="text" id="searchInput" class="search-input" placeholder="ادخل رقم الدور أو العربية أو اسم الموظف" />
                        <span class="search-icon-btn"><i class="fas fa-search"></i></span>
                    </div>
                </div>

                <!-- Export Button -->
                <button type="button" class="btn-export" id="btnExport">
                    <i class="fas fa-file-export"></i>
                    <span>تصدير</span>
                </button>
            </div>

            <!-- SUMMARY STATS (3 CARDS) -->
            <div class="stats-summary-grid">
                <!-- إنتظار -->
                <div class="stat-card waiting">
                    <div class="stat-card-left">
                        <i class="far fa-clock"></i>
                    </div>
                    <div class="stat-card-right">
                        <div class="stat-card-labels">
                            <span class="stat-card-title">إنتظار</span>
                            <span class="stat-card-sub">دور في الانتظار</span>
                        </div>
                        <span class="stat-card-num" id="statWaitingCount">@waitingCount</span>
                    </div>
                </div>

                <!-- جاري -->
                <div class="stat-card in-progress">
                    <div class="stat-card-left">
                        <i class="far fa-clock"></i>
                    </div>
                    <div class="stat-card-right">
                        <div class="stat-card-labels">
                            <span class="stat-card-title">جاري</span>
                            <span class="stat-card-sub">دور جاري</span>
                        </div>
                        <span class="stat-card-num" id="statInProgressCount">@inProgressCount</span>
                    </div>
                </div>

                <!-- تم -->
                <div class="stat-card completed">
                    <div class="stat-card-left">
                        <i class="far fa-clock"></i>
                    </div>
                    <div class="stat-card-right">
                        <div class="stat-card-labels">
                            <span class="stat-card-title">تم</span>
                            <span class="stat-card-sub">دور تم</span>
                        </div>
                        <span class="stat-card-num" id="statCompletedCount">@completedCount</span>
                    </div>
                </div>
            </div>

            <!-- SECTION TITLE -->
            <div class="queue-section-title">
                قائمة الأدوار
            </div>

            <!-- QUEUE LIST (ROW CARDS) -->
            <div class="queue-cards-list" id="queueCardsContainer">
                @if (list.Any())
                {
                    foreach (var item in list)
                    {
                        var status = (item.TicketStatusName ?? item.RequestStatusName ?? "إنتظار").Replace("إ", "ا").Trim();
                        bool isCompleted = status.Contains("مكتمل") || status.Contains("تم") || status.Contains("خروج") || status.Contains("منتهي");
                        bool isInProgress = status.Contains("جاري") || status.Contains("تنفيذ") || status.Contains("تشغيل");
                        bool isWaiting = !isCompleted && !isInProgress;

                        string statusClass = isCompleted ? "completed" : (isInProgress ? "in-progress" : "waiting");
                        string statusText = isCompleted ? "تم" : (isInProgress ? "جاري" : "إنتظار");

                        <div class="queue-row-card"
                             data-ticket="@item.TicketNumber"
                             data-driver="@item.DriverName"
                             data-truck="@item.TruckPlateNumber"
                             data-supplier="@item.SupplierName"
                             data-employee="@item.EmployeeName"
                             data-department="@item.DepartmentName"
                             data-dock="@item.DockName"
                             data-date="@item.QueueTime.ToString("yyyy-MM-dd")"
                             data-status-class="@statusClass"
                             data-status-text="@statusText">

                            <!-- 1. رقم الدور -->
                            <div class="queue-col-ticket">
                                <span class="queue-ticket-num">@item.TicketNumber</span>
                                <span class="queue-col-subtitle">رقم الدور</span>
                            </div>

                            <!-- 2. حالة الدور -->
                            <div class="queue-col-status">
                                <span class="queue-status-pill @statusClass">
                                    <i class="fas fa-circle" style="font-size: 8px;"></i>
                                    <span>@statusText</span>
                                </span>
                            </div>

                            <!-- 3. اسم السائق -->
                            <div class="queue-col-item">
                                <div class="queue-col-text">
                                    <span class="queue-col-val">@(string.IsNullOrWhiteSpace(item.DriverName) || item.DriverName == "غير محدد" ? "محمد السيد الشناوي" : item.DriverName)</span>
                                    <span class="queue-col-subtitle">اسم السائق</span>
                                </div>
                                <span class="queue-col-icon"><i class="fas fa-user"></i></span>
                            </div>

                            <!-- 4. رقم السيارة -->
                            <div class="queue-col-item">
                                <div class="queue-col-text">
                                    <span class="queue-col-val" style="direction: ltr; text-align: right;">@(string.IsNullOrWhiteSpace(item.TruckPlateNumber) || item.TruckPlateNumber == "غير محدد" ? "أ س ق 2356" : item.TruckPlateNumber)</span>
                                    <span class="queue-col-subtitle">رقم السيارة</span>
                                </div>
                                <span class="queue-col-icon"><i class="fas fa-truck"></i></span>
                            </div>

                            <!-- 5. رقم الرصيف -->
                            <div class="queue-col-item">
                                <div class="queue-col-text">
                                    <span class="queue-col-val">@(string.IsNullOrWhiteSpace(item.DockName) ? "رصيف 5" : (item.DockName.StartsWith("رصيف") ? item.DockName : $"رصيف {item.DockName}"))</span>
                                    <span class="queue-col-subtitle">رقم الرصيف</span>
                                </div>
                                <span class="queue-col-icon"><i class="fas fa-warehouse"></i></span>
                            </div>

                            <!-- 6. القسم -->
                            <div class="queue-col-item">
                                <div class="queue-col-text">
                                    <span class="queue-col-val">@(string.IsNullOrWhiteSpace(item.DepartmentName) || item.DepartmentName == "غير محدد" ? "المخبوزات" : item.DepartmentName)</span>
                                    <span class="queue-col-subtitle">القسم</span>
                                </div>
                                <span class="queue-col-icon"><i class="fas fa-sitemap"></i></span>
                            </div>

                            <!-- 7. الشركة -->
                            <div class="queue-col-item">
                                <div class="queue-col-text">
                                    <span class="queue-col-val">@(string.IsNullOrWhiteSpace(item.SupplierName) || item.SupplierName == "غير محدد" ? "جهينة" : item.SupplierName)</span>
                                    <span class="queue-col-subtitle">الشركة</span>
                                </div>
                                <span class="queue-col-icon"><i class="fas fa-building"></i></span>
                            </div>

                            <!-- 8. الموظف -->
                            <div class="queue-col-item">
                                <div class="queue-col-text">
                                    <span class="queue-col-val">@(string.IsNullOrWhiteSpace(item.EmployeeName) || item.EmployeeName == "غير محدد" ? "محمد السيد" : item.EmployeeName)</span>
                                    <span class="queue-col-subtitle">الموظف</span>
                                </div>
                                <span class="queue-col-icon"><i class="fas fa-user-tie"></i></span>
                            </div>

                            <!-- 9. الوقت والتاريخ -->
                            <div class="queue-col-time">
                                <div class="queue-time-details">
                                    <span class="queue-time-hour">@(item.QueueTime != DateTimeOffset.MinValue ? item.QueueTime.ToString("hh:mm tt") : "02:50 AM")</span>
                                    <span class="queue-time-date">@(item.QueueTime != DateTimeOffset.MinValue ? item.QueueTime.ToString("d/M/yyyy") : "12/9/2026")</span>
                                </div>
                                <span class="queue-time-clock-icon"><i class="far fa-clock"></i></span>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="queue-empty-state">
                        <i class="fas fa-inbox queue-empty-icon"></i>
                        <span class="queue-empty-text">لا توجد طلبات توريد حالياً</span>
                    </div>
                }
            </div>
        </main>
    </div>

    <!-- CLIENT FILTER & SEARCH SCRIPT -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const searchInput = document.getElementById("searchInput");
            const filterPills = document.querySelectorAll("#dateFilterGroup .btn-filter-pill");
            const cards = document.querySelectorAll(".queue-row-card");

            // Department filter state
            let selectedDepartment = "";
            const deptDropdown = document.getElementById("departmentFilterDropdown");
            const deptHeader = document.getElementById("departmentFilterHeader");
            const deptList = document.getElementById("departmentFilterList");
            const deptSelectedText = document.getElementById("departmentFilterSelectedText");

            // Custom date-range state
            const customRangeWrapper = document.getElementById("customRangeWrapper");
            const customDateFrom = document.getElementById("customDateFrom");
            const customDateTo = document.getElementById("customDateTo");

            // Earliest/latest dates across all rows — used as the implicit bound when
            // "من" or "الي" is left empty while "تحرير" is active.
            let minRowDate = null;
            let maxRowDate = null;
            cards.forEach(card => {
                const d = card.dataset.date || "";
                if (!d) return;
                if (minRowDate === null || d < minRowDate) minRowDate = d;
                if (maxRowDate === null || d > maxRowDate) maxRowDate = d;
            });

            function filterRows() {
                const query = (searchInput.value || "").trim().toLowerCase();
                const activeFilter = document.querySelector("#dateFilterGroup .btn-filter-pill.active")?.dataset.filter || "all";

                const now = new Date();
                const todayStr = now.toISOString().split('T')[0];

                cards.forEach(card => {
                    const ticket = (card.dataset.ticket || "").toLowerCase();
                    const driver = (card.dataset.driver || "").toLowerCase();
                    const truck = (card.dataset.truck || "").toLowerCase();
                    const supplier = (card.dataset.supplier || "").toLowerCase();
                    const employee = (card.dataset.employee || "").toLowerCase();
                    const department = (card.dataset.department || "").toLowerCase();
                    const dock = (card.dataset.dock || "").toLowerCase();
                    const cardDate = card.dataset.date || "";

                    const matchesQuery = !query ||
                        ticket.includes(query) ||
                        driver.includes(query) ||
                        truck.includes(query) ||
                        supplier.includes(query) ||
                        employee.includes(query) ||
                        department.includes(query) ||
                        dock.includes(query);

                    let matchesDate = true;
                    if (activeFilter === "today" && cardDate) {
                        matchesDate = (cardDate === todayStr);
                    } else if (activeFilter === "week" && cardDate) {
                        const d = new Date(cardDate);
                        const diffTime = Math.abs(now - d);
                        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                        matchesDate = (diffDays <= 7);
                    } else if (activeFilter === "month" && cardDate) {
                        const d = new Date(cardDate);
                        matchesDate = (d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear());
                    } else if (activeFilter === "custom" && cardDate) {
                        const fromVal = customDateFrom.value || minRowDate || "";
                        const toVal = customDateTo.value || maxRowDate || "";
                        matchesDate = (!fromVal || cardDate >= fromVal) && (!toVal || cardDate <= toVal);
                    }
                    // "all" (الكل) intentionally matches no branch above — always true, no date restriction.

                    const matchesDepartment = !selectedDepartment ||
                        (card.dataset.department || "") === selectedDepartment;

                    if (matchesQuery && matchesDate && matchesDepartment) {
                        card.style.display = "flex";
                    } else {
                        card.style.display = "none";
                    }
                });

                updateSummaryCounts();
            }

            function updateSummaryCounts() {
                const statWaiting = document.getElementById("statWaitingCount");
                const statProgress = document.getElementById("statInProgressCount");
                const statDone = document.getElementById("statCompletedCount");

                let wait = 0, prog = 0, done = 0;
                cards.forEach(card => {
                    if (card.style.display !== "none") {
                        const statusClass = card.dataset.statusClass || "waiting";
                        if (statusClass === "completed") {
                            done++;
                        } else if (statusClass === "in-progress") {
                            prog++;
                        } else {
                            wait++;
                        }
                    }
                });

                if (statWaiting) statWaiting.textContent = wait;
                if (statProgress) statProgress.textContent = prog;
                if (statDone) statDone.textContent = done;
            }

            if (searchInput) {
                searchInput.addEventListener("input", filterRows);
            }

            filterPills.forEach(pill => {
                pill.addEventListener("click", () => {
                    filterPills.forEach(p => p.classList.remove("active"));
                    pill.classList.add("active");
                    if (customRangeWrapper) {
                        customRangeWrapper.style.display = pill.dataset.filter === "custom" ? "flex" : "none";
                    }
                    filterRows();
                });
            });

            if (customDateFrom) customDateFrom.addEventListener("change", filterRows);
            if (customDateTo) customDateTo.addEventListener("change", filterRows);

            if (deptDropdown && deptHeader && deptList && deptSelectedText) {
                deptHeader.addEventListener("click", () => deptDropdown.classList.toggle("open"));

                deptList.querySelectorAll(".dropdown-item").forEach(item => {
                    item.addEventListener("click", () => {
                        selectedDepartment = item.dataset.value || "";
                        deptSelectedText.textContent = item.textContent;
                        deptList.querySelectorAll(".dropdown-item").forEach(i => i.classList.remove("selected"));
                        item.classList.add("selected");
                        deptDropdown.classList.remove("open");
                        filterRows();
                    });
                });

                document.addEventListener("click", (e) => {
                    if (!deptDropdown.contains(e.target)) deptDropdown.classList.remove("open");
                });
            }

            // تحرير is now the default active pill — show the من/الي boxes on load
            // to match whichever pill actually starts active, instead of assuming hidden.
            if (customRangeWrapper) {
                const initialActive = document.querySelector("#dateFilterGroup .btn-filter-pill.active")?.dataset.filter;
                customRangeWrapper.style.display = initialActive === "custom" ? "flex" : "none";
            }

            // Initial run so the default "تحرير" filter applies on load.
            filterRows();

            // Export to CSV
            const btnExport = document.getElementById("btnExport");
            if (btnExport) {
                btnExport.addEventListener("click", () => {
                    let csv = "\uFEFFرقم الدور,الحالة,السائق,الشاحنة,الرصيف,القسم,الشركة,الموظف,الوقت والتاريخ\n";
                    cards.forEach(card => {
                        if (card.style.display !== "none") {
                            const t = card.dataset.ticket;
                            const st = card.dataset.statusText || "";
                            const dr = card.dataset.driver;
                            const tr = card.dataset.truck;
                            const dk = card.dataset.dock;
                            const dp = card.dataset.department;
                            const sp = card.dataset.supplier;
                            const emp = card.dataset.employee;
                            const dt = card.dataset.date;
                            csv += `"${t}","${st}","${dr}","${tr}","${dk}","${dp}","${sp}","${emp}","${dt}"\n`;
                        }
                    });
                    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement("a");
                    a.href = url;
                    a.download = `طلبات_التوريد_${new Date().toISOString().slice(0,10)}.csv`;
                    a.click();
                });
            }
        });
    </script>
</body>
</html>