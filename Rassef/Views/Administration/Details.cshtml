@model Rassef.ViewModels.Administration.Employee.EmployeeDetailsVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيف — تفاصيل الموظف</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/employeeDetails.css" asp-append-version="true">
</head>
<body>

    <div class="dashboard-page">

        <!-- ── RIGHT SIDEBAR ── -->
        <aside class="dashboard-sidebar">
            <div class="sidebar-top">
                <h1 class="sidebar-title">لوحة التحكم</h1>
                <ul class="sidebar-menu">
                    <li>
                        <a href="@Url.Action("AddRoleOrView", "Authentication")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                            <span>الرجوع</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Administration")" class="sidebar-item active">
                            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="2.5" /><path d="M15 8h4M15 12h4M6 17h12" /></svg>
                            <span>كل الموظفين</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("TrucksIndex", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" /><polygon points="16 8 20 8 23 11 23 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                            <span>السيارات المسجلة</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("DriversIndex", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                            <span>السائقين المسجلين</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Suppliers", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
                            <span>الموردين</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("SupplierRequests", "Administration")" class="sidebar-item">
                            <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" /></svg>
                            <span>طلبات التوريد</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("TransferRequests", "Administration")" class="sidebar-item" id="transferRequestsBtn">
                            <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" /></svg>
                            <span>طلبات التحويل</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- User Profile Widget -->
            <div class="sidebar-user">
                <div class="user-info-group">
                    <div class="user-avatar-box">
                        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    </div>
                    <div class="user-details">
                        <span class="user-name">@(User.Identity?.Name ?? "المسؤول")</span>
                        <span class="user-role">لوحة الإدارة</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ── MAIN CONTENT AREA ── -->
        <main class="dashboard-main">
            <header class="dashboard-header">
                <button class="mobile-toggle" id="mobileToggle" aria-label="القائمة">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div class="header-right">
                    <h2 class="header-title">تفاصيل الموظف</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>بيانات الموظف المسجلة بالنظام</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- Back Button -->
            <div class="back-action-container">
                <a href="@Url.Action("Index", "Administration")" class="btn-back-orange" id="btnBackToDashboard" style="text-decoration: none;">
                    <span>رجوع</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                </a>
            </div>

            @if (Model != null)
            {
                <!-- Employee Details Container -->
                <div id="employeeContentContainer">
                    <!-- Hero Card -->
                    <div class="hero-card">
                        <div class="hero-info">
                            <h2 class="hero-name" id="employeeName">@Model.Name</h2>
                            <div class="hero-badge" id="employeeBadge">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7h-3a2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>
                                <span id="employeeRoleBadge">@Model.Role</span>
                            </div>
                            <p class="hero-code">الكود : <span id="employeeCodeHeader">@(string.IsNullOrWhiteSpace(Model.UserCode) ? "--" : Model.UserCode)</span></p>
                        </div>
                        <div class="hero-avatar-wrapper">
                            <div class="hero-avatar">
                                <span id="employeeAvatarLetter">@(!string.IsNullOrWhiteSpace(Model.Name) ? Model.Name.Trim().Substring(0, 1) : "م")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Section Title -->
                    <div class="section-title-wrapper">
                        <h3 class="section-title">معلومات الموظف</h3>
                        <div class="section-divider"></div>
                    </div>

                    <!-- Info Cards Grid -->
                    <div class="info-grid">
                        <!-- Card: Name -->
                        <div class="info-card">
                            <div class="info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                            </div>
                            <div class="info-text">
                                <span class="info-label">الإسم</span>
                                <span class="info-value" id="cardName">@Model.Name</span>
                            </div>
                        </div>

                        <!-- Card: Code -->
                        <div class="info-card">
                            <div class="info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /><path d="M8 14h.01" /><path d="M12 14h.01" /><path d="M16 14h.01" /><path d="M8 18h.01" /><path d="M12 18h.01" /><path d="M16 18h.01" /></svg>
                            </div>
                            <div class="info-text">
                                <span class="info-label">الكود</span>
                                <span class="info-value" id="cardCode">@(string.IsNullOrWhiteSpace(Model.UserCode) ? "--" : Model.UserCode)</span>
                            </div>
                        </div>

                        <!-- Card: Role -->
                        <div class="info-card">
                            <div class="info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" /></svg>
                            </div>
                            <div class="info-text">
                                <span class="info-label">الدور</span>
                                <span class="info-value" id="cardRole">@Model.Role</span>
                            </div>
                        </div>

                        <!-- Card: Phone -->
                        <div class="info-card">
                            <div class="info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                            </div>
                            <div class="info-text">
                                <span class="info-label">رقم الهاتف</span>
                                <span class="info-value" id="cardPhone" dir="ltr">@Model.Phone</span>
                            </div>
                        </div>

                        <!-- Card: Email -->
                        <div class="info-card">
                            <div class="info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                            </div>
                            <div class="info-text">
                                <span class="info-label">البريد الإلكتروني</span>
                                <span class="info-value cell-email" id="cardEmail">@Model.Email</span>
                            </div>
                        </div>

                        <!-- Card: National ID -->
                        <div class="info-card">
                            <div class="info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2" ry="2" /><line x1="7" y1="8" x2="17" y2="8" /><line x1="7" y1="12" x2="17" y2="12" /><line x1="7" y1="16" x2="13" y2="16" /></svg>
                            </div>
                            <div class="info-text">
                                <span class="info-label">الرقم القومي</span>
                                <span class="info-value" id="cardNationalId">@Model.NationalId</span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="actions-footer">
                        <a href="@Url.Action("Edit", "Administration", new { id = Model.Id })" class="btn-edit" style="text-decoration: none;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                            <span>تعديل البيانات</span>
                        </a>
                        <button type="button" class="btn-delete" id="btnDeleteEmployee">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" /></svg>
                            <span>حذف البيانات</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Error State -->
                <div class="empty-state-container" id="errorStateContainer">
                    <h3 class="section-title" style="color: #dc3545;">الموظف غير موجود</h3>
                    <p style="color: var(--text-muted); margin-top: 10px;">عذراً، لم يتم العثور على بيانات الموظف المطلوب.</p>
                    <a href="@Url.Action("Index", "Administration")" class="btn-action-orange" style="margin-top: 20px; text-decoration: none; display: inline-block;">العودة إلى الموظفين</a>
                </div>
            }

        </main>

    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal-overlay" id="deleteModal" style="display: none;">
        <div class="modal-card">
            <h3 class="modal-title">تأكيد الحذف</h3>
            <p class="modal-text">هل أنت متأكد من رغبتك في حذف بيانات هذا الموظف نهائياً؟ لا يمكن التراجع عن هذا الإجراء.</p>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" id="btnCancelDelete">إلغاء</button>
                <form method="post" action="@Url.Action("DeleteConfirmed", "Administration", new { id = Model?.Id })" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-confirm-delete" id="btnConfirmDelete">حذف</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const deleteBtn = document.getElementById('btnDeleteEmployee');
            const deleteModal = document.getElementById('deleteModal');
            const cancelBtn = document.getElementById('btnCancelDelete');

            if (deleteBtn && deleteModal) {
                deleteBtn.addEventListener('click', () => {
                    deleteModal.style.display = 'flex';
                });
            }

            if (cancelBtn && deleteModal) {
                cancelBtn.addEventListener('click', () => {
                    deleteModal.style.display = 'none';
                });
            }

            const mobileToggle = document.getElementById('mobileToggle');
            const sidebar = document.querySelector('.dashboard-sidebar');
            if (mobileToggle && sidebar) {
                mobileToggle.addEventListener('click', () => {
                    sidebar.classList.toggle('active');
                });
            }
        });
    </script>
</body>
</html>