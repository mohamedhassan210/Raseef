@model IEnumerable<Rassef.ViewModels.Supplier.SupplierListVM>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيف — لوحة التحكم (الموردين)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true">
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <partial name="_AdminSidebar" model='"Suppliers"' />

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <header class="dashboard-header">
                <button class="mobile-toggle" id="mobileToggle" aria-label="القائمة">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div class="header-right">
                    <h2 class="header-title">الموردين المسجلين</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span id="suppliersTotalCount">إجمالي الموردين: @(Model?.Count() ?? 0)</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- Actions Bar -->
            <div class="dashboard-actions-bar">
                <!-- Filter Dropdown -->
                <div class="dropdown-container">
                    <button class="dropdown-pill" id="filterDropdown">
                        <span id="sortBtnText">تصنيف عبر : الإسم</span>
                        <svg class="dropdown-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                    </button>
                    <ul class="dropdown-menu" id="sortMenu">
                        <li data-sort="name">الإسم</li>
                        <li data-sort="phone">رقم الهاتف</li>
                        <li data-sort="code">كود المورد</li>
                        <li data-sort="host">الموظف المضيف</li>
                    </ul>
                </div>

                <!-- Search Input -->
                <div class="dashboard-search-bar">
                    <input type="search" id="supplierSearch" placeholder="ادخل اسم المورد أو الهاتف أو الكود" autocomplete="off">
                    <button class="dashboard-search-btn" aria-label="بحث">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" stroke="white" stroke-width="2.2" stroke-linecap="round" /></svg>
                    </button>
                </div>

                <!-- Export -->
                <button class="btn-action-export" id="exportBtn">
                    <span>تصدير</span>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                </button>

                <!-- Add Supplier -->
                <a href="@Url.Action("Create", "Supplier")" class="btn-action-add" id="addSupplierBtn" style="text-decoration: none;">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    <span>إضافة مورد</span>
                </a>
            </div>

            <!-- Table -->
            <div class="table-container">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th class="col-name">اسم المورد</th>
                            <th class="col-phone">رقم الهاتف</th>
                            <th class="col-code">كود المورد</th>
                            <th class="col-host">الموظف المضيف</th>
                            <th class="col-action">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="supplierTableBody">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="table-row">
                                    <td class="col-name">@item.Name</td>
                                    <td class="col-phone">@item.Phone</td>
                                    <td class="col-code">@item.SupCode</td>
                                    <td class="col-host">@item.HostEmployeeName</td>
                                    <td class="col-action">
                                        <a href="@Url.Action("SupplierDetails", "Administration", new { id = item.Id })" class="btn-table-details" style="text-decoration: none;">
                                            <span>تفاصيل</span>
                                            <span class="arrow">&larr;</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="empty-state">لا يوجد أي موردين مسجلين حتى الآن</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="pagination-container" id="paginationContainer"></div>
        </main>
    </div>

    <script>
        window.initialSuppliersData = @Html.Raw(Json.Serialize(Model != null ? Model.Select(s => new {
            id = s.Id,
            name = s.Name ?? "",
            phone = s.Phone ?? "",
            code = s.SupCode ?? "",
            host = s.HostEmployeeName ?? ""
        }).ToList() : new List<object>()));

        window.mvcRoutes = {
            detailsUrl: '@Url.Action("SupplierDetails", "Administration")',
            createUrl: '@Url.Action("Create", "Supplier")'
        };

        document.addEventListener('DOMContentLoaded', () => {
            const tableBody = document.getElementById('supplierTableBody');
            const searchInput = document.getElementById('supplierSearch');
            const paginationContainer = document.getElementById('paginationContainer');
            const filterDropdown = document.getElementById('filterDropdown');
            const sortBtnText = document.getElementById('sortBtnText');
            const sortMenu = document.getElementById('sortMenu');
            const exportBtn = document.getElementById('exportBtn');

            const state = {
                currentPage: 1,
                itemsPerPage: 10,
                searchTerm: "",
                sortBy: "name",
                sortDesc: false,
                allData: Array.isArray(window.initialSuppliersData) ? window.initialSuppliersData : []
            };

            const sortLabels = {
                "name": "الإسم",
                "phone": "رقم الهاتف",
                "code": "كود المورد",
                "host": "الموظف المضيف"
            };

            function filterData() {
                let list = [...state.allData];
                if (state.searchTerm) {
                    const term = state.searchTerm.toLowerCase();
                    list = list.filter(item =>
                        (item.name && item.name.toLowerCase().includes(term)) ||
                        (item.phone && item.phone.includes(term)) ||
                        (item.code && item.code.toLowerCase().includes(term)) ||
                        (item.host && item.host.toLowerCase().includes(term))
                    );
                }

                list.sort((a, b) => {
                    const valA = String(a[state.sortBy] || "");
                    const valB = String(b[state.sortBy] || "");
                    const cmp = valA.localeCompare(valB, 'ar', { numeric: true });
                    return state.sortDesc ? -cmp : cmp;
                });

                return list;
            }

            function renderTable() {
                if (!tableBody) return;
                const filtered = filterData();
                const totalPages = Math.ceil(filtered.length / state.itemsPerPage) || 1;

                if (state.currentPage > totalPages) state.currentPage = 1;

                const start = (state.currentPage - 1) * state.itemsPerPage;
                const pageItems = filtered.slice(start, start + state.itemsPerPage);

                tableBody.innerHTML = '';

                if (pageItems.length === 0) {
                    tableBody.innerHTML = `<tr><td colspan="5" class="empty-state">لا توجد نتائج مطابقة للبحث</td></tr>`;
                } else {
                    pageItems.forEach(item => {
                        const tr = document.createElement('tr');
                        tr.className = 'table-row';
                        const detailsLink = `${window.mvcRoutes.detailsUrl}/${item.id}`;
                        tr.innerHTML = `
                            <td class="col-name">${item.name || '--'}</td>
                            <td class="col-phone">${item.phone || '--'}</td>
                            <td class="col-code">${item.code || '--'}</td>
                            <td class="col-host">${item.host || '--'}</td>
                            <td class="col-action">
                                <a href="${detailsLink}" class="btn-table-details" style="text-decoration: none;">
                                    <span>تفاصيل</span>
                                    <span class="arrow">&larr;</span>
                                </a>
                            </td>
                        `;
                        tableBody.appendChild(tr);
                    });
                }

                renderPagination(totalPages);
            }

            function renderPagination(totalPages) {
                if (!paginationContainer) return;
                paginationContainer.innerHTML = '';
                if (totalPages <= 1) return;

                const prev = document.createElement('button');
                prev.className = 'page-item';
                prev.innerHTML = '&gt;';
                prev.disabled = state.currentPage === 1;
                prev.addEventListener('click', () => {
                    if (state.currentPage > 1) {
                        state.currentPage--;
                        renderTable();
                    }
                });
                paginationContainer.appendChild(prev);

                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button');
                    btn.className = `page-item ${i === state.currentPage ? 'active' : ''}`;
                    btn.textContent = i;
                    btn.addEventListener('click', () => {
                        state.currentPage = i;
                        renderTable();
                    });
                    paginationContainer.appendChild(btn);
                }

                const next = document.createElement('button');
                next.className = 'page-item';
                next.innerHTML = '&lt;';
                next.disabled = state.currentPage === totalPages;
                next.addEventListener('click', () => {
                    if (state.currentPage < totalPages) {
                        state.currentPage++;
                        renderTable();
                    }
                });
                paginationContainer.appendChild(next);
            }

            // Events
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    state.searchTerm = e.target.value.trim();
                    state.currentPage = 1;
                    renderTable();
                });
            }

            if (filterDropdown && sortMenu) {
                filterDropdown.addEventListener('click', (e) => {
                    e.stopPropagation();
                    sortMenu.classList.toggle('show');
                });

                document.addEventListener('click', () => {
                    sortMenu.classList.remove('show');
                });

                sortMenu.querySelectorAll('li').forEach(li => {
                    li.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const sortKey = li.dataset.sort;
                        if (state.sortBy === sortKey) {
                            state.sortDesc = !state.sortDesc;
                        } else {
                            state.sortBy = sortKey;
                            state.sortDesc = false;
                        }
                        if (sortBtnText) {
                            sortBtnText.textContent = `تصنيف عبر : ${sortLabels[sortKey] || sortKey}`;
                        }
                        sortMenu.classList.remove('show');
                        state.currentPage = 1;
                        renderTable();
                    });
                });
            }

            // Export to Excel
            if (exportBtn) {
                exportBtn.addEventListener('click', () => {
                    if (!window.XLSX) {
                        alert("مكتبة التصدير غير محملة.");
                        return;
                    }
                    const dataToExport = filterData().map(s => ({
                        "اسم المورد": s.name,
                        "رقم الهاتف": s.phone,
                        "كود المورد": s.code,
                        "الموظف المضيف": s.host
                    }));

                    const worksheet = XLSX.utils.json_to_sheet(dataToExport);
                    const workbook = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(workbook, worksheet, "الموردين");
                    XLSX.writeFile(workbook, "قائمة_الموردين.xlsx");
                });
            }
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</body>
</html>
