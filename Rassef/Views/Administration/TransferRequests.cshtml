@model IEnumerable<TransferRequestListVM>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيف — لوحة التحكم (طلبات التحويل)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css">
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <partial name="_AdminSidebar" model='"TransferRequests"' />

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <header class="dashboard-header">
                <div class="header-right">
                    <h2 class="header-title">طلبات التحويل الحالية</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>إجمالي الطلبات: @(Model?.Count() ?? 0)</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <div class="table-container">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>رقم التذكرة</th>
                            <th>نوع الطلب</th>
                            <th>رقم الأفيز</th>
                            <th>السائق</th>
                            <th>الشاحنة</th>
                            <th>القسم</th>
                            <th>الرصيف</th>
                            <th>حالة الطلب</th>
                            <th>الموظف</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="table-row">
                                    <td>@item.TicketNumber</td>
                                    <td>
                                        <span class="badge-type-transfer" style="background: #e3f2fd; color: #1976d2; padding: 3px 8px; border-radius: 6px; font-weight: 600; font-size: 0.85rem; border: 1px solid #bbdefb;">تحويل</span>
                                    </td>
                                    <td>@item.AvizNumber</td>
                                    <td>@item.DriverName</td>
                                    <td>@item.TruckPlateNumber</td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.DockName</td>
                                    <td>@item.RequestStatus</td>
                                    <td>@item.EmployeeName</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="empty-state">لا يوجد أي طلبات تحويل حالياً</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</body>
</html>
