@using Rassef.ViewModels.Shared
@model List<DocCardVM>
@{
    // Context passed in from the caller (Department/Details or Department/Update)
    // via a ViewDataDictionary, since this partial is shared by both pages.
    int departmentId = (int)(ViewData["DepartmentId"] ?? 0);
    string returnAction = (ViewData["ReturnAction"] as string) ?? "Details";
    string returnUrl = Url.Action(returnAction, "Department", new { id = departmentId }) ?? "/";
}

<style>
    .doc-cards-wrap { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
    .doc-card { border: 1px solid #eadbc8; border-radius: 10px; background: #fff; padding: 8px 12px; min-width: 190px; font-size: 13px; position: relative; }
    .doc-card-row { display: flex; justify-content: space-between; gap: 8px; }
    .doc-card-field { color: #555; margin-bottom: 2px; }
    .doc-card-field b { color: #222; }
    .card-x-btn { border: none; background: #fde8e8; color: #dc3545; width: 26px; height: 26px; border-radius: 50%; font-weight: 700; line-height: 1; cursor: pointer; flex-shrink: 0; }
    .card-x-btn:hover { background: #f8b4b4; }
    .card-add-btn { border: none; background: #fde8cb; color: #a86b2c; width: 26px; height: 26px; border-radius: 50%; font-weight: 700; font-size: 16px; line-height: 1; cursor: pointer; flex-shrink: 0; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
    .card-add-btn:hover { background: #f7d29b; color: #7a4c1f; }
    .empty-hint { color: #999; font-size: 13px; padding: 4px 2px; }
    .section-add-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
</style>

<div class="doc-cards-section">

    <div class="section-add-row">
        <label class="form-label fw-bold mb-0">المستندات</label>
        <a class="card-add-btn" title="إضافة مستند جديد"
           href="@Url.Action("Create", "SupplierRequest", new { departmentId = departmentId, returnUrl = returnUrl })">+</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="doc-cards-wrap">
            @foreach (var doc in Model)
            {
                <div class="doc-card">
                    <div class="doc-card-row">
                        <div>
                            <div class="doc-card-field"><b>@doc.SupplierName</b></div>
                            <div class="doc-card-field">@doc.TruckInfo</div>
                            <div class="doc-card-field">@doc.DriverName</div>
                            <div class="doc-card-field">@doc.StatusName</div>
                        </div>
                        <form asp-action="RemoveDocCard" asp-controller="Department" method="post"
                              onsubmit="return confirm('سيتم حذف هذا المستند نهائيًا ولا يمكن التراجع. هل أنت متأكد؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@doc.Id" />
                            <input type="hidden" name="departmentId" value="@departmentId" />
                            <input type="hidden" name="returnAction" value="@returnAction" />
                            <button type="submit" class="card-x-btn" title="حذف المستند نهائيًا">✕</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-hint">لا توجد مستندات مرتبطة بهذا القسم بعد.</div>
    }

</div>
