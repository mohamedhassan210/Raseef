<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/beforhome.css">
    <!-- AdminSidebar's own styling only — NOT sidebar.css, which also carries
         page-shell rules (html/body overflow:hidden, .dashboard-page, etc.)
         built for the 31 standalone dashboard pages, not for this layout. -->
    <link rel="stylesheet" href="~/css/sidebar-widget.css" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @RenderBody()

    @{
        // Unified sidebar: every page on this layout gets the same AdminSidebar
        // (accordion, permission-gated — non-admins just see fewer items, never
        // a 403 link) that the admin-dashboard pages use. UserSidebarViewComponent
        // has been removed entirely — this is now the only sidebar in the app.
        // Set ViewData["ActiveSidebar"] in the page to highlight its menu item;
        // leave it unset for pages with no matching category (e.g. SupplyOrder).
        var sidebarActive = ViewData["ActiveSidebar"] as string;
    }
    @await Component.InvokeAsync("AdminSidebar", new { active = sidebarActive ?? string.Empty })

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>