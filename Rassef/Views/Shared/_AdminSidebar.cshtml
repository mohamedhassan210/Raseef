@model string
@{
    var active = Model ?? "";
}

<aside class="dashboard-sidebar">
    <div class="sidebar-top">
        <h1 class="sidebar-title">لوحة التحكم</h1>
        <ul class="sidebar-menu">
            <li>
                <a href="@Url.Action("AddRoleOrView", "Authentication")" class="sidebar-item">
                    <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                    <span>الرجوع</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "Administration")" class="sidebar-item @(active == "Employees" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="2.5" /><path d="M15 8h4M15 12h4M6 17h12" /></svg>
                    <span>كل الموظفين</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("TrucksIndex", "Administration")" class="sidebar-item @(active == "Trucks" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" /><polygon points="16 8 20 8 23 11 23 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                    <span>السيارات المسجلة</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("DriversIndex", "Administration")" class="sidebar-item @(active == "Drivers" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    <span>السائقين المسجلين</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Suppliers", "Administration")" class="sidebar-item @(active == "Suppliers" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
                    <span>الموردين</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("SupplierRequests", "Administration")" class="sidebar-item @(active == "SupplierRequests" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" /></svg>
                    <span>طلبات التوريد</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("TransferRequests", "Administration")" class="sidebar-item @(active == "TransferRequests" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" /></svg>
                    <span>طلبات التحويل</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("GroupManagment", "Group")" class="sidebar-item @(active == "Groups" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    <span>إدارة المجموعات</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("MangeRolesIndex", "Group")" class="sidebar-item @(active == "Roles" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                    <span>إدارة الأدوار</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("MangeTypesIndex", "Group")" class="sidebar-item @(active == "Options" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                    <span>إدارة الإختيارات</span>
                </a>
            </li>
        </ul>
    </div>
    <div class="sidebar-user">
        <div class="user-info-group">
            <div class="user-avatar-box">
                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
            </div>
            <div class="user-details">
                <span class="user-name">@(User.Identity?.Name ?? "محمد عبد صادق")</span>
                <span class="user-role">مدير الأحمال</span>
            </div>
        </div>
    </div>
</aside>
