@model Rassef.ViewComponents.UserSidebarViewModel

@if (!Model.IsAuthenticated)
{
    return;
}

<style>
    .rassef-usermenu-toggle {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 10040;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        border: 2px solid #e67e22;
        background-color: #ffffff;
        color: #e67e22;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    }

    .rassef-usermenu-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 10045;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
    }

        .rassef-usermenu-backdrop.rassef-open {
            opacity: 1;
            pointer-events: auto;
        }

    .rassef-usermenu-panel {
        position: fixed;
        top: 0;
        right: 0;
        height: 100%;
        width: min(300px, 85vw);
        background: #ffffff;
        z-index: 10050;
        box-shadow: -6px 0 20px rgba(0, 0, 0, 0.2);
        transform: translateX(100%);
        transition: transform 0.28s ease;
        font-family: 'IBM Plex Sans Arabic', sans-serif;
        display: flex;
        flex-direction: column;
        padding: 24px 20px;
        gap: 18px;
        direction: rtl;
    }

        .rassef-usermenu-panel.rassef-open {
            transform: translateX(0);
        }

    .rassef-usermenu-close {
        align-self: flex-start;
        background: none;
        border: none;
        font-size: 26px;
        line-height: 1;
        color: #332D24;
        cursor: pointer;
    }

    .rassef-usermenu-alert {
        background: #fdecea;
        color: #b3261e;
        border: 1px solid #f5c2c0;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 13px;
    }

    .rassef-usermenu-greeting {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        color: #332D24;
        font-size: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eee;
    }

        .rassef-usermenu-greeting svg {
            width: 30px;
            height: 30px;
            color: #e67e22;
        }

    .rassef-usermenu-warehouse-form {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .rassef-usermenu-warehouse-form label {
            font-size: 13px;
            color: #7a7367;
            font-weight: 600;
        }

        .rassef-usermenu-warehouse-form select {
            border: 2px solid #e67e22;
            border-radius: 8px;
            padding: 8px 10px;
            font-family: inherit;
            font-weight: 600;
            color: #332D24;
            background: #fff;
        }

    .rassef-usermenu-no-warehouse {
        font-size: 13px;
        color: #b3261e;
        background: #fdecea;
        border-radius: 8px;
        padding: 8px 10px;
    }

    .rassef-usermenu-link, .rassef-usermenu-logout {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        padding: 10px 12px;
        border-radius: 8px;
        transition: background-color 0.15s ease;
    }

    .rassef-usermenu-link {
        color: #e67e22;
        background: #fff5ec;
    }

        .rassef-usermenu-link:hover {
            background: #ffe8d3;
            color: #d35400;
        }

    .rassef-usermenu-logout {
        margin-top: auto;
        color: #b3261e;
        background: #fdecea;
    }

        .rassef-usermenu-logout:hover {
            background: #f8d7d5;
            color: #b3261e;
        }
</style>

<button type="button" id="rassef-usermenu-toggle" class="rassef-usermenu-toggle" aria-label="القائمة" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
    </svg>
</button>

<div id="rassef-usermenu-backdrop" class="rassef-usermenu-backdrop"></div>

<aside id="rassef-usermenu-panel" class="rassef-usermenu-panel" aria-hidden="true">
    <button type="button" id="rassef-usermenu-close" class="rassef-usermenu-close" aria-label="إغلاق">×</button>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rassef-usermenu-alert">@TempData["ErrorMessage"]</div>
    }

    <div class="rassef-usermenu-greeting">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
        <span>اهلا, @Model.CurrentUserName</span>
    </div>

    @if (Model.Warehouses.Any())
    {
        <form method="post" asp-controller="Authentication" asp-action="SelectWarehouse" class="rassef-usermenu-warehouse-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <label for="rassef-usermenu-warehouse-select">المخزن الحالي</label>
            <select id="rassef-usermenu-warehouse-select" name="warehouseId" onchange="this.form.submit()">
                @if (Model.SelectedWarehouseId == null)
                {
                    <option value="" disabled selected>اختر المخزن</option>
                }
                else
                {
                    <option value="" disabled>اختر المخزن</option>
                }
                @foreach (var wh in Model.Warehouses)
                {
                    if (Model.SelectedWarehouseId == wh.Id)
                    {
                        <option value="@wh.Id" selected>@wh.Name</option>
                    }
                    else
                    {
                        <option value="@wh.Id">@wh.Name</option>
                    }
                }
            </select>
        </form>
    }
    else
    {
        <div class="rassef-usermenu-no-warehouse">لا توجد مخازن متاحة</div>
    }

    @if (Model.IsAdmin)
    {
        <a href="@Url.Action("Index", "Administration")" class="rassef-usermenu-link">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>لوحة التحكم</span>
        </a>
    }

    <a href="@Url.Action("Logout", "Authentication")" class="rassef-usermenu-logout">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" style="transform: rotate(180deg);" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z" />
            <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z" />
        </svg>
        <span>تسجيل الخروج</span>
    </a>
</aside>

<script>
    (function () {
        var toggleBtn = document.getElementById('rassef-usermenu-toggle');
        var closeBtn = document.getElementById('rassef-usermenu-close');
        var panel = document.getElementById('rassef-usermenu-panel');
        var backdrop = document.getElementById('rassef-usermenu-backdrop');
        if (!toggleBtn || !panel || !backdrop) return;

        function openMenu() {
            panel.classList.add('rassef-open');
            backdrop.classList.add('rassef-open');
            panel.setAttribute('aria-hidden', 'false');
            toggleBtn.setAttribute('aria-expanded', 'true');
        }
        function closeMenu() {
            panel.classList.remove('rassef-open');
            backdrop.classList.remove('rassef-open');
            panel.setAttribute('aria-hidden', 'true');
            toggleBtn.setAttribute('aria-expanded', 'false');
        }

        toggleBtn.addEventListener('click', openMenu);
        if (closeBtn) closeBtn.addEventListener('click', closeMenu);
        backdrop.addEventListener('click', closeMenu);
    })();
</script>
