@model Rassef.ViewModels.Supplier.UpdateSupplierVM

@{
    ViewData["Title"] = "تعديل مورد";
    Layout = "_SupOrTra";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
<link rel="stylesheet" href="~/css/addSupplier.css" asp-append-version="true">

<div class="bg"></div>

<div class="container main-container">

    <header class="page-header d-flex justify-content-between align-items-center">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-logo" onerror="this.src='https://via.placeholder.com/100x60?text=Fathalla'">
        </div>

        <div class="title-wrapper text-center">
            <h1 class="main-title">تعديل مورد</h1>
        </div>

        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="brand-logo logo-raseefy" onerror="this.src='https://via.placeholder.com/120x50?text=Raseefy'">
        </div>
    </header>

    <div class="nav-actions">
        <a href="javascript:history.back()" class="go-suppliers-btn">
            خطوة للخلف &rarr;
        </a>
    </div>

    <main class="content-wrapper">
        <form asp-action="Edit" asp-controller="Supplier" method="post" enctype="multipart/form-data" class="supplier-form-container">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingLogoURL" />

            <div class="supplier-card-main p-4">
                <div class="row align-items-center g-4">

                    <!-- الحقول (يمين) -->
                    <div class="col-lg-8 order-lg-1 order-2">

                        <!-- اسم المورد -->
                        <div class="mb-3 text-end">
                            <label asp-for="Name" class="form-label-custom fw-bold mb-1">اسم المورد</label>
                            <input asp-for="Name" class="form-control form-control-custom text-end" placeholder="جهينة" autocomplete="off" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- رقم المورد -->
                        <div class="mb-3 text-end">
                            <label asp-for="Phone" class="form-label-custom fw-bold mb-1">رقم المورد</label>
                            <input asp-for="Phone" class="form-control form-control-custom text-end" placeholder="01002677889" autocomplete="off" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <!-- كود المورد -->
                        <div class="mb-3 text-end">
                            <label asp-for="SupCode" class="form-label-custom fw-bold mb-1">كود المورد</label>
                            <input asp-for="SupCode" class="form-control form-control-custom text-end" placeholder="j0324116" autocomplete="off" />
                            <span asp-validation-for="SupCode" class="text-danger small"></span>
                        </div>

                    </div>

                    <!-- شعار المورد (يسار) -->
                    <div class="col-lg-4 order-lg-2 order-1 text-center">
                        <div class="logo-upload-container d-flex flex-column align-items-center justify-content-center">
                            <label for="LogoFile" style="cursor: pointer;">
                                <div class="logo-circle-wrapper mb-2" style="width: 140px; height: 140px; border-radius: 50%; border: 2px solid #f37021; padding: 5px; display: flex; align-items: center; justify-content: center; background-color: #fff;">
                                    <img id="logoPreview" src="@(string.IsNullOrEmpty(Model.ExistingLogoURL) ? "https://via.placeholder.com/130?text=Logo" : Model.ExistingLogoURL)"
                                         alt="شعار المورد" style="width: 100%; height: 100%; border-radius: 50%; object-fit: contain;" />
                                </div>
                            </label>
                            <span class="fw-bold mt-2" style="color: #333;">شعار المورد</span>
                            <input type="file" asp-for="LogoFile" id="LogoFile" accept="image/*" class="d-none" onchange="previewImage(this)" />
                            <span asp-validation-for="LogoFile" class="text-danger small d-block"></span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- زر التعديل -->
            <div class="mt-4">
                <button type="submit" class="btn-submit-full w-100 py-3 style-btn-orange">
                    تعديل المورد
                </button>
            </div>

        </form>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('logoPreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}