@{
    ViewData["Title"] = "موردين";
    Layout = "_SupOrTra";
}
@model IEnumerable<Rassef.ViewModels.Supplier.SupplierListVM>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<!-- استدعاء ملف الـ CSS الخاص بالصفحة -->
<link rel="stylesheet" href="~/css/suppliers.css" asp-append-version="true">

<div class="bg"></div>

<div class="container main-container">

    <header class="page-header d-flex justify-content-between align-items-center">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-logo" onerror="this.src='https://via.placeholder.com/100x60?text=Fathalla'">
        </div>

        <div class="title-wrapper text-center">
            <h1 class="main-title">موردين</h1>
        </div>

        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="brand-logo logo-raseefy" onerror="this.src='https://via.placeholder.com/120x50?text=Raseefy'">
        </div>
    </header>

    <div class="nav-actions">
        <div class="d-flex justify-content-between" style="width: 100%;">
            <!-- ربط زر إضافة جديد -->
            <a href="@Url.Action("Create", "Supplier")" class="go-suppliers-btn" aria-label="إضافة مورد جديد">
                <i class="bi bi-plus-lg"></i>
                إضافة جديد
            </a>
            <!-- ربط زر الذهاب خطوة إلى الخلف -->
            <a href="@Url.Action("SupOrTra", "Authentication")" class="go-suppliers-btn" aria-label="الذهاب خطوة إلى الخلف">
                الذهاب خطوة إلى الخلف
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
    </div>

    <main class="content-wrapper">

        <section class="search-section" aria-label="البحث عن مورد">
            <div class="search-wrapper">
                <button class="search-btn" aria-label="بحث">
                    <i class="bi bi-search"></i>
                </button>
                <input type="text" id="searchInput" class="search-input" placeholder="ادخل اسم المورد" autocomplete="off">
            </div>
        </section>

        <section class="supplier-list-section" aria-label="قائمة الموردين">
            <div id="supplierList" class="supplier-list">
                <!-- سيتم حقن البطاقات هنا بواسطة JavaScript -->
            </div>
        </section>

    </main>
</div>

