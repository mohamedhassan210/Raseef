@model Rassef.ViewModels.Position.PositionViewModel
@{
    ViewData["Title"] = "حذف دور وظيفي";
    Layout = "_SupOrTra";
}

@section Styles {
    <link rel="stylesheet" href="~/css/addEmployee.css" asp-append-version="true">
}

<main class="page-container">
    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">حذف دور وظيفي</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="logo-raseefy">
        </div>
    </header>

    <section class="form-card mt-3">
        <p style="font-size:16px; font-weight:700; margin-bottom: 20px;">
            هل أنت متأكد من حذف الدور الوظيفي "@Model.PositionName"؟
            @if (Model.UsersCount > 0)
            {
                <span style="color:#dc3545;">يوجد @Model.UsersCount موظف مرتبط بهذا الدور حالياً.</span>
            }
        </p>
        <form method="post" action="@Url.Action("Delete", "Position")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div style="display:flex; gap:12px;">
                <button type="submit" class="submit-btn" style="background:#dc3545;">تأكيد الحذف</button>
                <a href="@Url.Action("Index", "Position")" class="action-btn">إلغاء</a>
            </div>
        </form>
    </section>
</main>
