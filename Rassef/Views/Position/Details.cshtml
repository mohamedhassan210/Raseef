@model Rassef.ViewModels.Position.PositionDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل الدور الوظيفي";
    Layout = "_SupOrTra";
    ViewData["ActiveSidebar"] = "Position";
}

@section Styles {
    <link rel="stylesheet" href="~/css/addEmployee.css" asp-append-version="true">
}

<main class="page-container">
    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">تفاصيل الدور الوظيفي</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="logo-raseefy">
        </div>
    </header>

    <div class="nav-actions-container" style="justify-content: flex-end;">
        <a href="@Url.Action("Index", "Position")" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="form-card mt-3">

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger text-end mb-4">
                <ul class="mb-0" style="list-style-type: none; padding-right: 0;">
                    @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@modelError.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        @if (Model != null && Model.Id > 0)
        {
            <div class="row mb-4 gy-4">

                <div class="col-md-6">
                    <label class="form-label fw-bold">اسم الدور الوظيفي</label>
                    <input type="text" class="form-control custom-input" value="@Model.PositionName" readonly>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">كود الدور الوظيفي</label>
                    <input type="text" class="form-control custom-input" value="@Model.PositionCode" readonly>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">المستخدمون</label>
                    @if (Model.Users != null && Model.Users.Any())
                    {
                        <ul class="list-group">
                            @foreach (var user in Model.Users)
                            {
                                <li class="list-group-item">@user</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <input type="text" class="form-control custom-input" value="لا يوجد مستخدمون مرتبطون بهذا الدور" readonly>
                    }
                </div>

            </div>

            <div class="d-flex gap-3 mt-3">
                <a href="@Url.Action("Edit", "Position", new { id = Model.Id })" class="w-100 submit-btn mt-2" style="text-decoration:none; text-align:center;">
                    تعديل
                </a>
            </div>
        }

    </section>
</main>
