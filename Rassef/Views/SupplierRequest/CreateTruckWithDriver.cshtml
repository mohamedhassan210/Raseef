@{
    ViewData["Title"] = "إضافة شاحنة";
    Layout = "_SupOrTra";
}

<!-- ملفات الـ CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/addCar.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/companyCars.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/companyDrivers.css" asp-append-version="true">

<main class="page-container">
    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">إضافة شاحنة</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="logo-raseefy" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
        </div>
    </header>

    <div class="nav-actions-container" style="justify-content: flex-end;">
        <a href="@Url.Action("Index", "Truck")" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="form-card mt-3">
        <form id="addCarForm" class="needs-validation" novalidate>
            <div class="row mb-4 gy-4">
                <div class="col-md-6 order-md-1">
                    <label class="form-label fw-bold">رقم الشاحنة</label>
                    <div class="d-flex gap-3 responsive-gap">
                        <div class="position-relative flex-grow-1">
                            <input type="text" class="form-control custom-input" id="plateNumbers" placeholder="ادخل الأرقام" pattern="^[0-9]+$" required>
                            <div class="invalid-feedback text-center mt-2">يرجى إدخال أرقام فقط.</div>
                        </div>
                        <div class="position-relative flex-grow-1">
                            <input type="text" class="form-control custom-input" id="plateLetters" placeholder="ادخل الحروف" pattern="^[\u0600-\u06FF\s]+$" required>
                            <div class="invalid-feedback text-center mt-2">يرجى إدخال حروف عربية.</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 order-md-2">
                    <label class="form-label fw-bold">سعة التخزين</label>
                    <div class="input-group has-validation">
                        <input type="number" class="form-control custom-input input-kg" id="storageCapacity" placeholder="ادخل سعة التخزين" min="1" required>
                        <span class="input-group-text fw-bold">kg</span>
                        <div class="invalid-feedback mt-2">يجب أن تكون سعة التخزين رقماً أكبر من صفر.</div>
                    </div>
                </div>

                <div class="col-md-6 order-md-3">
                    <label class="form-label fw-bold d-block">نوع الشاحنة</label>
                    <div class="d-flex mt-3 custom-radio-group justify-content-start gap-4">
                        <div class="form-check custom-radio-wrapper">
                            <label class="form-check-label" for="typeNormal">غير تبريد</label>
                            <input class="form-check-input custom-radio" type="radio" name="truckType" id="typeNormal" value="غير تبريد" required>
                        </div>
                        <div class="form-check custom-radio-wrapper">
                            <label class="form-check-label" for="typeCooling">تبريد</label>
                            <input class="form-check-input custom-radio" type="radio" name="truckType" id="typeCooling" value="تبريد" checked required>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 order-md-4">
                    <label class="form-label fw-bold">شركة الشاحنة</label>
                    <div class="position-relative d-none w-100" id="companySelectView">
                        <select class="d-none" id="companySelect" required disabled>
                            <option value="" disabled selected>ادخل القسم</option>
                            <option value="جهينة">جهينة</option>
                            <option value="حلواني إخوان">حلواني إخوان</option>
                            <option value="أكوافينا">أكوافينا</option>
                            <option value="المكتبة الرقمية">المكتبة الرقمية</option>
                        </select>
                        <div class="custom-dropdown" id="customDropdown">
                            <div class="dropdown-header">
                                <span class="selected-value placeholder-color">ادخل الشركة</span>
                                <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="18 15 12 9 6 15"></polyline>
                                </svg>
                            </div>
                            <div class="dropdown-list">
                                <div class="dropdown-item" data-value="جهينة">جهينة</div>
                                <div class="dropdown-item" data-value="نودلز">نودلز</div>
                                <div class="dropdown-item" data-value="دومتي">دومتي</div>
                                <div class="dropdown-item" data-value="المراعي">المراعي</div>
                            </div>
                        </div>
                        <div class="invalid-feedback mt-2">يرجى اختيار شركة الشاحنة.</div>
                    </div>
                    <div class="position-relative static-view-container" id="companyStaticView">
                        <input type="text" class="form-control custom-input text-end static-input" id="companyDisplay" value="جهينة" readonly>
                        <button type="button" class="edit-icon-btn" id="editCompanyBtn" aria-label="تعديل الشركة">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="col-md-6 order-md-5">
                    <label class="form-label fw-bold">سائق الشاحنة</label>
                    <div class="d-flex gap-3 align-items-stretch">

                        <!-- القائمة المنسدلة المخصصة -->
                        <div class="position-relative flex-grow-1" id="driverSelectView">
                            <select class="d-none" id="driverSelect" required>
                                <option value="" disabled selected>اختر السائق</option>
                                <option value="محمد أحمد">محمد أحمد</option>
                                <option value="محمود علي">محمود علي</option>
                                <option value="عبدالله حسن">عبدالله حسن</option>
                                <option value="أحمد سمير">أحمد سمير</option>
                                <option value="يوسف خالد">يوسف خالد</option>
                            </select>

                            <div class="custom-dropdown" id="customDriverDropdown">
                                <div class="dropdown-header">
                                    <span class="selected-value placeholder-color">اختر السائق</span>
                                    <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="18 15 12 9 6 15"></polyline>
                                    </svg>
                                </div>
                                <div class="dropdown-list">
                                    <div class="dropdown-item" data-value="محمد أحمد">محمد أحمد</div>
                                    <div class="dropdown-item" data-value="محمود علي">محمود علي</div>
                                    <div class="dropdown-item" data-value="عبدالله حسن">عبدالله حسن</div>
                                    <div class="dropdown-item" data-value="أحمد سمير">أحمد سمير</div>
                                    <div class="dropdown-item" data-value="يوسف خالد">يوسف خالد</div>
                                </div>
                            </div>
                            <div class="invalid-feedback mt-2">يرجى اختيار سائق الشاحنة.</div>
                        </div>

                        <!-- تعديل رابط زر إضافة سائق ليستخدم MVC Routing -->
                        <a href="@Url.Action("Create", "Driver")" class="add-driver-btn" aria-label="إضافة سائق جديد">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </a>

                    </div>
                </div>
            </div>
            <button type="submit" class="w-100 submit-btn mt-4" id="submit-btn">إضافة شاحنة جديدة</button>
        </form>
    </section>
</main>

<!-- ================= Multi-Step Modal System ================= -->
<div id="custom-modal-overlay" class="custom-modal-overlay" aria-hidden="true">

    <!-- Modal 0: Department Selection -->
    <div id="department-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="department-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <rect x="9" y="3" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="3" y="17" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="15" y="17" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <path d="M12 7v5M6 17v-3h12v3M18 14v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
        </div>
        <div class="modal-body text-center w-100 mt-4">
            <h2 id="department-modal-title" class="modal-title" style="margin-bottom: 24px;">اختار القسم</h2>
            <div class="custom-dropdown" id="dept-dropdown-container">
                <div class="dropdown-header" id="dept-dropdown-header">
                    <span class="selected-value text-muted" id="dept-selected-value">اختار القسم</span>
                    <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#EB842D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
                <div class="dropdown-list" id="dept-dropdown-list"></div>
                <div class="invalid-feedback text-right mt-2" id="dept-error-msg" style="display: none; color: #dc3545; font-size: 0.95rem; font-weight: 500;">
                    يرجى اختيار القسم للمتابعة.
                </div>
            </div>
        </div>
        <div class="modal-actions mt-4" style="margin-top: 32px !important;">
            <button id="btn-confirm-dept" class="btn-primary-custom w-100" aria-label="تأكيد القسم">تأكيد</button>
        </div>
    </div>

    <!-- Modal 1: Data Confirmation -->
    <div id="confirmation-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-question-lg" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M4.475 5.458c-.284 0-.514-.237-.47-.517C4.28 3.24 5.576 2 7.825 2c2.25 0 3.767 1.36 3.767 3.215 0 1.344-.665 2.288-1.79 2.973-1.1.659-1.414 1.118-1.414 2.01v.03a.5.5 0 0 1-.5.5h-.77a.5.5 0 0 1-.5-.495l-.003-.2c-.043-1.221.477-2.001 1.645-2.712 1.03-.632 1.397-1.135 1.397-2.028 0-.979-.758-1.698-1.926-1.698-1.009 0-1.71.529-1.938 1.402-.066.254-.278.461-.54.461h-.777ZM7.496 14c.622 0 1.095-.474 1.095-1.09 0-.618-.473-1.092-1.095-1.092-.606 0-1.087.474-1.087 1.091S6.89 14 7.496 14" />
                </svg>
            </div>
        </div>
        <div class="modal-body data-grid mt-4 firstModelcontent">
            <div class="data-row">
                <span class="data-label">الشركة :</span>
                <span class="data-value" id="confirm-company"></span>
            </div>
            <div class="data-row">
                <span class="data-label">السيارة :</span>
                <span class="data-value" id="confirm-truck"></span>
            </div>
            <div class="data-row">
                <span class="data-label">السائق :</span>
                <span class="data-value" id="confirm-driver-name"></span>
            </div>
            <div class="data-row">
                <span class="data-label">القسم :</span>
                <span class="data-value" id="confirm-driver-dep"></span>
            </div>
        </div>
        <div class="modal-actions">
            <button id="btn-edit" class="btn-secondary-custom" aria-label="تعديل البيانات">تعديل</button>
            <button id="btn-confirm" class="btn-primary-custom" aria-label="تأكيد البيانات">تأكيد</button>
        </div>
    </div>

    <!-- Modal 2: Success & Ticket -->
    <div id="success-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="success-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle green-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
        </div>
        <div class="modal-body text-center w-100 mt-4">
            <h2 id="success-modal-title" class="modal-title success-text">تم تأكيد البيانات بنجاح</h2>
            <div class="ticket-box">
                <span id="ticket-number" class="ticket-number-text"></span>
            </div>
        </div>
        <div class="modal-actions">
            <button id="btn-back" class="btn-secondary-custom" aria-label="الرجوع">الرجوع</button>
            <button id="btn-print" class="btn-primary-custom" aria-label="طباعة البون">طباعة</button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // إعداد البيانات اللي هنحتاجها في الـ JS
    window.pageData = {
        dockName: 'A',
        employeeName: 'محمد حسين'
    };

    window.routes = {
        truckIndex: '@Url.Action("Index", "Truck")',
        receiptPage: '@Url.Action("Recript", "Driver")' // المسار لصفحة الطباعة
    };
</script>

<script src="~/js/addCar.js" asp-append-version="true"></script>