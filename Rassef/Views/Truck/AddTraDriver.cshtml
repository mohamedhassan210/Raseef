@model Rassef.ViewModels.Truck.AddTraTruckVM
@{
    ViewData["Title"] = "إضافة شاحنة";
    Layout = "_SupOrTra";
    ViewData["ActiveSidebar"] = "Trucks";
    var selectedSupplier = Model?.Suppliers?.FirstOrDefault(s => s.Value == Model?.SupplierId?.ToString());
    var displaySupplierName = !string.IsNullOrWhiteSpace(Model?.SupplierName)
        ? Model.SupplierName
        : (selectedSupplier != null ? selectedSupplier.Text : (Model?.Suppliers?.FirstOrDefault()?.Text ?? "تحويلات الفروع"));
    var hasPredefinedSupplier = (Model?.SupplierId != null && Model.SupplierId > 0) || !string.IsNullOrWhiteSpace(Model?.SupplierName);
}

<!-- ملفات الـ CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/addCar.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/companyCars.css" asp-append-version="true">
@* FIX — this was missing. All the modal-popup CSS (.custom-modal-overlay,
   .custom-modal-container, .active-modal, etc.) lives in companyDrivers.css, not
   addCar.css. Without it the modals had no positioning/overlay/animation styles at
   all, so they rendered as plain unstyled blocks stacked at the top of the page
   instead of a centered popup — exactly what the screenshots showed. The supplier
   page (CreateTruckWithDriver.cshtml) already loads all three together; this makes
   AddTraDriver match it. *@
<link rel="stylesheet" href="~/css/companyDrivers.css" asp-append-version="true">

<main class="page-container">

    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">إضافة شاحنة</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="logo-raseefy" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
        </div>
    </header>

    <div class="nav-actions-container" style="justify-content: flex-end;">
        <!-- تعديل رابط العودة للوراء ليستخدم MVC Routing -->
        <a href="@Url.Action("MainTraDrivers", "Truck")" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="form-card mt-3">
        @* CHANGED — this tag was missing `method="post"` and any `asp-action`/`asp-controller`,
           so submitting the form did a plain GET to the current URL instead of posting to
           AddTraDriver. That's why nothing ever seemed to happen on submit. *@
        <form asp-action="AddTraDriver" asp-controller="Truck" method="post" id="addCarForm" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="SupplierName" value="@displaySupplierName" />

            <div class="row mb-4 gy-4">

                <div class="col-md-6 order-md-1">
                    <label class="form-label fw-bold">رقم الشاحنة</label>
                    <div class="d-flex gap-3 responsive-gap">
                        <div class="position-relative flex-grow-1">
                            <input type="text" name="PlateNumber" class="form-control custom-input" id="plateNumbers" placeholder="ادخل الأرقام" pattern="^[0-9\s]+$" required>
                            <div class="invalid-feedback text-center mt-2">يرجى إدخال أرقام فقط.</div>
                        </div>
                        <div class="position-relative flex-grow-1">
                            <input type="text" name="PlateLetter" class="form-control custom-input" id="plateLetters" placeholder="ادخل الحروف" pattern="^[\u0600-\u06FF\s]+$" required>
                            <div class="invalid-feedback text-center mt-2">يرجى إدخال حروف عربية.</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 order-md-2">
                    <label class="form-label fw-bold">سعة التخزين</label>
                    <div class="input-group has-validation">
                        <input type="number" name="StorageCapacity" class="form-control custom-input input-kg" id="storageCapacity" placeholder="ادخل سعة التخزين" min="1" required>
                        <span class="input-group-text fw-bold">kg</span>
                        <div class="invalid-feedback mt-2">يجب أن تكون سعة التخزين رقماً أكبر من صفر.</div>
                    </div>
                </div>

                <div class="col-md-6 order-md-3">
                    <label class="form-label fw-bold d-block">نوع الشاحنة</label>
                    <div class="d-flex mt-3 custom-radio-group justify-content-start gap-4">
                        <div class="form-check custom-radio-wrapper">
                            <label class="form-check-label" for="typeNormal">غير تبريد</label>
                            <input class="form-check-input custom-radio" type="radio" name="truckType" id="typeNormal" value="غير تبريد" required>
                        </div>
                        <div class="form-check custom-radio-wrapper">
                            <label class="form-check-label" for="typeCooling">تبريد</label>
                            <input class="form-check-input custom-radio" type="radio" name="truckType" id="typeCooling" value="تبريد" checked required>
                        </div>
                    </div>
                </div>

              @*   <div class="col-md-6 order-md-4">
                    <label class="form-label fw-bold">شركة الشاحنة</label>

                    <!-- Custom Select View -->
                    <div class="position-relative @(hasPredefinedSupplier ? "d-none" : "") w-100" id="companySelectView">

                        <!-- Hidden Native Select -->
                        <select class="d-none" id="companySelect" name="SupplierId">
                            <option value="" disabled selected>اختر الشركة</option>
                            @if (Model?.Suppliers != null)
                            {
                                foreach (var supplier in Model.Suppliers)
                                {
                                    <option value="@supplier.Value">@supplier.Text</option>
                                }
                            }
                        </select>

                        <!-- Custom UI Dropdown -->
                        <div class="custom-dropdown" id="customDropdown">
                            <div class="dropdown-header">
                                <span class="selected-value @(hasPredefinedSupplier ? "" : "placeholder-color")">@displaySupplierName</span>
                                <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="18 15 12 9 6 15"></polyline>
                                </svg>
                            </div>
                            <div class="dropdown-list">
                                @if (Model?.Suppliers != null && Model.Suppliers.Any())
                                {
                                    foreach (var supplier in Model.Suppliers)
                                    {
                                        <div class="dropdown-item @(supplier.Value == Model?.SupplierId?.ToString() ? "selected" : "")" data-value="@supplier.Value">@supplier.Text</div>
                                    }
                                }
                                else
                                {
                                    <div class="dropdown-item disabled text-muted">لا توجد شركات متاحة</div>
                                }
                            </div>
                        </div>
                        <div class="invalid-feedback mt-2">يرجى اختيار شركة الشاحنة.</div>
                    </div>
 *@
                    <!-- Static View -->
                    <div class="position-relative static-view-container @(hasPredefinedSupplier ? "" : "d-none")" id="companyStaticView">
                        <input type="text" class="form-control custom-input text-end static-input" id="companyDisplay" value="@displaySupplierName" readonly>
                        @if (hasPredefinedSupplier)
                        {
                            <input type="hidden" name="SupplierId" id="hiddenSupplierId" value="@Model?.SupplierId" />
                        }
                    </div>
                </div>

                <div class="col-md-6 order-md-5">
                    <label class="form-label fw-bold">سائق الشاحنة</label>
                    <div class="d-flex gap-3 align-items-stretch">

                        <!-- القائمة المنسدلة المخصصة -->
                        <div class="position-relative flex-grow-1" id="driverSelectView">
                            <select class="d-none" id="driverSelect" name="DriverId">
                                <option value="" disabled selected>اختر السائق</option>
                                @if (Model?.Drivers != null)
                                {
                                    foreach (var driver in Model.Drivers)
                                    {
                                        <option value="@driver.Value">@driver.Text</option>
                                    }
                                }
                            </select>

                            <div class="custom-dropdown" id="customDriverDropdown">
                                <div class="dropdown-header">
                                    <span class="selected-value placeholder-color">اختر السائق</span>
                                    <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="18 15 12 9 6 15"></polyline>
                                    </svg>
                                </div>
                                <div class="dropdown-list">
                                    @* CHANGED — added the search box and the #driverDropdownItems
                                       wrapper. addCar.js's search logic (section 4b) looks for these
                                       exact ids; without them it silently does nothing — no search box
                                       showed, and the plain items here were never wired for clicks
                                       (the generic dropdown loop explicitly skips #customDriverDropdown,
                                       expecting section 4b to own it). *@
                                    <div class="dropdown-search-wrapper px-2 pt-2">
                                        <input type="text"
                                               id="driverSearchInput"
                                               class="form-control custom-input"
                                               placeholder="ابحث بالاسم أو رقم الهاتف أو الرقم القومي"
                                               autocomplete="off">
                                    </div>
                                    <div id="driverDropdownItems">
                                        @if (Model?.Drivers != null && Model.Drivers.Any())
                                        {
                                            foreach (var driver in Model.Drivers)
                                            {
                                                <div class="dropdown-item" data-value="@driver.Value">@driver.Text</div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="dropdown-item disabled text-muted">لا يوجد سائقين متاحين حالياً</div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="invalid-feedback mt-2" style="display: none;">يرجى اختيار سائق الشاحنة.</div>
                        </div>

                        <!-- فتح مودال إضافة سائق السريع -->
                        <button type="button" class="add-driver-btn" id="btn-open-inline-driver-modal" aria-label="إضافة سائق جديد">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>

                    </div>
                </div>

            </div>

            <button type="submit" class="w-100 submit-btn mt-4" id="submit-btn">إضافة شاحنة جديدة</button>
        </form>
    </section>

</main>

@* CHANGED — this whole modal system was missing from the page. addCar.js expects
   #custom-modal-overlay, #add-driver-modal, #department-modal (with #dept-dropdown-list
   and #dock-dropdown-list) and #confirmation-modal to exist; without them the "+" button
   (opens #add-driver-modal), the department/dock step and the confirmation step all
   silently do nothing, because every handler in addCar.js guards on "if the element
   exists". Copied from the supplier flow's CreateTruckWithDriver.cshtml, with the
   department list left empty and built client-side from window.departmentsData instead
   (this controller passes it as plain {id,name} objects, not SelectListItem — same
   approach already used by Driver/TransferDrivers.cshtml elsewhere in this flow). *@
<div id="custom-modal-overlay" class="custom-modal-overlay" aria-hidden="true">

    <!-- Modal -1: Add New Driver Inline -->
    <div id="add-driver-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="add-driver-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                </svg>
            </div>
        </div>

        <div class="modal-body text-end w-100 mt-3">
            <h2 id="add-driver-modal-title" class="modal-title text-center" style="margin-bottom: 20px;">إضافة سائق جديد</h2>

            <div class="mb-3">
                <label class="form-label fw-bold">اسم السائق بالكامل</label>
                <input type="text" class="form-control custom-input" id="inlineDriverFullName" placeholder="ادخل اسم السائق">
                <div class="invalid-feedback text-end mt-1" id="inlineDriverNameErr" style="display:none; color:#dc3545;">يرجى إدخال اسم السائق.</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">الرقم القومي (14 رقم)</label>
                <input type="text" class="form-control custom-input" id="inlineDriverNationalId" placeholder="ادخل الرقم القومي (14 رقم)" maxlength="14" dir="rtl">
                <div class="invalid-feedback text-end mt-1" id="inlineDriverNationalIdErr" style="display:none; color:#dc3545;">الرقم القومي يجب أن يتكون من 14 رقماً.</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">رقم الهاتف</label>
                <input type="tel" class="form-control custom-input" id="inlineDriverPhone" placeholder="ادخل رقم الهاتف (11 رقم مصري)" maxlength="11" dir="rtl">
                <div class="invalid-feedback text-end mt-1" id="inlineDriverPhoneErr" style="display:none; color:#dc3545;">يرجى إدخال رقم هاتف مصري صحيح (11 رقماً يبدأ بـ 010 أو 011 أو 012 أو 015).</div>
            </div>
        </div>

        <div class="modal-actions mt-3">
            <button id="btn-cancel-add-driver" class="btn-secondary-custom" type="button">إلغاء</button>
            <button id="btn-save-inline-driver" class="btn-primary-custom" type="button">التالي (اختيار القسم)</button>
        </div>
    </div>

    <!-- Modal 0: Department Selection -->
    <div id="department-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="department-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <rect x="9" y="3" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="3" y="17" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="15" y="17" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <path d="M12 7v5M6 17v-3h12v3M18 14v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
        </div>

        <div class="modal-body text-center w-100 mt-4">
            <h2 id="department-modal-title" class="modal-title" style="margin-bottom: 24px;">اختر القسم</h2>

            <div class="custom-dropdown" id="dept-dropdown-container">
                <div class="dropdown-header" id="dept-dropdown-header">
                    <span class="selected-value text-muted" id="dept-selected-value">اختر القسم</span>
                    <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#EB842D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>

                <div class="dropdown-list" id="dept-dropdown-list"></div>

                <div class="invalid-feedback text-right mt-2" id="dept-error-msg" style="display: none; color: #dc3545; font-size: 0.95rem; font-weight: 500;">
                    يرجى اختيار القسم للمتابعة.
                </div>
            </div>

            <!-- الرصيف (اختياري) — بيتفلتر تلقائياً حسب القسم المختار فوق -->
            <div class="custom-dropdown mt-3" id="dock-dropdown-container">
                <div class="dropdown-header" id="dock-dropdown-header">
                    <span class="selected-value text-muted" id="dock-selected-value">اختر القسم أولاً</span>
                    <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#EB842D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
                <div class="dropdown-list" id="dock-dropdown-list"></div>
            </div>

            @* NEW — التصريح والأفيز بقوا بيانات بيدخلها المستخدم بدل ما يتولّدوا تلقائي،
               ونوع الإذن بقى اختيار من قائمة حقيقية، مطابق لحقول TransferRequest. *@
            <div class="mt-3 text-end">
                <label class="form-label fw-bold">رقم الأفيز</label>
                <input type="text" class="form-control custom-input" id="modalAvizNumber" placeholder="ادخل رقم الأفيز">
                <div class="invalid-feedback text-end mt-1" id="aviz-error-msg" style="display:none; color:#dc3545;">يرجى إدخال رقم الأفيز.</div>
            </div>

            <div class="mt-3 text-end">
                <label class="form-label fw-bold">رقم التصريح</label>
                <input type="text" class="form-control custom-input" id="modalPermitNumber" placeholder="ادخل رقم التصريح">
                <div class="invalid-feedback text-end mt-1" id="permit-number-error-msg" style="display:none; color:#dc3545;">يرجى إدخال رقم التصريح.</div>
            </div>

            <div class="custom-dropdown mt-3" id="permit-type-dropdown-container">
                <div class="dropdown-header" id="permit-type-dropdown-header">
                    <span class="selected-value text-muted" id="permit-type-selected-value">اختر نوع الإذن</span>
                    <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#EB842D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
                <div class="dropdown-list" id="permit-type-dropdown-list">
                    @if (Model?.PermitTypes != null && Model.PermitTypes.Any())
                    {
                        foreach (var permitType in Model.PermitTypes)
                        {
                            <div class="dropdown-item" data-id="@permitType.Value" data-value="@permitType.Value">@permitType.Text</div>
                        }
                    }
                    else
                    {
                        <div class="dropdown-item disabled text-muted">لا توجد أنواع أذونات متاحة</div>
                    }
                </div>
                <div class="invalid-feedback text-right mt-2" id="permit-type-error-msg" style="display: none; color: #dc3545; font-size: 0.95rem; font-weight: 500;">
                    يرجى اختيار نوع الإذن.
                </div>
            </div>

        </div>

        <div class="modal-actions mt-4" style="margin-top: 32px !important;">
            <button id="btn-confirm-dept" class="btn-primary-custom w-100" type="button" aria-label="تأكيد القسم">تأكيد</button>
        </div>
    </div>

    <!-- Modal 1: Data Confirmation -->
    <div id="confirmation-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-question-lg" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M4.475 5.458c-.284 0-.514-.237-.47-.517C4.28 3.24 5.576 2 7.825 2c2.25 0 3.767 1.36 3.767 3.215 0 1.344-.665 2.288-1.79 2.973-1.1.659-1.414 1.118-1.414 2.01v.03a.5.5 0 0 1-.5.5h-.77a.5.5 0 0 1-.5-.495l-.003-.2c-.043-1.221.477-2.001 1.645-2.712 1.03-.632 1.397-1.135 1.397-2.028 0-.979-.758-1.698-1.926-1.698-1.009 0-1.71.529-1.938 1.402-.066.254-.278.461-.54.461h-.777ZM7.496 14c.622 0 1.095-.474 1.095-1.09 0-.618-.473-1.092-1.095-1.092-.606 0-1.087.474-1.087 1.091S6.89 14 7.496 14" />
                </svg>
            </div>
        </div>

        <div class="modal-body data-grid mt-4 firstModelcontent">
            <div class="data-row">
                <span class="data-label">الشركة :</span>
                <span class="data-value" id="confirm-company"></span>
            </div>
            <div class="data-row">
                <span class="data-label">السيارة :</span>
                <span class="data-value" id="confirm-truck"></span>
            </div>
            <div class="data-row">
                <span class="data-label">السائق :</span>
                <span class="data-value" id="confirm-driver-name"></span>
            </div>
            <div class="data-row">
                <span class="data-label">القسم :</span>
                <span class="data-value" id="confirm-driver-dep"></span>
            </div>
            <div class="data-row">
                <span class="data-label">الرصيف :</span>
                <span class="data-value" id="confirm-driver-dock"></span>
            </div>
            <div class="data-row">
                <span class="data-label">رقم الأفيز :</span>
                <span class="data-value" id="confirm-aviz"></span>
            </div>
            <div class="data-row">
                <span class="data-label">رقم التصريح :</span>
                <span class="data-value" id="confirm-permit-number"></span>
            </div>
            <div class="data-row">
                <span class="data-label">نوع الإذن :</span>
                <span class="data-value" id="confirm-permit-type"></span>
            </div>
        </div>

        <div class="modal-actions">
            <button id="btn-edit" class="btn-secondary-custom" type="button" aria-label="تعديل البيانات">تعديل</button>
            <button id="btn-confirm" class="btn-primary-custom" type="button" aria-label="تأكيد البيانات">تأكيد</button>
        </div>
    </div>

</div>

<script>
    window.routes = {
        truckIndex: '@Url.Action("MainTraDrivers", "Truck")',
        searchDriversUrl: '@Url.Action("SearchDrivers", "Truck")'
    };

    // CHANGED — dept list serialized the same safe way Driver/TransferDrivers.cshtml
    // does it (Json.Serialize over the raw ViewBag object), since ViewBag.Departments
    // here holds anonymous {id,name} objects rather than SelectListItem.
    window.departmentsData = @Html.Raw(Json.Serialize(ViewBag.Departments ?? new List<object>()));

    // CHANGED — was missing entirely, so refreshDockOptions() in addCar.js always saw
    // an empty dock list. Model.AllDocks is the strongly-typed DockOptionVM collection
    // (not ViewBag), so this serializes directly — same shape as CreateTruckWithDriver.
    window.allDocks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (Model?.AllDocks ?? Enumerable.Empty<Rassef.ViewModels.Dock.DockOptionVM>()).Select(d => new {
            id = d.Id,
            name = d.DockName,
            departmentId = d.DepartmentId,
            occupancy = d.Occupancy,
            maxTruckCount = d.MaxTruckCount,
            isUnderMaintenance = d.IsUnderMaintenance,
            isSelectable = d.IsSelectable,
            disabledReasonLabel = d.DisabledReasonLabel
        })
    ));
</script>

<script>
    document.addEventListener('input', function(e) {
        if (e.target.id === 'plateLetters' || e.target.id === 'plateNumbers') {
            const isLetters = e.target.id === 'plateLetters';
            const regex = isLetters ? /[^\u0600-\u06FF]/g : /\D/g;

            const input = e.target;
            const originalCursor = input.selectionStart;

            const textBefore = input.value.substring(0, originalCursor);
            const validBefore = textBefore.replace(regex, '').replace(/\s/g, '').length;

            const raw = input.value.replace(regex, '').replace(/\s/g, '');
            const formatted = raw.split('').join(' ');

            input.value = formatted;

            let newCursor = 0;
            let count = 0;
            if (validBefore > 0) {
                for (let i = 0; i < formatted.length; i++) {
                    if (formatted[i] !== ' ') count++;
                    if (count === validBefore) {
                        newCursor = i + 1;
                        break;
                    }
                }
            }
            input.setSelectionRange(newCursor, newCursor);
        }
    });
</script>

