@model Rassef.ViewModels.Truck.AddTraTruckVM
@{
    ViewData["Title"] = "إضافة شاحنة";
    Layout = "_SupOrTra";
    var selectedSupplier = Model?.Suppliers?.FirstOrDefault(s => s.Value == Model?.SupplierId?.ToString());
    var displaySupplierName = !string.IsNullOrWhiteSpace(Model?.SupplierName)
        ? Model.SupplierName
        : (selectedSupplier != null ? selectedSupplier.Text : (Model?.Suppliers?.FirstOrDefault()?.Text ?? "تحويلات الفروع"));
    var hasPredefinedSupplier = (Model?.SupplierId != null && Model.SupplierId > 0) || !string.IsNullOrWhiteSpace(Model?.SupplierName);
}

<!-- ملفات الـ CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/addCar.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/companyCars.css" asp-append-version="true">

<main class="page-container">

    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">إضافة شاحنة</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="logo-raseefy" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
        </div>
    </header>

    <div class="nav-actions-container" style="justify-content: flex-end;">
        <!-- تعديل رابط العودة للوراء ليستخدم MVC Routing -->
        <a href="@Url.Action("MainTraDrivers", "Truck")" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="form-card mt-3">
        <form id="addCarForm" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="SupplierName" value="@displaySupplierName" />

            <div class="row mb-4 gy-4">

                <div class="col-md-6 order-md-1">
                    <label class="form-label fw-bold">رقم الشاحنة</label>
                    <div class="d-flex gap-3 responsive-gap">
                        <div class="position-relative flex-grow-1">
                            <input type="text" name="PlateNumber" class="form-control custom-input" id="plateNumbers" placeholder="ادخل الأرقام" pattern="^[0-9\s]+$" required>
                            <div class="invalid-feedback text-center mt-2">يرجى إدخال أرقام فقط.</div>
                        </div>
                        <div class="position-relative flex-grow-1">
                            <input type="text" name="PlateLetter" class="form-control custom-input" id="plateLetters" placeholder="ادخل الحروف" pattern="^[\u0600-\u06FF\s]+$" required>
                            <div class="invalid-feedback text-center mt-2">يرجى إدخال حروف عربية.</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 order-md-2">
                    <label class="form-label fw-bold">سعة التخزين</label>
                    <div class="input-group has-validation">
                        <input type="number" name="StorageCapacity" class="form-control custom-input input-kg" id="storageCapacity" placeholder="ادخل سعة التخزين" min="1" required>
                        <span class="input-group-text fw-bold">kg</span>
                        <div class="invalid-feedback mt-2">يجب أن تكون سعة التخزين رقماً أكبر من صفر.</div>
                    </div>
                </div>

                <div class="col-md-6 order-md-3">
                    <label class="form-label fw-bold d-block">نوع الشاحنة</label>
                    <div class="d-flex mt-3 custom-radio-group justify-content-start gap-4">
                        <div class="form-check custom-radio-wrapper">
                            <label class="form-check-label" for="typeNormal">غير تبريد</label>
                            <input class="form-check-input custom-radio" type="radio" name="truckType" id="typeNormal" value="غير تبريد" required>
                        </div>
                        <div class="form-check custom-radio-wrapper">
                            <label class="form-check-label" for="typeCooling">تبريد</label>
                            <input class="form-check-input custom-radio" type="radio" name="truckType" id="typeCooling" value="تبريد" checked required>
                        </div>
                    </div>
                </div>

              @*   <div class="col-md-6 order-md-4">
                    <label class="form-label fw-bold">شركة الشاحنة</label>

                    <!-- Custom Select View -->
                    <div class="position-relative @(hasPredefinedSupplier ? "d-none" : "") w-100" id="companySelectView">

                        <!-- Hidden Native Select -->
                        <select class="d-none" id="companySelect" name="SupplierId">
                            <option value="" disabled selected>اختر الشركة</option>
                            @if (Model?.Suppliers != null)
                            {
                                foreach (var supplier in Model.Suppliers)
                                {
                                    <option value="@supplier.Value">@supplier.Text</option>
                                }
                            }
                        </select>

                        <!-- Custom UI Dropdown -->
                        <div class="custom-dropdown" id="customDropdown">
                            <div class="dropdown-header">
                                <span class="selected-value @(hasPredefinedSupplier ? "" : "placeholder-color")">@displaySupplierName</span>
                                <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="18 15 12 9 6 15"></polyline>
                                </svg>
                            </div>
                            <div class="dropdown-list">
                                @if (Model?.Suppliers != null && Model.Suppliers.Any())
                                {
                                    foreach (var supplier in Model.Suppliers)
                                    {
                                        <div class="dropdown-item @(supplier.Value == Model?.SupplierId?.ToString() ? "selected" : "")" data-value="@supplier.Value">@supplier.Text</div>
                                    }
                                }
                                else
                                {
                                    <div class="dropdown-item disabled text-muted">لا توجد شركات متاحة</div>
                                }
                            </div>
                        </div>
                        <div class="invalid-feedback mt-2">يرجى اختيار شركة الشاحنة.</div>
                    </div>
 *@
                    <!-- Static View -->
                    <div class="position-relative static-view-container @(hasPredefinedSupplier ? "" : "d-none")" id="companyStaticView">
                        <input type="text" class="form-control custom-input text-end static-input" id="companyDisplay" value="@displaySupplierName" readonly>
                        @if (hasPredefinedSupplier)
                        {
                            <input type="hidden" name="SupplierId" id="hiddenSupplierId" value="@Model?.SupplierId" />
                        }
                    </div>
                </div>

                <div class="col-md-6 order-md-5">
                    <label class="form-label fw-bold">سائق الشاحنة</label>
                    <div class="d-flex gap-3 align-items-stretch">

                        <!-- القائمة المنسدلة المخصصة -->
                        <div class="position-relative flex-grow-1" id="driverSelectView">
                            <select class="d-none" id="driverSelect" name="DriverId">
                                <option value="" disabled selected>اختر السائق</option>
                                @if (Model?.Drivers != null)
                                {
                                    foreach (var driver in Model.Drivers)
                                    {
                                        <option value="@driver.Value">@driver.Text</option>
                                    }
                                }
                            </select>

                            <div class="custom-dropdown" id="customDriverDropdown">
                                <div class="dropdown-header">
                                    <span class="selected-value placeholder-color">اختر السائق</span>
                                    <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="18 15 12 9 6 15"></polyline>
                                    </svg>
                                </div>
                                <div class="dropdown-list">
                                    @if (Model?.Drivers != null && Model.Drivers.Any())
                                    {
                                        foreach (var driver in Model.Drivers)
                                        {
                                            <div class="dropdown-item" data-value="@driver.Value">@driver.Text</div>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="invalid-feedback mt-2" style="display: none;">يرجى اختيار سائق الشاحنة.</div>
                        </div>

                        <!-- فتح مودال إضافة سائق السريع -->
                        <button type="button" class="add-driver-btn" id="btn-open-inline-driver-modal" aria-label="إضافة سائق جديد">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>

                    </div>
                </div>

            </div>

            <button type="submit" class="w-100 submit-btn mt-4" id="submit-btn">إضافة شاحنة جديدة</button>
        </form>
    </section>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    window.routes = {
        truckIndex: '@Url.Action("MainTraDrivers", "Driver")'
    };
</script>

<script>
    document.addEventListener('input', function(e) {
        if (e.target.id === 'plateLetters' || e.target.id === 'plateNumbers') {
            const isLetters = e.target.id === 'plateLetters';
            const regex = isLetters ? /[^\u0600-\u06FF]/g : /\D/g;

            const input = e.target;
            const originalCursor = input.selectionStart;

            const textBefore = input.value.substring(0, originalCursor);
            const validBefore = textBefore.replace(regex, '').replace(/\s/g, '').length;

            const raw = input.value.replace(regex, '').replace(/\s/g, '');
            const formatted = raw.split('').join(' ');

            input.value = formatted;

            let newCursor = 0;
            let count = 0;
            if (validBefore > 0) {
                for (let i = 0; i < formatted.length; i++) {
                    if (formatted[i] !== ' ') count++;
                    if (count === validBefore) {
                        newCursor = i + 1;
                        break;
                    }
                }
            }
            input.setSelectionRange(newCursor, newCursor);
        }
    });
</script>

<script src="~/js/addCar.js" asp-append-version="true"></script>