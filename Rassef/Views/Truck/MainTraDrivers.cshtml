@{
    ViewData["Title"] = "شاحنات التحويل";
    Layout = "_SupOrTra";
}
<!-- غيرنا الموديل عشان يتناسب مع بيانات السيارات، يرجى تغييره لاسم الموديل الفعلي عندك -->
@model IEnumerable<Rassef.ViewModels.Truck.TruckListVM>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

<link rel="stylesheet" href="~/css/companyDrivers.css" asp-append-version="true" />

<main class="page-container">
    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
        </div>

        <div class="title-wrapper">
            <h1 class="main-title" id="page-title">شاحنات التحويل</h1>
        </div>

        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="brand-logo logo-raseefy" style="height: 80px;" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
        </div>
    </header>

    <div class="nav-actions-container">
        <!-- التوجيه لصفحة إضافة شاحنة -->
        <a asp-controller="Truck" asp-action="AddTraDriver" class="action-btn" aria-label="إضافة جديد">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            إضافة جديد
        </a>

        <a asp-controller="Authentication" asp-action="SupOrTra" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="search-section" aria-label="البحث عن سيارة">
        <div class="search-wrapper">
            <button type="button" class="search-btn" id="search-btn" aria-label="بحث">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
            <input type="text" id="search-input" class="search-input" placeholder="ادخل رقم السيارة" aria-label="ادخل رقم السيارة للبحث" autocomplete="off">
        </div>
    </section>

    <!-- قائمة السيارات -->
    <section class="cards-section" id="cards-container" aria-label="قائمة السيارات">
        @if (Model != null && Model.Any())
        {
            foreach (var truck in Model)
            {
                <article class="truck-card d-flex align-items-center justify-content-between p-3 mb-3"
                         data-plate="@truck.PlateNumber @truck.PlateLetter"
                         style="background-color: #fdf5ef; border: 1px solid #eb842d; border-radius: 12px;">

                    <!-- لوحة السيارة -->
                    <div class="license-plate" style="border: 2px solid #555; border-radius: 8px; width: 140px; overflow: hidden; background: #fff; direction: ltr;">
                        <div class="d-flex justify-content-between px-2" style="background-color: #eb842d; color: white; font-size: 0.7rem; font-weight: bold;">
                            <span>EGYPT</span>
                            <span>مصر</span>
                        </div>
                        <div class="d-flex text-center fw-bold" style="color: #333; font-size: 1.2rem;">
                            <div class="w-50 py-1" style="border-right: 2px solid #555;">@truck.PlateNumber</div>
                            <div class="w-50 py-1" style="letter-spacing: 2px;">@truck.PlateLetter</div>
                        </div>
                    </div>

                    <!-- بيانات السيارة -->
                    <div class="truck-info text-center flex-grow-1 px-3">
                        <h3 class="fw-bold mb-1" style="color: #eb842d; font-size: 1.4rem;">
                            @(truck.IsRefrigerated ? "سيارة تبريد" : "سيارة لا تبريد")
                        </h3>
                        <div class="text-dark d-flex justify-content-center align-items-center gap-2 fw-semibold" style="font-size: 0.95rem;">
                            @if (truck.IsRefrigerated)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-7v13h2.5v7H21V2h-5z" /></svg>
                                <span>تبريد</span>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-8.5 1.5l1.96 2.5H6.5v-2.5h5zM17 9.5l1.96 2.5H17v-2.5z" /></svg>
                                <span>غير تبريد</span>
                            }
                        </div>
                    </div>

                    <!-- زر الاختيار -->
                    <div class="card-action">
                        <button class="select-btn btn text-white px-4 py-2 fw-bold" type="button" aria-label="اختيار السيارة" style="background-color: #eb842d; border-radius: 8px;">
                            اختيار السيارة
                        </button>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="text-center mt-5" style="color: var(--dark-text); font-size: 1.2rem;">
                لا يوجد سيارات مسجلة في النظام.
            </div>
        }
    </section>
</main>

<!-- Multi-Step Modal System -->
<div id="custom-modal-overlay" class="custom-modal-overlay" aria-hidden="true">

    <!-- Modal 0: Department Selection -->
    <div id="department-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="department-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <rect x="9" y="3" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="3" y="17" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="15" y="17" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <path d="M12 7v5M6 17v-3h12v3M18 14v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
        </div>

        <div class="modal-body text-center w-100 mt-4">
            <h2 id="department-modal-title" class="modal-title" style="margin-bottom: 24px;">اختار القسم</h2>

            <div class="custom-dropdown" id="dept-dropdown-container">
                <div class="dropdown-header" id="dept-dropdown-header">
                    <span class="selected-value text-muted" id="dept-selected-value">اختار القسم</span>
                    <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#EB842D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>

                <div class="dropdown-list" id="dept-dropdown-list">
                    <!-- Dynamic departments populated via JS -->
                </div>

                <div class="invalid-feedback text-right mt-2" id="dept-error-msg" style="display: none; color: #dc3545; font-size: 0.95rem; font-weight: 500;">
                    يرجى اختيار القسم للمتابعة.
                </div>
            </div>
        </div>

        <div class="modal-actions mt-4" style="margin-top: 32px !important;">
            <button id="btn-confirm-dept" class="btn-primary-custom w-100" aria-label="تأكيد القسم">تأكيد</button>
        </div>
    </div>

    <!-- Modal 1: Data Confirmation -->
    <div id="confirmation-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-question-lg" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M4.475 5.458c-.284 0-.514-.237-.47-.517C4.28 3.24 5.576 2 7.825 2c2.25 0 3.767 1.36 3.767 3.215 0 1.344-.665 2.288-1.79 2.973-1.1.659-1.414 1.118-1.414 2.01v.03a.5.5 0 0 1-.5.5h-.77a.5.5 0 0 1-.5-.495l-.003-.2c-.043-1.221.477-2.001 1.645-2.712 1.03-.632 1.397-1.135 1.397-2.028 0-.979-.758-1.698-1.926-1.698-1.009 0-1.71.529-1.938 1.402-.066.254-.278.461-.54.461h-.777ZM7.496 14c.622 0 1.095-.474 1.095-1.09 0-.618-.473-1.092-1.095-1.092-.606 0-1.087.474-1.087 1.091S6.89 14 7.496 14" />
                </svg>
            </div>
        </div>

        <div class="modal-body data-grid mt-4 firstModelcontent">
            <div class="data-row">
                <span class="data-label">الشركة :</span>
                <span class="data-value" id="confirm-company">تحويل داخلي</span>
            </div>
            <div class="data-row">
                <span class="data-label">السيارة :</span>
                <span class="data-value" id="confirm-truck"></span>
            </div>
            <div class="data-row">
                <span class="data-label">السائق :</span>
                <span class="data-value" id="confirm-driver-name">غير محدد</span>
            </div>
            <div class="data-row">
                <span class="data-label">القسم :</span>
                <span class="data-value" id="confirm-driver-dep"></span>
            </div>
        </div>

        <div class="modal-actions">
            <button id="btn-edit" class="btn-secondary-custom" aria-label="تعديل البيانات">تعديل</button>
            <button id="btn-confirm" class="btn-primary-custom" aria-label="تأكيد البيانات">تأكيد</button>
        </div>
    </div>

    <!-- Modal 2: Success & Ticket -->
    <div id="success-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="success-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle green-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
        </div>

        <div class="modal-body text-center w-100 mt-4">
            <h2 id="success-modal-title" class="modal-title success-text">تم تأكيد البيانات بنجاح</h2>
            <div class="ticket-box">
                <span id="ticket-number" class="ticket-number-text">A1</span>
            </div>
        </div>

        <div class="modal-actions">
            <button id="btn-back" class="btn-secondary-custom" aria-label="الرجوع">الرجوع</button>
            <button id="btn-print" class="btn-primary-custom" aria-label="طباعة البون">طباعة</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.departmentsData = @Html.Raw(Json.Serialize(ViewBag.Departments ?? new List<object>()));

        window.pageData = {
            truckName: '@Html.Raw(ViewBag.TruckName ?? "شاحنة تحويل")',
            dockName: 'A',
            employeeName: '@Html.Raw(!string.IsNullOrWhiteSpace(User.Identity?.Name) ? User.Identity.Name : "محمد حسين")'
        };

        window.routes = {
            backRoute: '@Url.Action("SupOrTra", "Authentication")',
            viewRole: '@Url.Action("ViewRole", "Authentication")',
            receiptPage: '@Url.Action("Recript", "Driver")'
        };
    </script>
    <script src="~/js/companyTraDrivers.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
}