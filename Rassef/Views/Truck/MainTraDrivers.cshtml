@{
    ViewData["Title"] = "شاحنات التحويل";
    Layout = "_SupOrTra";
}
@model IEnumerable<Rassef.ViewModels.Truck.TruckListVM>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

<link rel="stylesheet" href="~/css/companyDrivers.css" asp-append-version="true" />

<main class="page-container">
    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
        </div>

        <div class="title-wrapper">
            <h1 class="main-title" id="page-title">شاحنات التحويل</h1>
        </div>

        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="brand-logo logo-raseefy" style="height: 80px;" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
        </div>
    </header>

    <div class="nav-actions-container">
        <!-- التوجيه لصفحة إضافة شاحنة -->
        <a asp-controller="Truck" asp-action="AddTraDriver" class="action-btn" aria-label="إضافة جديد">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            إضافة جديد
        </a>

        <!-- الرجوع لصفحة اختيار توريد/تحويل -->
        <a asp-controller="Authentication" asp-action="SupOrTra" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="search-section" aria-label="البحث عن سيارة">
        <div class="search-wrapper">
            <button type="button" class="search-btn" id="search-btn" aria-label="بحث">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
            <input type="text" id="search-input" class="search-input" placeholder="ادخل رقم السيارة" aria-label="ادخل رقم السيارة للبحث" autocomplete="off">
        </div>
    </section>

    <!-- قائمة السيارات -->
    <section class="cards-section" id="cards-container" aria-label="قائمة السيارات">
        @if (Model != null && Model.Any())
        {
            foreach (var truck in Model)
            {
                <article class="truck-card d-flex align-items-center justify-content-between p-3 mb-3"
                         data-truck-id="@truck.Id"
                         data-plate="@truck.PlateNumber @truck.PlateLetter"
                         style="background-color: #fdf5ef; border: 1px solid #eb842d; border-radius: 12px;">

                    <!-- لوحة السيارة -->
                    <div class="license-plate" style="border: 2px solid #555; border-radius: 8px; width: 140px; overflow: hidden; background: #fff; direction: ltr;">
                        <div class="d-flex justify-content-between px-2" style="background-color: #eb842d; color: white; font-size: 0.7rem; font-weight: bold;">
                            <span>EGYPT</span>
                            <span>مصر</span>
                        </div>
                        <div class="d-flex text-center fw-bold" style="color: #333; font-size: 1.2rem;">
                            <div class="w-50 py-1" style="border-right: 2px solid #555;">@truck.PlateNumber</div>
                            <div class="w-50 py-1" style="letter-spacing: 2px;">@truck.PlateLetter</div>
                        </div>
                    </div>

                    <!-- بيانات السيارة -->
                    <div class="truck-info text-center flex-grow-1 px-3">
                        <h3 class="fw-bold mb-1" style="color: #eb842d; font-size: 1.4rem;">
                            @(truck.IsRefrigerated ? "سيارة تبريد" : "سيارة لا تبريد")
                        </h3>
                        <div class="text-dark d-flex justify-content-center align-items-center gap-2 fw-semibold" style="font-size: 0.95rem;">
                            @if (truck.IsRefrigerated)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-7v13h2.5v7H21V2h-5z" /></svg>
                                <span>تبريد</span>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-8.5 1.5l1.96 2.5H6.5v-2.5h5zM17 9.5l1.96 2.5H17v-2.5z" /></svg>
                                <span>غير تبريد</span>
                            }
                        </div>
                    </div>

                    <!-- زر الاختيار -->
                    <div class="card-action">
                        <button class="select-btn btn text-white px-4 py-2 fw-bold" type="button" aria-label="اختيار السيارة" style="background-color: #eb842d; border-radius: 8px;">
                            اختيار السيارة
                        </button>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="text-center mt-5" style="color: var(--dark-text); font-size: 1.2rem;">
                لا يوجد سيارات مسجلة في النظام.
            </div>
        }
    </section>
</main>

@section Scripts {
    <script>
        // CHANGED — department/driver/ticket selection no longer happens on this
        // page. Picking a truck now navigates to the filtered driver picker
        // (Driver/TransferDrivers), which owns the department + confirmation +
        // success modal flow and the real CreateTransferTicket call.
        window.routes = {
            transferDriversPage: '@Url.Action("TransferDrivers", "Driver")'
        };
    </script>
    <script src="~/js/companyTraDrivers.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
}