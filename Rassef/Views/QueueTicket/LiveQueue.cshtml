@model Rassef.ViewModels.QueueTicket.QueueTicketIndexVM
@{
    ViewData["Title"] = "بوابة إدارة واستدعاء الشاحنات";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/gateLiveQueue.css" asp-append-version="true">
</head>
<body>

    <div class="page-container">
        <!-- Header -->
        <header class="page-header">
            <div class="header-right">
                <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
                <div class="header-title-box">
                    <h1 class="page-title">إدارة أدوار الشاحنات</h1>
                    <div class="page-subtitle">
                        <span class="live-dot"></span>
                        <span>شاشة البوابة والرصيف المباشرة — موظف الحركة</span>
                    </div>
                </div>
            </div>

            <div class="header-left">
                <img src="~/img/logo.svg" alt="رصيفي" class="brand-raseefy" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
            </div>
        </header>

        <!-- Top Action Bar -->
        <section class="action-bar">
            <div class="action-buttons-group">
                <button id="btnCallNextTicket" class="btn-next-call" type="button">
                    <i class="fas fa-step-forward"></i>
                    <span>استدعاء الدور التالي (Next ⏭️)</span>
                </button>
                <a asp-controller="Authentication" asp-action="AddRoleOrView" class="btn-secondary-action">
                    <i class="fas fa-home"></i>
                    <span>القائمة الرئيسية</span>
                </a>
            </div>

            <div class="action-info">
                <span style="font-weight: 700; color: var(--text-dark); font-size: 0.95rem;">
                    إجمالي الأدوار المسجلة اليوم: <strong style="color: var(--primary-orange); font-size: 1.15rem;">@(Model?.Tickets?.Count ?? 0)</strong>
                </span>
            </div>
        </section>

        <!-- Live Alert Toast -->
        <div id="liveToastAlert" class="toast-msg-container" style="display: none;"></div>

        <!-- Stats Overview -->
        <section class="stats-grid">
            <div class="stat-box waiting">
                <div class="stat-info">
                    <h4>في الانتظار ⏳</h4>
                    <span class="stat-num" id="statWaitCount">@(Model?.WaitingCount ?? 0)</span>
                </div>
                <div class="stat-icon"><i class="far fa-clock"></i></div>
            </div>

            <div class="stat-box active">
                <div class="stat-info">
                    <h4>جاري التفريغ 🚚</h4>
                    <span class="stat-num" id="statActiveCount">@(Model?.InProgressCount ?? 0)</span>
                </div>
                <div class="stat-icon"><i class="fas fa-dolly"></i></div>
            </div>

            <div class="stat-box done">
                <div class="stat-info">
                    <h4>تم الاكتمال ✅</h4>
                    <span class="stat-num" id="statDoneCount">@(Model?.CompletedCount ?? 0)</span>
                </div>
                <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
            </div>
        </section>

        <!-- Filters & Search -->
        <section class="filters-search-bar">
            <div class="filter-chips">
                <button class="chip-btn active" data-filter="الكل">الكل</button>
                <button class="chip-btn" data-filter="إنتظار">إنتظار</button>
                <button class="chip-btn" data-filter="جاري">جاري</button>
                <button class="chip-btn" data-filter="مكتملة">مكتملة</button>
                <button class="chip-btn" data-filter="توريد">توريد</button>
                <button class="chip-btn" data-filter="تحويل">تحويل</button>
            </div>

            <div class="search-box-wrapper">
                <input type="text" id="searchTicketsInput" placeholder="ابحث برقم الدور، السائق، رقم اللوحة، القسم...">
                <i class="fas fa-search search-icon"></i>
            </div>
        </section>

        <!-- Tickets Cards Grid -->
        <main class="tickets-grid" id="ticketsGrid">
            @if (Model?.Tickets != null && Model.Tickets.Any())
            {
                foreach (var item in Model.Tickets)
                {
                    var norm = (item.TicketStatusName ?? "").Replace("إ", "ا").Trim();
                    bool isCompleted = norm.Contains("تم") || norm.Contains("مكتمل") || norm.Contains("منتهي") || norm.Contains("خروج");
                    bool isInProgress = norm.Contains("جاري") || norm.Contains("تنفيذ") || norm.Contains("تشغيل");
                    bool isWaiting = !isCompleted && !isInProgress;

                    string statusCategory = isCompleted ? "مكتمل" : (isInProgress ? "جاري" : "إنتظار");
                    string pillClass = isCompleted ? "status-pill-done" : (isInProgress ? "status-pill-active" : "status-pill-wait");
                    string pillIcon = isCompleted ? "fa-check-circle" : (isInProgress ? "fa-truck-loading" : "fa-clock");
                    string pillText = isCompleted ? "مكتمل" : (isInProgress ? "جاري التنفيذ" : "في الانتظار");

                    <article class="ticket-card"
                             id="ticket-card-@item.Id"
                             data-status="@statusCategory"
                             data-type="@(item.RequestType ?? "توريد")"
                             data-search="@item.TicketNumber @item.DriverName @item.TruckNumber @item.DepartmentName @item.DockName @item.CompanyName @item.RequestType">

                        <!-- Card Header -->
                        <div class="ticket-card-header">
                            <div class="ticket-number-badge">@item.TicketNumber</div>
                            <span class="badge-type-tag" style="background: @(item.RequestType == "توريد" ? "#fff3e0" : "#e3f2fd"); color: @(item.RequestType == "توريد" ? "#e47925" : "#1976d2"); font-weight: 700; padding: 4px 10px; border-radius: 8px; font-size: 0.82rem; border: 1px solid @(item.RequestType == "توريد" ? "#ffe0b2" : "#bbdefb");">
                                @(item.RequestType ?? "توريد")
                            </span>
                            <div class="ticket-status-pill @pillClass">
                                <i class="fas @pillIcon"></i>
                                <span>@pillText</span>
                            </div>
                        </div>

                        <!-- Card Details -->
                        <div class="ticket-details-grid">
                            <div class="detail-item">
                                <i class="fas fa-building detail-icon"></i>
                                <div class="detail-text">
                                    <span class="detail-label">@(item.RequestType == "توريد" ? "المورد" : "جهة التحويل")</span>
                                    <span class="detail-value" title="@item.CompanyName">@item.CompanyName</span>
                                </div>
                            </div>

                            <div class="detail-item">
                                <i class="fas fa-truck detail-icon"></i>
                                <div class="detail-text">
                                    <span class="detail-label">رقم اللوحة</span>
                                    <span class="detail-value" style="direction: ltr; text-align: right;">@item.TruckNumber</span>
                                </div>
                            </div>

                            <div class="detail-item">
                                <i class="fas fa-user detail-icon"></i>
                                <div class="detail-text">
                                    <span class="detail-label">السائق</span>
                                    <span class="detail-value">@item.DriverName</span>
                                </div>
                            </div>

                            <div class="detail-item">
                                <i class="fas fa-warehouse detail-icon"></i>
                                <div class="detail-text">
                                    <span class="detail-label">الرصيف</span>
                                    <span class="detail-value" style="color: var(--primary-orange); font-weight: 800;">@item.DockName</span>
                                </div>
                            </div>

                            <div class="detail-item">
                                <i class="fas fa-code-branch detail-icon"></i>
                                <div class="detail-text">
                                    <span class="detail-label">القسم</span>
                                    <span class="detail-value">@item.DepartmentName</span>
                                </div>
                            </div>

                            <div class="detail-item">
                                <i class="far fa-clock detail-icon"></i>
                                <div class="detail-text">
                                    <span class="detail-label">وقت التسجيل</span>
                                    <span class="detail-value">@item.EntryTime.ToString("hh:mm tt")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card Action Buttons -->
                        <div class="ticket-card-actions" id="ticket-actions-@item.Id">
                            @if (isWaiting)
                            {
                                <button class="btn-card-start" type="button" onclick="updateOperatorStatus(@item.Id, 'جاري')">
                                    <i class="fas fa-play"></i> <span>بدء التفريغ (جاري)</span>
                                </button>
                            }
                            else if (isInProgress)
                            {
                                <button class="btn-card-complete" type="button" onclick="updateOperatorStatus(@item.Id, 'مكتمل')">
                                    <i class="fas fa-check-double"></i> <span>إنهاء وتفريغ (مكتمل)</span>
                                </button>
                            }
                            else
                            {
                                <div class="badge-done-label"><i class="fas fa-check-circle"></i> تم الانتهاء بنجاح</div>
                            }
                        </div>

                    </article>
                }
            }
            else
            {
                <div style="grid-column: 1 / -1; text-align: center; padding: 50px 20px; background: #FFF; border-radius: 16px; border: 1.5px dashed var(--primary-border); color: var(--text-muted);">
                    <i class="far fa-folder-open" style="font-size: 3rem; color: var(--primary-orange); margin-bottom: 12px; display: block;"></i>
                    <h3 style="font-weight: 700; color: var(--text-dark);">لا توجد أي أدوار مسجلة حالياً</h3>
                    <p style="font-size: 0.9rem; margin-top: 4px;">يمكنك إصدار دور جديد من شاشة التوريد أو التحويل.</p>
                </div>
            }
        </main>
    </div>

    <script src="~/js/gateLiveQueue.js" asp-append-version="true"></script>
</body>
</html>
