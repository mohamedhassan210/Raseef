@model Rassef.ViewModels.QueueTicket.QueueTicketIndexVM
@{
    Layout = null;
    ViewData["Title"] = "قائمة الأدوار — شاشة العرض المباشرة";
    var dockCards = Model?.DockCards ?? new List<Rassef.ViewModels.QueueTicket.LiveDockCardVM>();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/liveQueueBoard.css" asp-append-version="true">
</head>
<body>
    <div class="live-board-container">
        <!-- 1. TOP HEADER -->
        <header class="live-board-header">
            <!-- Left: Raseef Logo -->
            <div class="header-logo-left">
                <img src="~/img/logo.svg" alt="رصيف" class="board-logo-raseef" onerror="this.src='/img/logo.png'">
            </div>

            <!-- Center: Title -->
            <h1 class="board-title-center">قائمة الأدوار</h1>

            <!-- Right: Fathalla Logo -->
            <div class="header-logo-right">
                <img src="~/img/fathallah logo.svg" alt="فتح الله" class="board-logo-fathallah" onerror="this.src='/img/fathallah.png'">
            </div>
        </header>

        <!-- 2. DOCKS 3x2 GRID -->
        <main class="docks-grid-board" id="docksGridContainer">
            @if (dockCards.Any())
            {
                foreach (var dock in dockCards)
                {
                    <div class="dock-card-board" id="dock-card-@dock.DockLetter">
                        <!-- Top Letter Circle Badge -->
                        <div class="dock-letter-badge">
                            <span>@dock.DockLetter</span>
                        </div>

                        <!-- Top Orange Header -->
                        <div class="dock-card-header">
                            <h3 class="dock-name-title">@dock.DockName</h3>
                        </div>

                        <!-- Card Body -->
                        <div class="dock-card-body">
                            <!-- Role Subtitle Divider -->
                            <div class="current-role-divider">
                                <span class="role-divider-line"></span>
                                <span class="role-divider-label">الدور الحالي</span>
                                <span class="role-divider-line"></span>
                            </div>

                            <!-- Main Giant Ticket Number -->
                            <div class="dock-giant-ticket" id="current-ticket-@dock.DockLetter">
                                @dock.CurrentTicketNumber
                            </div>

                            <!-- Glow Underline -->
                            <div class="dock-ticket-underline"></div>

                            <!-- Next Upcoming Ticket -->
                            <div class="dock-next-upcoming">
                                <span class="next-chevron-circle">
                                    <i class="fas fa-angle-double-left"></i>
                                </span>
                                <span class="next-ticket-num" id="next-ticket-@dock.DockLetter">
                                    @dock.NextTicketNumber
                                </span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Default 6 Fallback Docks -->
                var fallbackLetters = new[] { "A", "B", "C", "D", "E", "F" };
                foreach (var letter in fallbackLetters)
                {
                    <div class="dock-card-board">
                        <div class="dock-letter-badge">
                            <span>@letter</span>
                        </div>
                        <div class="dock-card-header">
                            <h3 class="dock-name-title">رصيف 5</h3>
                        </div>
                        <div class="dock-card-body">
                            <div class="current-role-divider">
                                <span class="role-divider-line"></span>
                                <span class="role-divider-label">الدور الحالي</span>
                                <span class="role-divider-line"></span>
                            </div>
                            <div class="dock-giant-ticket">A265</div>
                            <div class="dock-ticket-underline"></div>
                            <div class="dock-next-upcoming">
                                <span class="next-chevron-circle"><i class="fas fa-angle-double-left"></i></span>
                                <span class="next-ticket-num">A266</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </main>
    </div>

    <!-- Fullscreen Floating Toggle Button -->
    <button type="button" class="fullscreen-float-btn" id="btnFullscreen" title="ملء الشاشة">
        <i class="fas fa-expand"></i>
    </button>

    <!-- LIVE REAL-TIME POLLING & FULLSCREEN SCRIPT -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Fullscreen toggle
            const btnFullscreen = document.getElementById("btnFullscreen");
            if (btnFullscreen) {
                btnFullscreen.addEventListener("click", () => {
                    if (!document.fullscreenElement) {
                        document.documentElement.requestFullscreen().catch(err => {
                            console.error(`Error attempting to enable fullscreen: ${err.message}`);
                        });
                        btnFullscreen.innerHTML = '<i class="fas fa-compress"></i>';
                    } else {
                        if (document.exitFullscreen) {
                            document.exitFullscreen();
                            btnFullscreen.innerHTML = '<i class="fas fa-expand"></i>';
                        }
                    }
                });
            }

            // Real-time live polling every 3 seconds
            async function updateLiveBoard() {
                try {
                    const response = await fetch('/QueueTicket/GetLiveDisplayData');
                    if (response.ok) {
                        const data = await response.json();
                        if (data.success && data.dockCards) {
                            data.dockCards.forEach(dock => {
                                const curElem = document.getElementById(`current-ticket-${dock.dockLetter}`);
                                const nextElem = document.getElementById(`next-ticket-${dock.dockLetter}`);

                                if (curElem && curElem.textContent.trim() !== dock.currentTicketNumber) {
                                    curElem.style.transition = 'transform 0.3s ease, color 0.3s ease';
                                    curElem.style.transform = 'scale(1.15)';
                                    curElem.style.color = 'var(--primary-color)';
                                    curElem.textContent = dock.currentTicketNumber;
                                    setTimeout(() => {
                                        curElem.style.transform = 'scale(1)';
                                        curElem.style.color = 'var(--text-dark)';
                                    }, 400);
                                }

                                if (nextElem && nextElem.textContent.trim() !== dock.nextTicketNumber) {
                                    nextElem.textContent = dock.nextTicketNumber;
                                }
                            });
                        }
                    }
                } catch (err) {
                    console.error("Error refreshing live queue display:", err);
                }
            }

            // Poll every 3 seconds
            setInterval(updateLiveBoard, 3000);
        });
    </script>
</body>
</html>
