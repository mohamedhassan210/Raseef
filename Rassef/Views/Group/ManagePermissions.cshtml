
@{
    ViewData["Title"] = "إدارة الصلاحيات";
}
@model Rassef.ViewModels.Authentication.Identity.GroupPermissionsViewModel

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">
            <i class="fas fa-user-shield me-2"></i> إدارة صلاحيات مجموعة: @Model.GroupName
        </h3>
    </div>
    <div class="card-body bg-light">

        <form asp-action="ManagePermissions" method="post">
            @Html.AntiForgeryToken()

            <!-- الحقول المخفية الأساسية الخاصة بالمجموعة -->
            <input type="hidden" asp-for="GroupId" />
            <input type="hidden" asp-for="GroupName" />

            <div class="row">
                @for (int i = 0; i < Model.Controllers.Count; i++)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card border-info h-100 shadow-sm">
                            <div class="card-header bg-info text-white font-weight-bold d-flex justify-content-between align-items-center">
                                <span>
                                    <i class="fas fa-folder-open me-2"></i> @Model.Controllers[i].ControllerName
                                </span>
                                <!-- حقل مخفي لاسم الكنترولر -->
                                <input type="hidden" asp-for="Controllers[i].ControllerName" />
                            </div>
                            <div class="card-body p-0">
                                <ul class="list-group list-group-flush">

                                    @for (int j = 0; j < Model.Controllers[i].Actions.Count; j++)
                                    {
                                        <li class="list-group-item list-group-item-action">
                                            <div class="form-check form-switch d-flex align-items-center">

                                                <!-- البيانات المخفية اللي محتاجينها ترجع للـ Controller وقت الحفظ -->
                                                <input type="hidden" asp-for="Controllers[i].Actions[j].PermissionId" />
                                                <input type="hidden" asp-for="Controllers[i].Actions[j].ActionName" />
                                                <input type="hidden" asp-for="Controllers[i].Actions[j].Description" />

                                                <!-- الـ Checkbox الفعلي -->
                                                <input class="form-check-input me-3" type="checkbox" role="switch" asp-for="Controllers[i].Actions[j].IsSelected" style="cursor: pointer;" />
                                                <label class="form-check-label user-select-none mb-0 w-100" asp-for="Controllers[i].Actions[j].IsSelected" style="cursor: pointer;">
                                                    @Model.Controllers[i].Actions[j].Description
                                                </label>

                                            </div>
                                        </li>
                                    }

                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <hr class="my-4" />

            <div class="form-group text-center">
                <button type="submit" class="btn btn-success btn-lg px-5 shadow-sm">
                    <i class="fas fa-save me-2"></i> حفظ التعديلات
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg px-5 shadow-sm ms-2">
                    <i class="fas fa-times me-2"></i> إلغاء وعودة
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <!-- هنا ممكن نضيف أي سكريبتات إضافية لو احتجنا (زي مثلاً زرار يعلم على كل الصلاحيات مرة واحدة) -->
    <partial name="_ValidationScriptsPartial" />
}