@model Rassef.ViewModels.Authentication.Identity.GroupPermissionsViewModel
@{
    Layout = null;
    ViewData["Title"] = "إدارة صلاحيات";
    var allGroups = ViewBag.AllGroups as List<Rassef.Models.Identity.UserGroup> ?? new();
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - رصيف</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/groupRolePages.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/detailsPages.css" asp-append-version="true">
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <partial name="_AdminSidebar" model='"Groups"' />

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <!-- HEADER -->
            <header class="dashboard-header">
                <div class="header-right">
                    <h2 class="header-title">إدارة صلاحيات</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>آخر تحديث منذ 10 ثواني</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <a href="@Url.Action("MangeRolesIndex", "Group")" class="btn-back-action">
                        <span>رجوع</span>
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- GROUPS HORIZONTAL NAV -->
            @if (allGroups != null && allGroups.Any())
            {
                <div class="groups-horizontal-nav">
                    @foreach (var grp in allGroups)
                    {
                        bool isActiveGroup = grp.Id == Model.GroupId;
                        <a href="@Url.Action("ManagePermissions", "Group", new { groupId = grp.Id })" class="group-nav-pill @(isActiveGroup ? "active" : "")">
                            <i class="fas fa-users"></i>
                            <span>@grp.Name</span>
                        </a>
                    }
                </div>
            }

            <!-- GROUP TITLE -->
            <div class="section-underlined-title" style="margin-top: 5px;">
                صلاحيات فريق الـ @Model.GroupName
            </div>

            <!-- PERMISSIONS FORM -->
            <form asp-action="ManagePermissions" method="post" id="permissionsForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="GroupId" />
                <input type="hidden" asp-for="GroupName" />

                <div class="accordions-container">
                    @if (Model.Controllers != null && Model.Controllers.Any())
                    {
                        for (int i = 0; i < Model.Controllers.Count; i++)
                        {
                            var ctrl = Model.Controllers[i];
                            string iconClass = "fa-folder";
                            string ctrlName = ctrl.ControllerName?.ToLower() ?? "";

                            if (ctrlName.Contains("account") || ctrlName.Contains("user") || ctrlName.Contains("auth")) iconClass = "fa-user";
                            else if (ctrlName.Contains("system") || ctrlName.Contains("admin")) iconClass = "fa-cog";
                            else if (ctrlName.Contains("branch") || ctrlName.Contains("warehouse")) iconClass = "fa-code-branch";
                            else if (ctrlName.Contains("truck")) iconClass = "fa-truck";
                            else if (ctrlName.Contains("driver")) iconClass = "fa-id-card";
                            else if (ctrlName.Contains("supplier")) iconClass = "fa-building";
                            else if (ctrlName.Contains("transfer")) iconClass = "fa-exchange-alt";
                            else if (ctrlName.Contains("queue") || ctrlName.Contains("ticket")) iconClass = "fa-clock";
                            else if (ctrlName.Contains("group") || ctrlName.Contains("role")) iconClass = "fa-users-cog";
                            else if (ctrlName.Contains("shift")) iconClass = "fa-business-time";
                            else if (ctrlName.Contains("dock")) iconClass = "fa-anchor";

                            <div class="accordion-controller-card open" id="accordion-@i">
                                <input type="hidden" name="Controllers[@i].ControllerName" value="@ctrl.ControllerName" />

                                <!-- Accordion Header -->
                                <div class="accordion-header" onclick="toggleAccordion(@i)">
                                    <div class="accordion-title-box">
                                        <label class="controller-select-all-label" onclick="event.stopPropagation();">
                                            <input type="checkbox"
                                                   id="ctrl-check-@i"
                                                   class="custom-checkbox controller-master-checkbox"
                                                   data-index="@i"
                                                   onchange="onControllerCheckChanged(this, @i)" />
                                            <span>الكل</span>
                                        </label>
                                        <i class="fas @iconClass accordion-title-icon"></i>
                                        <span>@ctrl.ControllerName</span>
                                    </div>
                                    <div class="controller-header-left">
                                        <i class="fas fa-chevron-down accordion-chevron"></i>
                                    </div>
                                </div>

                                <!-- Accordion Content (3 Columns Grid of Checkboxes) -->
                                <div class="accordion-body-content" id="body-@i">
                                    <div class="permissions-checkbox-grid">
                                        @for (int j = 0; j < ctrl.Actions.Count; j++)
                                        {
                                            var act = ctrl.Actions[j];
                                            <input type="hidden" name="Controllers[@i].Actions[@j].PermissionId" value="@act.PermissionId" />
                                            <input type="hidden" name="Controllers[@i].Actions[@j].ActionName" value="@act.ActionName" />
                                            <input type="hidden" name="Controllers[@i].Actions[@j].Description" value="@act.Description" />

                                            <label class="checkbox-label-wrapper">
                                                <input type="checkbox"
                                                       class="custom-checkbox action-check-@i"
                                                       data-controller-index="@i"
                                                       name="Controllers[@i].Actions[@j].IsSelected"
                                                       value="true"
                                                       onchange="onActionCheckChanged(@i)"
                                                       @(act.IsSelected ? "checked" : "") />
                                                <span>@act.ActionName</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- SAVE ACTION BAR -->
                <div style="margin-top: 24px; display: flex; justify-content: flex-end; gap: 12px;">
                    <a href="@Url.Action("MangeRolesIndex", "Group")" class="btn-back-action" style="background: #78909C;">إلغاء</a>
                    <button type="submit" class="btn-add-group" style="padding: 12px 32px; font-size: 16px;">
                        <i class="fas fa-save"></i>
                        <span>حفظ التعديلات</span>
                    </button>
                </div>
            </form>
        </main>
    </div>

    <!-- ACCORDION & CHECKBOX SYNC SCRIPTS -->
    <script>
        function toggleAccordion(index) {
            const card = document.getElementById(`accordion-${index}`);
            const body = document.getElementById(`body-${index}`);
            if (card.classList.contains("open")) {
                card.classList.remove("open");
                body.style.display = "none";
            } else {
                card.classList.add("open");
                body.style.display = "block";
            }
        }

        function onControllerCheckChanged(masterCheckbox, index) {
            const isChecked = masterCheckbox.checked;
            const actionChecks = document.querySelectorAll(`.action-check-${index}`);
            actionChecks.forEach(cb => {
                cb.checked = isChecked;
            });
        }

        function onActionCheckChanged(index) {
            const masterCheckbox = document.getElementById(`ctrl-check-${index}`);
            if (!masterCheckbox) return;

            const actionChecks = document.querySelectorAll(`.action-check-${index}`);
            const total = actionChecks.length;
            const checkedCount = Array.from(actionChecks).filter(cb => cb.checked).length;

            if (checkedCount === total && total > 0) {
                masterCheckbox.checked = true;
                masterCheckbox.indeterminate = false;
            } else if (checkedCount > 0) {
                masterCheckbox.checked = false;
                masterCheckbox.indeterminate = true;
            } else {
                masterCheckbox.checked = false;
                masterCheckbox.indeterminate = false;
            }
        }

        // Initialize checkboxes state on page load
        document.addEventListener("DOMContentLoaded", function () {
            const masterCheckboxes = document.querySelectorAll('.controller-master-checkbox');
            masterCheckboxes.forEach(mb => {
                const index = mb.getAttribute('data-index');
                onActionCheckChanged(index);
            });
        });
    </script>
</body>
</html>
