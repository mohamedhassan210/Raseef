@model Rassef.ViewModels.Group.TypesManagementVM
@{
    Layout = null;
    ViewData["Title"] = "إدارة الإختيارات";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - رصيف</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/groupRolePages.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/detailsPages.css" asp-append-version="true">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'IBM Plex Sans Arabic', sans-serif;
        }

        body {
            background-color: var(--bg-color, #FAF2EB);
            color: #333;
            overflow-x: hidden;
        }

        /* Top Header */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-title-box {
            display: flex;
            flex-direction: column;
        }

        .page-main-title {
            font-size: 32px;
            font-weight: 800;
            color: var(--primary-color, #E67E22);
            margin-bottom: 2px;
        }

        .page-subtitle {
            font-size: 13px;
            color: #888;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .page-subtitle::before {
            content: "•";
            color: var(--primary-color, #E67E22);
            font-size: 16px;
        }

        .header-logos {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .header-logos img {
            height: 44px;
            object-fit: contain;
        }

        /* Controls Bar */
        .controls-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-top: 10px;
        }

        .controls-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .section-tab-title {
            font-size: 20px;
            font-weight: 800;
            color: #333;
            position: relative;
            padding-bottom: 6px;
        }

        .section-tab-title::after {
            content: "";
            position: absolute;
            bottom: 0;
            right: 0;
            width: 100%;
            height: 3px;
            background-color: var(--primary-color, #E67E22);
            border-radius: 2px;
        }

        .filter-dropdown {
            background-color: var(--primary-color, #E67E22);
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            outline: none;
        }

        .search-box-custom {
            position: relative;
            width: 280px;
        }

        .search-input {
            width: 100%;
            padding: 8px 36px 8px 14px;
            border-radius: 20px;
            border: 1.5px solid var(--primary-color, #E67E22);
            background-color: #fff;
            font-size: 13px;
            outline: none;
            color: #333;
            transition: all 0.2s;
        }

        .search-input:focus {
            box-shadow: 0 0 0 3px rgba(232, 122, 30, 0.15);
        }

        .search-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            stroke: var(--primary-color, #E67E22);
            fill: none;
            stroke-width: 2;
            pointer-events: none;
        }

        /* ── CARDS GRID ── */
        .types-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-top: 10px;
        }

        @@media (max-width: 1300px) {
            .types-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 1000px) {
            .types-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .type-card {
            background: #fff;
            border: 1.5px solid var(--primary-color, #E67E22);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
            display: flex;
            flex-direction: column;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .type-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(232, 122, 30, 0.15);
        }

        .type-card-header {
            background-color: var(--primary-color, #E67E22);
            color: #fff;
            padding: 12px 16px;
            text-align: center;
            font-size: 18px;
            font-weight: 800;
        }

        .type-card-body {
            padding: 16px 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            background-color: #fdfaf7;
            flex: 1;
        }

        .info-row {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            font-weight: 700;
            color: #2b2b2b;
        }

        .info-row svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
        }

        .badge-status {
            align-self: flex-start;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 4px;
        }

        .badge-active {
            background-color: #e8f7ee;
            color: #1e7e34;
            border: 1px solid #1e7e34;
        }
    </style>
</head>
<body>

    <div class="dashboard-page">
        <!-- ── SIDEBAR ── -->
        <partial name="_AdminSidebar" model='"Options"' />

        <!-- ── MAIN CONTENT ── -->
        <main class="dashboard-main">

            <!-- 1. Header -->
            <header class="dashboard-header">
                <div class="header-right">
                    <h2 class="header-title">إدارة الإختيارات</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>آخر تحديث منذ 10 ثواني</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- 2. Controls Row -->
            <div class="controls-row">
                <div class="controls-right">
                    <span class="section-tab-title">كل الإختيارات</span>
                    <select class="filter-dropdown" id="categoryFilter">
                        <option value="all">المجموعة</option>
                    </select>
                    <div class="search-box-custom">
                        <input type="text" class="search-input" id="typeSearchInput" placeholder="ادخل اسم الإختيار" />
                        <svg class="search-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </div>
                </div>
            </div>

            <!-- 3. Cards Grid -->
            <div class="types-grid" id="typesContainer">
                @if (Model.TypeCategories != null && Model.TypeCategories.Any())
                {
                    foreach (var item in Model.TypeCategories)
                    {
                        // CHANGED: driver-type and truck-type now have their own dedicated
                        // controllers (DriverTypeController / TruckTypesController) with the
                        // real Code fields — those two cards must not fall back into the
                        // generic name-only Group/MangeTypeDetails screen.
                        string cardUrl = item.Key switch
                        {
                            "driver-type" => Url.Action("Index", "DriverType"),
                            "truck-type" => Url.Action("Index", "TruckTypes"),
                            _ => Url.Action("MangeTypeDetails", "Group", new { typeKey = item.Key })
                        };

                        <a href="@cardUrl" class="type-card" data-title="@item.Title.ToLower()" style="text-decoration: none; color: inherit; cursor: pointer;">
                            <div class="type-card-header">
                                @item.Title
                            </div>
                            <div class="type-card-body">
                                <div class="info-row">
                                    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    <span>عدد الإختيارات : @item.Count</span>
                                </div>
                                <div class="info-row">
                                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    <span>@item.CreatedAt.ToString("dd / M / yyyy")</span>
                                </div>
                                <span class="badge-status badge-active">
                                    <span>•</span> مفعل
                                </span>
                            </div>
                        </a>
                    }
                }
            </div>

        </main>
    </div>

    <script>
        const searchInput = document.getElementById('typeSearchInput');
        const cards = document.querySelectorAll('.type-card');

        searchInput.addEventListener('input', function () {
            const term = this.value.toLowerCase().trim();
            cards.forEach(card => {
                const title = card.getAttribute('data-title') || '';
                if (title.includes(term)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    </script>
</body>
</html>
