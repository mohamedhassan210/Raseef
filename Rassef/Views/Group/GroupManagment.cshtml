@model List<Rassef.ViewModels.Group.GroupCardVM>
@{
    Layout = null;
    ViewData["Title"] = "إدارة المجموعات";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - رصيف</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/groupRolePages.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/detailsPages.css" asp-append-version="true">
    <style>
        .group-card-link {
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <partial name="_AdminSidebar" model='"Groups"' />

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <!-- HEADER -->
            <header class="dashboard-header">
                <div class="header-right">
                    <h2 class="header-title">إدارة المجموعات</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>آخر تحديث منذ 10 ثواني</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div style="background: #E8F5E9; color: #2E7D32; border: 1.5px solid #A5D6A7; padding: 12px 20px; border-radius: 10px; font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-check-circle"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div style="background: #FFEBEE; color: #C62828; border: 1.5px solid #FFCDD2; padding: 12px 20px; border-radius: 10px; font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <!-- TOOLBAR -->
            <div class="groups-toolbar">
                <!-- Section Title -->
                <div class="section-underlined-title">
                    كل المجموعات
                </div>

                <!-- Controls Right Group -->
                <div class="toolbar-controls" style="justify-content: flex-end;">
                    <!-- Status Filter Dropdown -->
                    <select id="statusFilter" class="status-dropdown-select">
                        <option value="all">الحالة (الكل)</option>
                        <option value="active">مفعل</option>
                        <option value="inactive">معطل</option>
                    </select>

                    <!-- Search Box -->
                    <div class="search-box-groups">
                        <input type="text" id="groupSearchInput" class="search-input-groups" placeholder="ادخل اسم المجموعة" />
                        <span class="search-icon-pos"><i class="fas fa-search"></i></span>
                    </div>

                    <!-- Add Group Button -->
                    <button type="button" class="btn-add-group" onclick="openAddGroupModal()">
                        <i class="fas fa-plus"></i>
                        <span>إضافة مجموعة</span>
                    </button>
                </div>
            </div>

            <!-- GROUPS CARDS GRID (4 COLUMNS - EXACT TO IMAGE 1) -->
            <div class="groups-cards-grid" id="groupsContainer">
                @if (Model != null && Model.Any())
                {
                    foreach (var group in Model)
                    {
                        string statusClass = group.IsActive ? "active" : "inactive";
                        string statusText = group.IsActive ? "مفعل" : "معطل";

                        <a href="@Url.Action("GroupDetails", "Group", new { id = group.Id })" class="group-card-item group-card-link" data-name="@group.Name" data-status="@statusClass">
                            <!-- Card Header -->
                            <div class="group-card-header">
                                <h3 class="group-card-title">@group.Name</h3>
                            </div>

                            <!-- Card Body -->
                            <div class="group-card-body">
                                <div class="group-info-row">
                                    <i class="fas fa-user" style="color: var(--text-dark);"></i>
                                    <span>عدد الموظفين : @group.UsersCount</span>
                                </div>

                                <div class="group-info-row">
                                    <i class="far fa-calendar-alt" style="color: var(--text-dark);"></i>
                                    <span>@group.CreatedAt.ToString("d / M / yyyy")</span>
                                </div>

                                <div class="group-status-pill @statusClass" style="margin-top: 4px;">
                                    <i class="fas fa-circle" style="font-size: 8px;"></i>
                                    <span>@statusText</span>
                                </div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div style="grid-column: span 4; text-align: center; padding: 40px; color: var(--text-muted); font-size: 16px; font-weight: 700;">
                        لا توجد أي مجموعات حالياً
                    </div>
                }
            </div>
        </main>
    </div>

    <!-- ADD GROUP MODAL -->
    <div class="modal-overlay" id="addGroupModal">
        <div class="modal-box">
            <h3 class="modal-title">إضافة مجموعة جديدة</h3>
            <form asp-action="AddGroup" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group-modal">
                    <label style="font-weight: 700; font-size: 14px;">اسم المجموعة</label>
                    <input type="text" name="name" class="modal-input" placeholder="مثال: IT, Admin, Outdoor..." required />
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-modal-cancel" onclick="closeAddGroupModal()">إلغاء</button>
                    <button type="submit" class="btn-modal-submit">إضافة</button>
                </div>
            </form>
        </div>
    </div>

    <!-- SCRIPT FOR FILTERING & MODALS -->
    <script>
        function openAddGroupModal() {
            document.getElementById("addGroupModal").style.display = "flex";
        }
        function closeAddGroupModal() {
            document.getElementById("addGroupModal").style.display = "none";
        }

        window.onclick = function (e) {
            const m1 = document.getElementById("addGroupModal");
            if (e.target === m1) m1.style.display = "none";
        };

        // Client-side instant search & filter
        document.addEventListener("DOMContentLoaded", () => {
            const searchInput = document.getElementById("groupSearchInput");
            const statusFilter = document.getElementById("statusFilter");
            const cards = document.querySelectorAll(".group-card-item");

            function filterCards() {
                const query = (searchInput.value || "").trim().toLowerCase();
                const status = statusFilter.value;

                cards.forEach(card => {
                    const name = (card.dataset.name || "").toLowerCase();
                    const cardStatus = card.dataset.status || "active";

                    const matchesQuery = !query || name.includes(query);
                    const matchesStatus = (status === "all") || (cardStatus === status);

                    if (matchesQuery && matchesStatus) {
                        card.style.display = "flex";
                    } else {
                        card.style.display = "none";
                    }
                });
            }

            if (searchInput) searchInput.addEventListener("input", filterCards);
            if (statusFilter) statusFilter.addEventListener("change", filterCards);
        });
    </script>
</body>
</html>
