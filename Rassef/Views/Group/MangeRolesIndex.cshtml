@model Rassef.ViewModels.Group.RolesManagementVM
@{
    Layout = null;
    ViewData["Title"] = "إدارة الأدوار";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - رصيف</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/groupRolePages.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/detailsPages.css" asp-append-version="true">
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <!-- CHANGED: active key now "Roles" to match the new dedicated sidebar entry for this
             page (previously "Groups", which now only highlights GroupManagment). -->
        <partial name="_AdminSidebar" model='"Roles"' />

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <!-- HEADER -->
            <header class="dashboard-header">
                <div class="header-right">
                    <h2 class="header-title">إدارة الأدوار</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>آخر تحديث منذ 10 ثواني</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div style="background: #E8F5E9; color: #2E7D32; border: 1.5px solid #A5D6A7; padding: 12px 20px; border-radius: 10px; font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-check-circle"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div style="background: #FFEBEE; color: #C62828; border: 1.5px solid #FFCDD2; padding: 12px 20px; border-radius: 10px; font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <!-- 1. TOP SECTION: ALL GROUPS (CAROUSEL / HORIZONTAL ROW) -->
            <div class="section-underlined-title">
                كل المجموعات
            </div>

            <div class="horizontal-groups-row">
                @if (Model?.Groups != null && Model.Groups.Any())
                {
                    foreach (var group in Model.Groups)
                    {
                        string statusClass = group.IsActive ? "active" : "inactive";
                        string statusText = group.IsActive ? "مفعل" : "معطل";

                        <!-- CHANGED: whole card is now the click target (→ ManagePermissions for
                             this group) instead of just the small button at the bottom. Card is
                             now an <a>, not a <div> — can't nest the old <a class="btn-card-action">
                             inside another <a> (invalid HTML, unpredictable click behavior), so
                             that's now a non-interactive <span> kept purely as a visual label/cue
                             that the card is clickable. -->
                        <a href="@Url.Action("ManagePermissions", "Group", new { groupId = group.Id })" class="group-card-item" style="text-decoration: none; color: inherit; cursor: pointer;">
                            <!-- Card Header -->
                            <div class="group-card-header">
                                <h3 class="group-card-title">@group.Name</h3>
                            </div>

                            <!-- Card Body -->
                            <div class="group-card-body">
                                <div class="group-info-row">
                                    <i class="fas fa-user" style="color: var(--text-dark);"></i>
                                    <span>عدد الموظفين : @group.UsersCount</span>
                                </div>

                                <div class="group-info-row">
                                    <i class="far fa-calendar-alt" style="color: var(--text-dark);"></i>
                                    <span>@group.CreatedAt.ToString("d / M / yyyy")</span>
                                </div>

                                <div class="group-status-pill @statusClass">
                                    <i class="fas fa-circle" style="font-size: 8px;"></i>
                                    <span>@statusText</span>
                                </div>

                                <span class="btn-card-action" style="pointer-events: none;">
                                    <i class="fas fa-key"></i>
                                    <span>إدارة الصلاحيات</span>
                                </span>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div style="padding: 20px; color: var(--text-muted); font-weight: 700;">
                        لا توجد أي مجموعات حالياً
                    </div>
                }
            </div>

            <!-- 2. BOTTOM SECTION: ALL PERMISSIONS TABLE -->
            <!-- CHANGED: refresh is now a plain button wired to fetch()/AJAX, not a form POST —
                 pressing it never navigates the browser anywhere; it stays on this exact page and
                 shows the result inline. The antiforgery token still needs to travel with the
                 request, so it's hosted in a hidden form purely so JS can read its value. -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <div class="section-underlined-title" style="margin-bottom: 0;">
                    كل الصلاحيات
                </div>

                <form id="refreshPermissionsTokenForm" style="display: none;">
                    @Html.AntiForgeryToken()
                </form>
                <button type="button" id="btnRefreshPermissions" class="btn-card-action" style="width: auto; margin-top: 0; border: none; cursor: pointer;" onclick="refreshPermissions(this)">
                    <i class="fas fa-sync-alt"></i>
                    <span>تحديث الصلاحيات</span>
                </button>
            </div>

            <div id="refreshPermissionsAlert" style="display: none;"></div>

            <div class="permissions-table-wrapper">
                <table class="permissions-table">
                    <thead>
                        <tr>
                            <th style="width: 30%;">Controller</th>
                            <th style="width: 30%;">Action</th>
                            <th style="width: 40%;">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Permissions != null && Model.Permissions.Any())
                        {
                            foreach (var p in Model.Permissions)
                            {
                                <tr>
                                    <td style="font-weight: 700;">@p.Controller</td>
                                    <td style="font-weight: 600; color: var(--primary-color);">@p.Action</td>
                                    <td style="color: var(--text-muted);">@p.Description</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" style="text-align: center; padding: 30px; color: var(--text-muted);">
                                    لا توجد صلاحيات مسجلة
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <script>
        async function refreshPermissions(button) {
            const tokenInput = document.querySelector('#refreshPermissionsTokenForm input[name="__RequestVerificationToken"]');
            const alertBox = document.getElementById('refreshPermissionsAlert');
            const originalHtml = button.innerHTML;

            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>جارِ التحديث...</span>';

            try {
                const formData = new FormData();
                formData.append('__RequestVerificationToken', tokenInput.value);

                const response = await fetch('@Url.Action("RefreshPermissions", "Group")', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }

                const data = await response.json();
                showRefreshAlert(alertBox, data.success, data.message);

                if (data.success) {
                    // Reload this same page (same URL, no navigation elsewhere) after a moment so
                    // the permissions table below reflects anything newly discovered by the sync.
                    setTimeout(() => window.location.reload(), 900);
                }
            } catch (err) {
                showRefreshAlert(alertBox, false, 'حدث خطأ أثناء الاتصال بالخادم لتحديث الصلاحيات.');
                button.disabled = false;
                button.innerHTML = originalHtml;
            }
        }

        function showRefreshAlert(alertBox, success, message) {
            alertBox.style.display = 'flex';
            alertBox.style.alignItems = 'center';
            alertBox.style.gap = '8px';
            alertBox.style.padding = '12px 20px';
            alertBox.style.borderRadius = '10px';
            alertBox.style.fontWeight = '700';
            alertBox.style.fontSize = '14px';

            if (success) {
                alertBox.style.background = '#E8F5E9';
                alertBox.style.color = '#2E7D32';
                alertBox.style.border = '1.5px solid #A5D6A7';
                alertBox.innerHTML = '<i class="fas fa-check-circle"></i><span>' + message + '</span>';
            } else {
                alertBox.style.background = '#FFEBEE';
                alertBox.style.color = '#C62828';
                alertBox.style.border = '1.5px solid #FFCDD2';
                alertBox.innerHTML = '<i class="fas fa-exclamation-circle"></i><span>' + message + '</span>';
            }
        }
    </script>
</body>
</html>
