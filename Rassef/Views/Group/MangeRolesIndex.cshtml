@model Rassef.ViewModels.Group.RolesManagementVM
@{
    Layout = null;
    ViewData["Title"] = "إدارة الأدوار";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - رصيف</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/groupRolePages.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/detailsPages.css" asp-append-version="true">
</head>
<body>
    <div class="dashboard-page">
        <!-- SIDEBAR -->
        <partial name="_AdminSidebar" model='"Roles"' />

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <!-- HEADER -->
            <header class="dashboard-header">
                <div class="header-right">
                    <h2 class="header-title">إدارة الأدوار</h2>
                    <div class="header-subtitle">
                        <span class="update-dot"></span>
                        <span>آخر تحديث منذ 10 ثواني</span>
                    </div>
                </div>
                <div class="header-left-logos">
                    <img src="~/img/fathallah logo.svg" alt="فتح الله" class="header-logo-fathallah">
                    <img src="~/img/logo.svg" alt="رصيف" class="header-logo-raseef">
                </div>
            </header>

            <!-- Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div style="background: #E8F5E9; color: #2E7D32; border: 1.5px solid #A5D6A7; padding: 12px 20px; border-radius: 10px; font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-check-circle"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div style="background: #FFEBEE; color: #C62828; border: 1.5px solid #FFCDD2; padding: 12px 20px; border-radius: 10px; font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <!-- 1. TOP SECTION: ALL GROUPS (CAROUSEL / HORIZONTAL ROW) -->
            <div class="section-underlined-title">
                كل المجموعات
            </div>

            <div class="horizontal-groups-row">
                @if (Model?.Groups != null && Model.Groups.Any())
                {
                    foreach (var group in Model.Groups)
                    {
                        string statusClass = group.IsActive ? "active" : "inactive";
                        string statusText = group.IsActive ? "مفعل" : "معطل";

                        <div class="group-card-item">
                            <!-- Card Header -->
                            <div class="group-card-header">
                                <h3 class="group-card-title">@group.Name</h3>
                            </div>

                            <!-- Card Body -->
                            <div class="group-card-body">
                                <div class="group-info-row">
                                    <i class="fas fa-user" style="color: var(--text-dark);"></i>
                                    <span>عدد الموظفين : @group.UsersCount</span>
                                </div>

                                <div class="group-info-row">
                                    <i class="far fa-calendar-alt" style="color: var(--text-dark);"></i>
                                    <span>@group.CreatedAt.ToString("d / M / yyyy")</span>
                                </div>

                                <div class="group-status-pill @statusClass">
                                    <i class="fas fa-circle" style="font-size: 8px;"></i>
                                    <span>@statusText</span>
                                </div>

                                <!-- Manage Permissions Button -->
                                <a href="@Url.Action("ManagePermissions", "Group", new { groupId = group.Id })" class="btn-card-action">
                                    <i class="fas fa-key"></i>
                                    <span>إدارة الصلاحيات</span>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="padding: 20px; color: var(--text-muted); font-weight: 700;">
                        لا توجد أي مجموعات حالياً
                    </div>
                }
            </div>

            <!-- 2. BOTTOM SECTION: ALL PERMISSIONS TABLE -->
            <div class="section-underlined-title">
                كل الصلاحيات
            </div>

            <div class="permissions-table-wrapper">
                <table class="permissions-table">
                    <thead>
                        <tr>
                            <th style="width: 30%;">Controller</th>
                            <th style="width: 30%;">Action</th>
                            <th style="width: 40%;">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Permissions != null && Model.Permissions.Any())
                        {
                            foreach (var p in Model.Permissions)
                            {
                                <tr>
                                    <td style="font-weight: 700;">@p.Controller</td>
                                    <td style="font-weight: 600; color: var(--primary-color);">@p.Action</td>
                                    <td style="color: var(--text-muted);">@p.Description</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" style="text-align: center; padding: 30px; color: var(--text-muted);">
                                    لا توجد صلاحيات مسجلة
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</body>
</html>
