@{
    Layout = null;
    ViewData["Title"] = "استعادة كلمة المرور — رصيف";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --font-arabic: 'IBM Plex Sans Arabic', sans-serif;
            --primary-color: #EA7318;
            --primary-hover: #D1620E;
            --bg-page: #FAF0E6;
            --card-bg: #FFFDFB;
            --text-dark: #2B241D;
            --text-muted: #82756A;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: var(--font-arabic);
            background-color: var(--bg-page);
            color: var(--text-dark);
            direction: rtl;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .info-card {
            background-color: var(--card-bg);
            border: 2px solid #EFA267;
            border-radius: 24px;
            padding: clamp(28px, 6vw, 48px) clamp(20px, 5vw, 36px);
            max-width: 520px;
            width: 100%;
            text-align: center;
            box-shadow: 0 12px 32px rgba(234, 115, 24, 0.12);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }

        .info-icon-circle {
            width: 88px;
            height: 88px;
            background-color: #FFF1E3;
            border: 2px solid #F8D3B0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-color);
            font-size: 38px;
            margin-bottom: 8px;
        }

        .info-title { font-size: 26px; font-weight: 800; color: var(--text-dark); }

        .info-text {
            font-size: 16px;
            line-height: 1.9;
            color: var(--text-muted);
            font-weight: 500;
        }

        .info-steps {
            width: 100%;
            text-align: right;
            background: #FFF7EF;
            border: 1px solid #F8D3B0;
            border-radius: 14px;
            padding: 14px 18px;
            font-size: 15px;
            line-height: 1.9;
            color: var(--text-dark);
        }

        .btn-back {
            margin-top: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: var(--primary-color);
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            font-size: 16px;
            padding: 12px 28px;
            border-radius: 12px;
            transition: background-color .2s ease, transform .2s ease;
        }

        .btn-back:hover { background-color: var(--primary-hover); transform: translateY(-1px); color: #fff; }
    </style>
</head>
<body>
    <main class="info-card" role="main">
        <div class="info-icon-circle" aria-hidden="true">
            <i class="fa-solid fa-key"></i>
        </div>

        <h1 class="info-title">استعادة كلمة المرور</h1>

        <p class="info-text">
            لا يمكن إعادة تعيين كلمة المرور ذاتياً من هذه الصفحة.
            لاستعادة حسابك، يرجى التواصل مع مسؤول النظام أو الدعم الفني ليقوم بتعيين كلمة مرور جديدة لك.
        </p>

        <div class="info-steps">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            جهّز اسم المستخدم أو بريدك الإلكتروني المسجّل عند التواصل مع الدعم لتسريع الإجراء.
        </div>

        <a class="btn-back" asp-controller="Authentication" asp-action="Login">
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            العودة إلى تسجيل الدخول
        </a>
    </main>
</body>
</html>
