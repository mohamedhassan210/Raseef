@{
    Layout = null;
    ViewData["Title"] = "رصيفي | Intro";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">

    <link rel="stylesheet" href="~/css/intro.css">
</head>
<body class="is-loading">

    <div id="splash-screen" class="splash-screen">

        <div class="raseefi-wrapper">
            <img src="~/img/logo light.svg" alt="Raseefi Logo" class="raseefi-logo">
        </div>

        <div class="fathalla-wrapper">
            <img src="~/img/fathallah icon light.svg" alt="Fathalla Logo" class="fathalla-logo">
            <img src="~/img/fathallah text light.svg" alt="Fathalla Text" class="fathalla-text">
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/intro.js"></script>

    <script>
        // لو الأنيماشن بياخد مثلاً 3 ثواني، بنعمل Redirect بعد 3000ms
        setTimeout(function () {
            window.location.href = '@Url.Action("Login", "Authentication")';
        }, 3000); // غير الرقم ده حسب مدة الانترو عندك
    </script>
</body>
</html>