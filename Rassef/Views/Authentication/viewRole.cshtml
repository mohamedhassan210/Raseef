@model Rassef.ViewModels.QueueTicket.QueueTicketIndexVM
@{
    ViewData["Title"] = "الأدوار الحالية";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- خط IBM Plex Sans Arabic وأيقونات FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/viewRole.css" asp-append-version="true">
</head>
<body>

    <div class="page-container">
        <!-- الهيدر العلوي -->
        <header class="page-header">
            <div class="header-right">
                <h1 class="page-title">الأدوار الحالية</h1> 
                <div class="update-status">
                    <span class="status-dot"></span>
                    آخر تحديث منذ 10 ثواني
                </div>
                <!-- زر الرجوع موجه لكونترولر Authentication -->
                <a asp-controller="Authentication" asp-action="AddRoleOrView" class="back-btn">
                    <i class="fas fa-home"></i> الرجوع
                </a>
            </div>
        </header>

        <!-- أدوات التحكم (الفلاتر والبحث) -->
        <section class="controls-section">
            <div class="filters-container">
                <button class="filter-btn active" data-filter="الكل">الكل</button>
                <button class="filter-btn" data-filter="إنتظار">انتظار</button>
                <button class="filter-btn" data-filter="جاري">جاري</button>
                <button class="filter-btn" data-filter="تم">تم</button>
            </div>

            <div class="search-container">
                <input type="text" id="searchInput" placeholder="ادخل رقم الدور او العربية او اسم الموظف" autocomplete="off">
                <button class="search-icon" type="button" aria-label="بحث">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </section>

        <!-- بطاقات الإحصائيات -->
        <section class="stats-section">
            <!-- انتظار -->
            <div class="stat-card waiting-stat">
                <div class="stat-text-side">
                    <h3 class="stat-title">إنتظار</h3>
                    <div class="stat-number-row">
                        <span class="stat-number" id="waitCount">@(Model?.WaitingCount ?? 18)</span>
                    </div>
                    <span class="stat-label">دور في الانتظار</span>
                </div>
                <div class="stat-icon-wrapper">
                    <i class="far fa-clock"></i>
                </div>
            </div>

            <!-- جاري -->
            <div class="stat-card active-stat">
                <div class="stat-text-side">
                    <h3 class="stat-title">جاري</h3>
                    <div class="stat-number-row">
                        <span class="stat-number" id="activeCount">@(Model?.InProgressCount ?? 8)</span>
                    </div>
                    <span class="stat-label">دور جاري</span>
                </div>
                <div class="stat-icon-wrapper">
                    <i class="far fa-clock"></i>
                </div>
            </div>

            <!-- تم -->
            <div class="stat-card completed-stat">
                <div class="stat-text-side">
                    <h3 class="stat-title">تـ ــم</h3>
                    <div class="stat-number-row">
                        <span class="stat-number" id="doneCount">@(Model?.CompletedCount ?? 55)</span>
                    </div>
                    <span class="stat-label">دور تم</span>
                </div>
                <div class="stat-icon-wrapper">
                    <i class="far fa-clock"></i>
                </div>
            </div>
        </section>

        <!-- عنوان القائمة -->
        <div class="section-title-wrapper">
            <h2 class="section-title">قائمة الأدوار</h2>
        </div>

        <!-- قائمة الأدوار -->
        <section class="roles-section">
            <div id="rolesContainer" class="roles-container">
                @if (Model?.Tickets != null && Model.Tickets.Any())
                {
                    foreach (var ticket in Model.Tickets)
                    {
                        string statusDisplay = "إنتظار";
                        string statusClass = "status-pill-wait";

                        var norm = (ticket.TicketStatusName ?? "").Replace("إ", "ا").Trim();
                        if (norm.Contains("تم") || norm.Contains("مكتمل") || norm.Contains("منتهي") || norm.Contains("خروج"))
                        {
                            statusDisplay = "تم";
                            statusClass = "status-pill-done";
                        }
                        else if (norm.Contains("جاري") || norm.Contains("تنفيذ") || norm.Contains("تشغيل"))
                        {
                            statusDisplay = "جاري";
                            statusClass = "status-pill-active";
                        }
                        else
                        {
                            statusDisplay = "إنتظار";
                            statusClass = "status-pill-wait";
                        }

                        <div class="role-card"
                             data-status="@statusDisplay"
                             data-search="@ticket.TicketNumber @ticket.DriverName @ticket.TruckNumber @ticket.DepartmentName @ticket.DockName @ticket.RequestType @ticket.CompanyName">

                            <!-- 1. رقم الدور -->
                            <div class="card-col col-ticket">
                                <span class="ticket-num">@ticket.TicketNumber</span>
                                <span class="col-sublabel">رقم الدور</span>
                            </div>

                            <!-- 2. الحالة -->
                            <div class="card-col col-status">
                                <div class="status-pill @statusClass">
                                    <i class="far fa-dot-circle"></i>
                                    <span>@statusDisplay</span>
                                </div>
                            </div>

                            <!-- 3. السائق -->
                            <div class="card-col col-info">
                                <div class="col-icon"><i class="fas fa-user"></i></div>
                                <div class="col-details">
                                    <span class="col-maintext" title="@ticket.DriverName">@ticket.DriverName</span>
                                    <span class="col-sublabel">اسم السائق</span>
                                </div>
                            </div>

                            <!-- 4. رقم السيارة -->
                            <div class="card-col col-info">
                                <div class="col-icon"><i class="fas fa-truck"></i></div>
                                <div class="col-details">
                                    <span class="col-maintext" title="@ticket.TruckNumber">@ticket.TruckNumber</span>
                                    <span class="col-sublabel">رقم السيارة</span>
                                </div>
                            </div>

                            <!-- 5. رقم الرصيف -->
                            <div class="card-col col-info">
                                <div class="col-icon"><i class="fas fa-warehouse"></i></div>
                                <div class="col-details">
                                    <span class="col-maintext">@ticket.DockName</span>
                                    <span class="col-sublabel">رقم الرصيف</span>
                                </div>
                            </div>

                            <!-- 6. القسم -->
                            <div class="card-col col-info">
                                <div class="col-icon"><i class="fas fa-code-branch"></i></div>
                                <div class="col-details">
                                    <span class="col-maintext" title="@ticket.DepartmentName">@ticket.DepartmentName</span>
                                    <span class="col-sublabel">القسم</span>
                                </div>
                            </div>

                            <!-- 7. وقت الدخول -->
                            <div class="card-col col-info">
                                <div class="col-icon"><i class="far fa-clock"></i></div>
                                <div class="col-details">
                                    <span class="col-maintext">@ticket.EntryTime.ToString("hh:mm tt")</span>
                                    <span class="col-sublabel">وقت الدخول</span>
                                </div>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="far fa-clipboard"></i>
                        <p>لا توجد أدوار مسجلة حالياً في النظام.</p>
                    </div>
                }
            </div>
        </section>
    </div>

    <script src="~/js/viewRole.js" asp-append-version="true"></script>
</body>
</html>