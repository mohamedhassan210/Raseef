@{
    ViewData["Title"] = "الأدوار الحالية";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- استدعاء خط Cairo وأيقونات FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- استدعاء ملف التصميم -->
    <link rel="stylesheet" href="~/css/viewRole.css">
</head>
<body>

    <div class="page-container">
        <!-- رأس الصفحة (Header) -->
        <header class="page-header">
            <div class="header-right">
                <h1 class="page-title">الأدوار الحالية</h1>
                <div class="update-status">
                    <span class="status-dot"></span>
                    آخر تحديث منذ 10 ثواني
                </div>
                <!-- زر الرجوع موجه لكونترولر Authentication -->
                <a asp-controller="Authentication" asp-action="AddRoleOrView" class="back-btn">
                    <i class="fas fa-home"></i> الرجوع
                </a>
            </div>
            <div class="header-left">
                <img src="~/img/fathallah logo.svg" alt="Raseefi" class="logo raseefi-logo">
                <img src="~/img/logo.svg" alt="Fathallah" class="logo fathallah-logo">
            </div>
        </header>

        <!-- شريط البحث وفلاتر الحالة -->
        <section class="controls-section">
            <div class="filters-container">
                <button class="filter-btn active" data-filter="الكل">الكل</button>
                <button class="filter-btn" data-filter="إنتظار">إنتظار</button>
                <button class="filter-btn" data-filter="جاري">جاري</button>
                <button class="filter-btn" data-filter="تم">تم</button>
            </div>

            <div class="search-container">
                <input type="text" id="searchInput" placeholder="ادخل رقم الدور أو العربية أو اسم الموظف">
                <div class="search-icon">
                    <i class="fas fa-search"></i>
                </div>
            </div>
        </section>

        <!-- بطاقات الإحصائيات -->
        <section class="stats-section">
            <div class="stat-card waiting-stat">
                <h3 class="stat-title">إنتظار</h3>
                <div class="stat-data">
                    <span class="stat-number" id="waitCount">@Model.WaitingCount</span>
                    <span class="stat-label">دور في الانتظار</span>
                </div>
                <div class="stat-icon-wrapper"><i class="far fa-clock"></i></div>
            </div>

            <div class="stat-card active-stat">
                <h3 class="stat-title">جاري</h3>
                <div class="stat-data">
                    <span class="stat-number" id="activeCount">@Model.InProgressCount</span>
                    <span class="stat-label">دور جاري</span>
                </div>
                <div class="stat-icon-wrapper"><i class="far fa-clock"></i></div>
            </div>

            <div class="stat-card completed-stat">
                <h3 class="stat-title">تم</h3>
                <div class="stat-data">
                    <span class="stat-number" id="doneCount">@Model.CompletedCount</span>
                    <span class="stat-label">دور تم</span>
                </div>
                <div class="stat-icon-wrapper"><i class="far fa-clock"></i></div>
            </div>
        </section>

        <!-- قائمة الأدوار -->
        <section class="roles-section">
            <h2 class="section-title">قائمة الأدوار</h2>
            <div id="rolesContainer" class="roles-container">

                <!-- رسم الكروت من الموديل مباشرة -->
                @foreach (var ticket in Model.Tickets)
                {
                    // تحديد كلاس الـ CSS والشكل بناءً على الحالة
                    string statusClass = ticket.TicketStatusName == "تم" ? "completed" :
                    ticket.TicketStatusName == "جاري" ? "active" : "waiting";

                    // بنضيف data-status و data-search عشان الفلترة والجافاسكريبت
                    <div class="role-card @statusClass"
                         data-status="@ticket.TicketStatusName"
                         data-search="@ticket.TicketNumber @ticket.DriverName @ticket.TruckNumber @ticket.DepartmentName">

                        <!-- 1. رقم الدور (يمين الكارت) -->
                        <div class="card-ticket-number">
                            <span class="number">@ticket.TicketNumber</span>
                            <span class="label">رقم الدور</span>
                        </div>

                        <!-- 2. حالة الدور (Badge) -->
                        <div class="card-status-badge @statusClass">
                            <span>@ticket.TicketStatusName</span>
                        </div>

                        <!-- 3. بيانات السائق -->
                        <div class="card-info-item">
                            <i class="fas fa-user"></i>
                            <div>
                                <span class="value">@ticket.DriverName</span>
                                <span class="label">اسم السائق</span>
                            </div>
                        </div>

                        <!-- 4. رقم الشاحنة / السيارة -->
                        <div class="card-info-item">
                            <i class="fas fa-truck"></i>
                            <div>
                                <span class="value">@ticket.TruckNumber</span>
                                <span class="label">رقم السيارة</span>
                            </div>
                        </div>

                        <!-- 5. رقم الرصيف -->
                        <div class="card-info-item">
                            <i class="fas fa-warehouse"></i>
                            <div>
                                <span class="value">@ticket.DockName</span>
                                <span class="label">رقم الرصيف</span>
                            </div>
                        </div>

                        <!-- 6. القسم -->
                        <div class="card-info-item">
                            <i class="fas fa-code-branch"></i>
                            <div>
                                <span class="value">@ticket.DepartmentName</span>
                                <span class="label">القسم</span>
                            </div>
                        </div>

                        <!-- 7. وقت الدخول (يسار الكارت) -->
                        <div class="card-time-item">
                            <i class="far fa-clock"></i>
                            <div>
                                <span class="value">@ticket.EntryTime.ToString("hh:mm tt")</span>
                                <span class="label">وقت الدخول</span>
                            </div>
                        </div>

                    </div>
                }

            </div>
        </section>
    </div>

    <!-- استدعاء ملف الجافاسكريبت مباشرة بدون section -->
    <script src="~/js/viewRole.js"></script>
</body>
</html> 