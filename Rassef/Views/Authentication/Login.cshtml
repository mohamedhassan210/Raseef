@model LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيفي | تسجيل الدخول</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" integrity="sha384-dpuaG1suU0eT09tx5plTaGxkVSN06bSRL1qEFz628A6C5qOmjgqq67252l+SPBoW" crossorigin="anonymous">

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <div class="l-page">

        <header class="l-brand-header">
            <img src="~/img/fathallah logo.svg" alt="شعار فتح الله">
        </header>

        <main class="l-stage">

            <article class="c-card">

                <div class="c-card__logo">
                    <img src="~/img/logo.svg" alt="شعار رصيفي" width="260">
                </div>

                <form id="loginForm" asp-action="Login" asp-controller="Authentication" method="post" novalidate>

                    <div asp-validation-summary="ModelOnly" class="c-error-message" style="margin-bottom: 16px; text-align: center;"></div>

                    <div class="c-field">
                        <label class="c-field__label" asp-for="UserName">اسم المستخدم</label>
                        <div class="c-field__control-wrap">
                            <input type="text"
                                   id="username"
                                   asp-for="UserName"
                                   class="c-field__input"
                                   placeholder="أدخل اسم المستخدم"
                                   required
                                   autocomplete="username">
                            <span class="c-field__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21c0-4-3.6-7-8-7s-8 3-8 7" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                            </span>
                        </div>
                        <span class="c-error-message" id="usernameError" asp-validation-for="UserName"></span>
                    </div>

                    <div class="c-field">
                        <label class="c-field__label" asp-for="Password">كلمة المرور</label>
                        <div class="c-field__control-wrap">
                            <input type="password"
                                   id="password"
                                   asp-for="Password"
                                   class="c-field__input"
                                   placeholder="أدخل كلمة المرور"
                                   required
                                   autocomplete="current-password">
                            <span class="c-field__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="5" y="11" width="14" height="9" rx="2" />
                                    <path d="M8 11V8a4 4 0 0 1 8 0v3" />
                                </svg>
                            </span>
                        </div>
                        <span class="c-error-message" id="passwordError" asp-validation-for="Password"></span>

                        <a asp-controller="Authentication" asp-action="ForgetPassword" class="c-link">نسيت كلمة المرور ؟</a>
                    </div>

                    <button type="submit" class="c-button">تسجيل الدخول</button>

                    <div id="formAlert" class="c-alert d-none" role="alert">
                        <span id="alertMessage">يرجى التأكد من ملء الحقول المطلوبة بصورة صحيحة.</span>
                    </div>

                </form>

            </article>

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
</body>
</html>