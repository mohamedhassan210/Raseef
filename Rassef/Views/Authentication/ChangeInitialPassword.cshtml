@model Rassef.ViewModels.Authentication.ChangeInitialPasswordVM
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رصيفي | تغيير كلمة المرور لأول مرة</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" integrity="sha384-dpuaG1suU0eT09tx5plTaGxkVSN06bSRL1qEFz628A6C5qOmjgqq67252l+SPBoW" crossorigin="anonymous">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
    
    <style>
        .first-login-badge {
            background: rgba(235, 132, 45, 0.12);
            border: 1px solid #eb842d;
            color: #d96f14;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 0.92rem;
            font-weight: 600;
            margin-bottom: 20px;
            line-height: 1.5;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="l-page">

        <header class="l-brand-header">
            <img src="~/img/fathallah logo.svg" alt="شعار فتح الله">
        </header>

        <main class="l-stage">

            <article class="c-card" style="max-width: 480px;">

                <div class="c-card__logo">
                    <img src="~/img/logo.svg" alt="شعار رصيفي" width="230">
                </div>

                <div class="first-login-badge">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-left: 4px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    تنبيه أمان: هذا تسجيل دخولك الأول. يجب تغيير كلمة المرور الافتراضية (كود الموظف) لاختيار كلمة سر خاصة بك.
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-center py-2 mb-3" style="font-size: 0.95rem; font-weight: 600; border-radius: 8px;">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="ChangeInitialPassword" asp-controller="Authentication" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="c-error-message text-center mb-3"></div>

                    <!-- كلمة المرور الحالية (كود الموظف) -->
                    <div class="c-field">
                        <label class="c-field__label" asp-for="CurrentPassword">كلمة المرور الحالية (كود الموظف)</label>
                        <div class="c-field__control-wrap">
                            <input type="password"
                                   asp-for="CurrentPassword"
                                   class="c-field__input"
                                   placeholder="أدخل كود الموظف الحالي"
                                   required
                                   autocomplete="current-password">
                            <span class="c-field__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="5" y="11" width="14" height="9" rx="2" />
                                    <path d="M8 11V8a4 4 0 0 1 8 0v3" />
                                </svg>
                            </span>
                        </div>
                        <span class="c-error-message" asp-validation-for="CurrentPassword"></span>
                    </div>

                    <!-- كلمة المرور الجديدة -->
                    <div class="c-field">
                        <label class="c-field__label" asp-for="NewPassword">كلمة المرور الجديدة</label>
                        <div class="c-field__control-wrap">
                            <input type="password"
                                   asp-for="NewPassword"
                                   class="c-field__input"
                                   placeholder="أدخل كلمة المرور الجديدة (6 خانات على الأقل)"
                                   required
                                   autocomplete="new-password">
                            <span class="c-field__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5z" />
                                </svg>
                            </span>
                        </div>
                        <span class="c-error-message" asp-validation-for="NewPassword"></span>
                    </div>

                    <!-- تأكيد كلمة المرور الجديدة -->
                    <div class="c-field">
                        <label class="c-field__label" asp-for="ConfirmPassword">تأكيد كلمة المرور الجديدة</label>
                        <div class="c-field__control-wrap">
                            <input type="password"
                                   asp-for="ConfirmPassword"
                                   class="c-field__input"
                                   placeholder="أعد كتابة كلمة المرور الجديدة"
                                   required
                                   autocomplete="new-password">
                            <span class="c-field__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </span>
                        </div>
                        <span class="c-error-message" asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <button type="submit" class="c-button mt-4">حفظ وتعيين كلمة المرور الجديدة</button>

                    <div class="text-center mt-3">
                        <a asp-action="Logout" asp-controller="Authentication" style="color: #888; font-size: 0.88rem; text-decoration: none;">
                            تسجيل خروج والعودة لاحقاً
                        </a>
                    </div>
                </form>

            </article>

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
