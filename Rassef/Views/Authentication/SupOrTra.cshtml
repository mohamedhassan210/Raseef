@{
    ViewData["Title"] = "رصيف | اختيار الخدمة";
    Layout = "_SupOrTra";
    // No dedicated sidebar category for this role-picker screen — accordion
    // renders with nothing highlighted, same treatment as SupplyOrder/Index.
    ViewData["ActiveSidebar"] = "";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .btn-admin-dashboard {
            position: fixed;
            top: 887px;
            left: 90px;
            background-color: #e67e22;
            color: #ffffff !important;
            text-decoration: none;
            padding: 9px 18px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 2px solid #ffffff;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(230, 126, 34, 0.4);
            transition: all 0.2s ease;
            cursor: pointer;
            z-index: 20;
        }

            .btn-admin-dashboard:hover {
                background-color: #d35400;
                color: #ffffff !important;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(230, 126, 34, 0.5);
            }

        /* NEW — زرار "أمر توريد" ناحية التوريد (يمين، RTL) من تحت الشاشة. */
        .supply-order-btn {
            position: fixed;
            bottom: 25px;
            right: 25px;
            background-color: #EB842D;
            color: #ffffff !important;
            text-decoration: none;
            padding: 14px 28px;
            border: 2px solid #ffffff;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(235, 132, 45, 0.4);
            transition: all 0.2s ease;
            cursor: pointer;
            z-index: 10000;
        }

            .supply-order-btn:hover {
                background-color: #d3701f;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(235, 132, 45, 0.5);
            }

        /* NEW — نافذة إدخال رقم أمر التوريد */
        .supply-order-overlay {
            position: fixed;
            inset: 0;
            background: rgba(51, 45, 36, 0.55);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 20000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }

            .supply-order-overlay.active {
                opacity: 1;
                pointer-events: auto;
            }

        .supply-order-modal {
            background: #ffffff;
            border-radius: 16px;
            padding: 32px;
            width: 100%;
            max-width: 420px;
            text-align: center;
            direction: rtl;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
            transform: translateY(-16px);
            transition: transform 0.25s ease;
        }

            .supply-order-overlay.active .supply-order-modal {
                transform: translateY(0);
            }

        .supply-order-modal h2 {
            font-size: 1.4rem;
            font-weight: 700;
            color: #332D24;
            margin-bottom: 20px;
        }

        .supply-order-modal label {
            display: block;
            text-align: right;
            font-weight: 600;
            margin-bottom: 8px;
            color: #332D24;
        }

        .supply-order-modal input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid rgba(235, 132, 45, 0.35);
            border-radius: 10px;
            font-size: 1rem;
            text-align: right;
            margin-bottom: 8px;
        }

            .supply-order-modal input:focus {
                outline: none;
                border-color: #EB842D;
            }

        .supply-order-error {
            color: #dc3545;
            font-size: 0.9rem;
            margin-bottom: 12px;
            display: none;
        }

        .supply-order-actions {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }

            .supply-order-actions button {
                flex: 1;
                padding: 12px;
                border-radius: 10px;
                font-weight: 700;
                font-size: 1rem;
                cursor: pointer;
                border: 2px solid transparent;
            }

        .supply-order-confirm-btn {
            background-color: #EB842D;
            color: #ffffff;
        }

            .supply-order-confirm-btn:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .supply-order-cancel-btn {
            background-color: #ffffff;
            color: #EB842D;
            border-color: #EB842D !important;
        }
    </style>
}

<div class="custom-mvc-wrapper loading">
    <header class="app-header position-fixed top-0 start-0 w-100 d-flex justify-content-between align-items-center px-5 py-3">
        <div class="logo-wrapper logo-left" id="logo-raseefi">
            <!-- استخدام ~ للوصول إلى wwwroot/img -->
            <img src="~/img/fathallah logo.svg" style="width: 80px;" alt="">
        </div>
        <div class="logo-wrapper logo-right" id="logo-fathalla">
            <img src="~/img/logo light.svg" style="width: 200px;" alt="">
        </div>
    </header>

    <main class="viewport-canvas overflow-hidden">
        <div id="zone-transfer" class="hover-zone" style="left: 0;" data-url="@Url.Action("MainTraDrivers", "Truck")"></div>
        <div id="zone-supply" class="hover-zone" style="right: 0;" data-url="@Url.Action("Index", "Supplier")"></div>

        <section id="panel-supply" class="panel panel-supply">
            <div class="panel-content text-center">
                <h1 class="panel-title mb-0">توريد</h1>
            </div>
        </section>

        <section id="panel-transfer" class="panel panel-transfer">
            <div class="panel-content text-center">
                <h1 class="panel-title text-white mb-0">تحويل</h1>
            </div>
        </section>

        <svg class="svg-definitions">
            <defs>
                <clipPath id="wave-clip-desktop" clipPathUnits="objectBoundingBox">
                    <path id="wave-path-desktop" d="M 0,0 L 0.50,0 C 0.62,0.28 0.38,0.72 0.50,1.0 L 0,1.0 Z" />
                </clipPath>
            </defs>
        </svg>
    </main>
    <!-- Admin-dashboard pill + logout button REMOVED — both now live in the unified
         AdminSidebar, wired up via _SupOrTra layout, so every page using that layout
         gets them, not just this one. Note the old
         logout button pointed at the Login page rather than the real Logout action,
         so it never actually cleared the auth cookie — the sidebar's logout link
         goes to Authentication/Logout, which does. -->

    <!-- زر الرجوع للخلف -->
    <button id="stepback-btn" class="stepback-btn" aria-label="رجوع" data-url="@Url.Action("AddRoleOrView", "Authentication")">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 1-.5.5H2.707l3.147 3.146a.5.5 0 0 1-.708.708l-4-4a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 7.5H14.5A.5.5 0 0 1 15 8z" />
        </svg>
    </button>

    @* NEW — زرار "أمر توريد": بيفتح نافذة يدخل فيها المستخدم رقم أمر التوريد (وهو في
       الحالة دي كود المورد نفسه)، ولو الكود اتلاقى بيوديه على طول لصفحة اختيار
       الشاحنة ومعاه المورد مختار بالفعل، من غير ما يمر على قائمة الموردين. *@
    <button id="supply-order-btn" class="supply-order-btn" type="button" aria-haspopup="dialog" aria-controls="supply-order-overlay">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
            <path d="M8 1a.5.5 0 0 1 .5.5v6h6a.5.5 0 0 1 0 1h-6v6a.5.5 0 0 1-1 0v-6h-6a.5.5 0 0 1 0-1h6v-6A.5.5 0 0 1 8 1z" />
        </svg>
        أمر توريد
    </button>

    <div id="supply-order-overlay" class="supply-order-overlay" role="dialog" aria-modal="true" aria-labelledby="supply-order-title">
        <div class="supply-order-modal">
            <h2 id="supply-order-title">إدخال رقم أمر التوريد</h2>
            <label for="supply-order-input">رقم أمر التوريد</label>
            <input type="text" id="supply-order-input" placeholder="ادخل رقم أمر التوريد" autocomplete="off" inputmode="numeric">
            <div id="supply-order-error" class="supply-order-error"></div>
            <div class="supply-order-actions">
                <button type="button" id="supply-order-cancel" class="supply-order-cancel-btn">إلغاء</button>
                <button type="button" id="supply-order-confirm" class="supply-order-confirm-btn">تأكيد</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.appRoutes = window.appRoutes || {};
    window.appRoutes.findSupplierByCode = '@Url.Action("FindByCode", "Supplier")';
    window.appRoutes.truckIndex = '@Url.Action("Index", "Truck")';
</script>

@section Scripts {
    <script src="~/js/beforhome.js" asp-append-version="true"></script>
    <script src="~/js/supplyOrder.js" asp-append-version="true"></script>
}