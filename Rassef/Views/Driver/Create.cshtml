@model CreateDriverVM
@{
    ViewData["Title"] = "إضافة سائق";
    Layout = "_SupOrTra";
    var selectedSupplier = Model?.Suppliers?.FirstOrDefault(s => s.Value == Model?.SupplierId?.ToString());
    var displaySupplierName = !string.IsNullOrWhiteSpace(Model?.SupplierName)
        ? Model.SupplierName
        : (selectedSupplier != null ? selectedSupplier.Text : "اختر الشركة");
    var hasPredefinedSupplier = (Model?.SupplierId != null && Model.SupplierId > 0) || !string.IsNullOrWhiteSpace(Model?.SupplierName);
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="~/css/addDriver.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/companyCars.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/companyDrivers.css" asp-append-version="true">
}

<main class="page-container">
    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">إضافة سائق</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="logo-raseefy" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
        </div>
    </header>

    <div class="nav-actions-container" style="justify-content: flex-end;">
        <a href="@Url.Action("Index", "Truck", new { supplierId = Model?.SupplierId })" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="form-card mt-3">
        <form id="addDriverForm" class="needs-validation" asp-action="Create" asp-controller="Driver" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SupplierName" />

            <div class="row mb-4 gy-4">
                <div class="col-md-6 order-md-1">
                    <label asp-for="FullName" class="form-label fw-bold">اسم السائق</label>
                    <div class="position-relative">
                        <input asp-for="FullName" type="text" class="form-control custom-input" id="driverName" placeholder="ادخل اسم السائق رباعي" pattern="^[\u0600-\u06FF]+(?:\s+[\u0600-\u06FF]+){2,}$" required autocomplete="off">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال الاسم الثلاثي باللغة العربية.</div>
                        <span asp-validation-for="FullName" class="text-danger mt-2 d-block text-center"></span>
                    </div>
                </div>

                <div class="col-md-6 order-md-2">
                    <label asp-for="Phone" class="form-label fw-bold">رقم الهاتف</label>
                    <div class="position-relative">
                        <input asp-for="Phone" type="text" class="form-control custom-input" id="driverPhone" placeholder="ادخل رقم الهاتف" pattern="^01[0125][0-9]{8}$" required autocomplete="tel">
                        <div class="invalid-feedback text-center mt-2">يرجى إدخال رقم هاتف مصري صحيح.</div>
                        <span asp-validation-for="Phone" class="text-danger mt-2 d-block text-center"></span>
                    </div>
                </div>

                <div class="col-md-6 order-md-3">
                    <label asp-for="NationalId" class="form-label fw-bold">الرقم القومي</label>
                    <div class="position-relative">
                        <input asp-for="NationalId" type="text" class="form-control custom-input" id="nationalId" placeholder="ادخل الرقم القومي للسائق" pattern="^[0-9]{14}$" required autocomplete="off">
                        <div class="invalid-feedback text-center mt-2">الرقم القومي يجب أن يتكون من 14 رقمًا.</div>
                        <span asp-validation-for="NationalId" class="text-danger mt-2 d-block text-center"></span>
                    </div>
                </div>

                <div class="col-md-6 order-md-4">
                    <label asp-for="SupplierId" class="form-label fw-bold">شركة السائق</label>

                    <div class="position-relative @(hasPredefinedSupplier ? "d-none" : "")" id="companySelectView">
                        <select asp-for="SupplierId" class="d-none" id="companySelect" required="@(hasPredefinedSupplier ? null : "required")">
                            <option value="" disabled>اختر الشركة</option>
                            @if (Model?.Suppliers != null)
                            {
                                foreach (var supplier in Model.Suppliers)
                                {
                                    <option value="@supplier.Value">@supplier.Text</option>
                                }
                            }
                        </select>

                        <div class="custom-dropdown" id="customDropdown">
                            <div class="dropdown-header">
                                <span class="selected-value @(selectedSupplier != null ? "" : "placeholder-color")">@(selectedSupplier?.Text ?? "اختر الشركة")</span>
                                <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#e47925" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="18 15 12 9 6 15"></polyline>
                                </svg>
                            </div>
                            <div class="dropdown-list">
                                @if (Model?.Suppliers != null && Model.Suppliers.Any())
                                {
                                    foreach (var supplier in Model.Suppliers)
                                    {
                                        <div class="dropdown-item @(supplier.Value == Model?.SupplierId?.ToString() ? "selected" : "")" data-value="@supplier.Value">@supplier.Text</div>
                                    }
                                }
                                else
                                {
                                    <div class="dropdown-item disabled text-muted">لا توجد شركات متاحة</div>
                                }
                            </div>
                        </div>
                        <div class="invalid-feedback text-center mt-2">يرجى اختيار شركة السائق.</div>
                        <span asp-validation-for="SupplierId" class="text-danger mt-2 d-block text-center"></span>
                    </div>

                    <div class="position-relative static-view-container @(hasPredefinedSupplier ? "" : "d-none")" id="companyStaticView">
                        <input type="text" class="form-control custom-input text-end static-input" id="companyDisplay" value="@displaySupplierName" readonly>

                        @if (hasPredefinedSupplier)
                        {
                            <input type="hidden" asp-for="SupplierId" id="hiddenSupplierId" />
                        }
                    </div>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>
            <button type="submit" class="w-100 submit-btn mt-4">إضافة سائق جديد</button>
        </form>
    </section>
</main>

<div id="custom-modal-overlay" class="custom-modal-overlay" aria-hidden="true">
    <!-- Modal 0: Department Selection -->
    <div id="department-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="department-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <rect x="9" y="3" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="3" y="17" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="15" y="17" width="6" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
                    <path d="M12 7v5M6 17v-3h12v3M18 14v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
        </div>
        <div class="modal-body text-center w-100 mt-4">
            <h2 id="department-modal-title" class="modal-title" style="margin-bottom: 24px;">اختار القسم</h2>
            <div class="custom-dropdown" id="dept-dropdown-container">
                <div class="dropdown-header" id="dept-dropdown-header">
                    <span class="selected-value text-muted" id="dept-selected-value">اختار القسم</span>
                    <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="#EB842D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
                <div class="dropdown-list" id="dept-dropdown-list"></div>
                <div class="invalid-feedback text-right mt-2" id="dept-error-msg" style="display: none; color: #dc3545; font-size: 0.95rem; font-weight: 500;">
                    يرجى اختيار القسم للمتابعة.
                </div>
            </div>
        </div>
        <div class="modal-actions mt-4" style="margin-top: 32px !important;">
            <button id="btn-confirm-dept" class="btn-primary-custom w-100" aria-label="تأكيد القسم">تأكيد</button>
        </div>
    </div>

    <!-- Modal 1: Data Confirmation -->
    <div id="confirmation-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-question-lg" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M4.475 5.458c-.284 0-.514-.237-.47-.517C4.28 3.24 5.576 2 7.825 2c2.25 0 3.767 1.36 3.767 3.215 0 1.344-.665 2.288-1.79 2.973-1.1.659-1.414 1.118-1.414 2.01v.03a.5.5 0 0 1-.5.5h-.77a.5.5 0 0 1-.5-.495l-.003-.2c-.043-1.221.477-2.001 1.645-2.712 1.03-.632 1.397-1.135 1.397-2.028 0-.979-.758-1.698-1.926-1.698-1.009 0-1.71.529-1.938 1.402-.066.254-.278.461-.54.461h-.777ZM7.496 14c.622 0 1.095-.474 1.095-1.09 0-.618-.473-1.092-1.095-1.092-.606 0-1.087.474-1.087 1.091S6.89 14 7.496 14" />
                </svg>
            </div>
        </div>
        <div class="modal-body data-grid mt-4 firstModelcontent">
            <div class="data-row">
                <span class="data-label">الشركة :</span>
                <span class="data-value" id="confirm-company"></span>
            </div>
            <div class="data-row">
                <span class="data-label">السائق :</span>
                <span class="data-value" id="confirm-driver-name"></span>
            </div>
            <div class="data-row">
                <span class="data-label">الرقم القومي :</span>
                <span class="data-value" id="confirm-driver-id"></span>
            </div>
            <div class="data-row">
                <span class="data-label">القسم :</span>
                <span class="data-value" id="confirm-driver-dep"></span>
            </div>
        </div>
        <div class="modal-actions">
            <button id="btn-edit" class="btn-secondary-custom" aria-label="تعديل البيانات">تعديل</button>
            <button id="btn-confirm" class="btn-primary-custom" aria-label="تأكيد البيانات">تأكيد</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.departmentsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Departments ?? new List<object>()));
        window.pageData = {
            dockName: 'A',
            employeeName: '@Html.Raw(!string.IsNullOrWhiteSpace(User.Identity?.Name) ? User.Identity.Name : "المسؤول")'
        };
        window.appRoutes = {
            companyDrivers: '@Url.Action("Index", "Driver")',
            receiptPage: '@Url.Action("Recript", "Driver")'
        };
    </script>
    <script src="~/js/addDriver.js" asp-append-version="true"></script>
}