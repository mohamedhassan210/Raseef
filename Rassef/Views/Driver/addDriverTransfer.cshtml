@{
    ViewData["Title"] = "إضافة سائق";
    Layout = "_SupOrTra";
}
@model CreateDriverVM
@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="~/css/addDriver.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/companyCars.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/companyDrivers.css" asp-append-version="true">
}

<main class="page-container">
    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
        </div>
        <div class="title-wrapper">
            <h1 class="main-title">إضافة سائق</h1>
        </div>
        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="logo-raseefy" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
        </div>
    </header>

    <div class="nav-actions-container" style="justify-content: flex-end;">
        <a href="@Url.Action("TransferDrivers", "Driver")" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="form-card mt-3">
        <form id="addDriverForm" method="post" asp-action="addDriverTransfer" class="needs-validation" novalidate>

            <input type="hidden" asp-for="SupplierId" />
            <input type="hidden" asp-for="TruckId" />

            <div class="row mb-4 gy-4">
                <div class="col-md-6 order-md-1">
                    <label for="driverName" class="form-label fw-bold">اسم السائق</label>
                    <div class="position-relative">
                        <input type="text" asp-for="FullName" class="form-control custom-input" id="driverName" placeholder="ادخل اسم السائق رباعي" required autocomplete="off">
                    </div>
                </div>

                <div class="col-md-6 order-md-2">
                    <label for="driverPhone" class="form-label fw-bold">رقم الهاتف</label>
                    <div class="position-relative">
                        <input type="text" asp-for="Phone" class="form-control custom-input" id="driverPhone" placeholder="ادخل رقم الهاتف" required autocomplete="tel">
                    </div>
                </div>

                <div class="col-md-6 order-md-3">
                    <label for="nationalId" class="form-label fw-bold">الرقم القومي</label>
                    <div class="position-relative">
                        <input type="text" asp-for="NationalId" class="form-control custom-input" id="nationalId" placeholder="ادخل الرقم القومي للسائق" required autocomplete="off">
                    </div>
                </div>

                <div class="col-md-6 order-md-4">
                    <label class="form-label fw-bold">شركة السائق</label>

                    <div class="position-relative static-view-container" id="companyStaticView">
                        <input type="text" class="form-control custom-input text-end static-input"
                               id="companyDisplay"
                               value="@(string.IsNullOrEmpty(Model.SupplierName) ? "جهينة" : Model.SupplierName)"
                               readonly />
                    </div>
                </div>
            </div>

            <button type="submit" class="w-100 submit-btn mt-4">إضافة سائق جديد</button>
        </form>

    </section>
</main>


@section Scripts {

    <script>
        window.pageData = {
            dockName: 'A',
            employeeName: 'محمد حسين'
        };

        window.appRoutes = {
            companyDrivers: '@Url.Action("TransferDrivers", "Driver")',
            createTransferRequest: '@Url.Action("Create", "TransferRequest")'
        };
    </script>

    <script src="~/js/addDriverTransfer.js" asp-append-version="true"></script>
}