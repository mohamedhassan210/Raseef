@{
    ViewData["Title"] = "إيصال الدخول";
    Layout = null; // صفحة الطباعة مش محتاجة Layout عشان تطلع مظبوطة في الورقة
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- استدعاء ملف الـ CSS -->
    <link rel="stylesheet" href="~/css/receipt.css" asp-append-version="true">
</head>
<body>

    <!-- حالة عدم وجود بيانات -->
    <div id="empty-state" class="empty-state d-none">
        <h2>لا توجد بيانات إيصال متاحة حالياً</h2>
        <button class="btn-action" id="btn-back-empty">العودة للسائقين</button>
    </div>

    <!-- حاوية الإيصال الرئيسية -->
    <main id="receipt-main" class="receipt-container d-none">

        <!-- أزرار التحكم (تختفي عند الطباعة) -->
        <div class="receipt-actions no-print">
            <button class="btn-action btn-back" id="btn-back">العودة</button>
            <button class="btn-action btn-print" id="btn-print-receipt">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                طباعة الإيصال
            </button>
        </div>

        <!-- الـ Badge الخاص بالإيصال -->
        <div class="receipt-badge" id="printable-area">

            <!-- الهيدر واللوجوهات -->
            <div class="badge-header">
                <img src="~/img/fathallah logo.svg" alt="فتح الله" class="logo-fathalla" onerror="this.src='https://via.placeholder.com/100x50?text=Fathalla'">
                <img src="~/img/logo.svg" alt="رصيفي" class="logo-raseefy" onerror="this.src='https://via.placeholder.com/100x50?text=Raseefy'">
            </div>

            <div class="badge-divider-solid">
                <div class="clock-icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#332D24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
            </div>

            <!-- رقم الدور -->
            <div class="badge-section text-center">
                <h3 class="section-title">رقم الدور</h3>
                <div class="ticket-number" id="rec-ticket-num">--</div>
            </div>

            <!-- نوع الطلب -->
            <div class="badge-section text-center" style="margin-top: 5px;">
                <h3 class="section-title">نوع الطلب</h3>
                <div class="waiting-number" id="rec-request-type" style="font-size: 1.25rem; font-weight: 700; color: #e47925;">توريد</div>
            </div>

            <!-- الانتظار -->
            <div class="badge-section text-center">
                <h3 class="section-title">الإنتظار</h3>
                <div class="waiting-number" id="rec-waiting">--</div>
            </div>

            <!-- القسم و الرصيف -->
            <div class="badge-grid">
                <div class="grid-item">
                    <h3 class="section-title">القسم</h3>
                    <div class="grid-value" id="rec-department">--</div>
                </div>
                <div class="grid-item">
                    <h3 class="section-title">رقم الرصيف</h3>
                    <div class="grid-value" id="rec-dock">--</div>
                </div>
            </div>

            <div class="badge-divider-dashed"></div>

            <!-- بيانات الإصدار -->
            <div class="badge-footer-info">

                <div class="employee-info">
                    <div class="emp-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#EB842D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <div class="emp-text">
                        <span class="info-label">اسم الموظف</span>
                        <span class="info-value" id="rec-employee">--</span>
                    </div>
                </div>

                <div class="datetime-info">
                    <div class="dt-row">
                        <span class="dt-value" id="rec-date">--</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#EB842D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    <div class="dt-row mt-1">
                        <span class="dt-value" id="rec-time" dir="ltr">--</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#EB842D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                </div>

            </div>

            <!-- الـ Bottom Wave -->
            <div class="badge-wave">
                <svg viewBox="0 0 1440 250" preserveAspectRatio="none" width="100%" height="100%">
                    <path fill="#EB842D" d="M0,64L48,80C96,96,192,128,288,138.7C384,149,480,139,576,122.7C672,107,768,85,864,96C960,107,1056,149,1152,160C1248,171,1344,149,1392,138.7L1440,128L1440,250L1392,250C1344,250,1248,250,1152,250C1056,250,960,250,864,250C768,250,672,250,576,250C480,250,384,250,288,250C192,250,96,250,48,250L0,250Z"></path>
                    <path fill="#332D24" d="M0,128L48,138.7C96,149,192,171,288,165.3C384,160,480,128,576,117.3C672,107,768,117,864,133.3C960,149,1056,171,1152,165.3C1248,160,1344,128,1392,112L1440,96L1440,250L1392,250C1344,250,1248,250,1152,250C1056,250,960,250,864,250C768,250,672,250,576,250C480,250,384,250,288,250C192,250,96,250,48,250L0,250Z"></path>
                </svg>
            </div>

        </div>
    </main>

    <script>
        // نمرر مسار زر الرجوع للـ JS
        window.routes = {
            // التعديل هنا: التوجيه لـ Index داخل كنترولر Driver
            driversPage: '@Url.Action("Index", "Driver")'
        };
    </script>
    <script src="~/js/receipt.js" asp-append-version="true"></script>
</body>
</html>