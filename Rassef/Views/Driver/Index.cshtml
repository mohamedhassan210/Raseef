@{
    ViewData["Title"] = "سائقين جهينة";
    Layout = "_SupOrTra"; // تأكد من اسم الـ Layout الخاص بك
}
@model IEnumerable<Rassef.ViewModels.Driver.DriverListVM>
<!-- استدعاء الخطوط ومكتبات التصميم (Bootstrap & Icons) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

<!-- استدعاء الـ CSS -->
<link rel="stylesheet" href="~/css/companyDrivers.css" asp-append-version="true" />

<main class="page-container">

    <header class="page-header">
        <div class="logo-wrapper header-right">
            <img src="~/img/fathallah logo.svg" alt="فتح الله" class="brand-Fathalla" onerror="this.src='https://via.placeholder.com/120x60?text=Fathalla'">
        </div>

        <div class="title-wrapper">
            <!-- عنوان ثابت -->
            <h1 class="main-title" id="page-title">سائقين @ViewBag.SupplierName</h1>
        </div>

        <div class="logo-wrapper header-left">
            <img src="~/img/logo.svg" alt="رصيفي" class="brand-logo logo-raseefy" style="height: 80px;" onerror="this.src='https://via.placeholder.com/120x60?text=Raseefy'">
        </div>
    </header>

    <div class="nav-actions-container">
        <!-- التوجيه لصفحة إضافة سائق -->
        <a asp-controller="Driver" asp-action="Create" class="action-btn" aria-label="إضافة جديد">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            إضافة جديد
        </a>

        <!-- التوجيه للرجوع لصفحة السيارات -->
        <a asp-controller="Truck" asp-action="Index" class="action-btn" aria-label="خطوة للخلف">
            خطوة للخلف
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
    </div>

    <section class="search-section" aria-label="البحث عن سائق">
        <div class="search-wrapper">
            <button type="button" class="search-btn" id="search-btn" aria-label="بحث">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
            <!-- شريط البحث (يتم تصفيته بواسطة الجافاسكريبت) -->
            <input type="text" id="search-input" class="search-input" placeholder="ادخل رقم البطاقة أو اسم السائق" aria-label="ادخل رقم البطاقة أو اسم السائق للبحث" autocomplete="off">
        </div>
    </section>

    <!-- قائمة السائقين (بيانات وهمية ثابتة) -->
    <section class="cards-section" id="cards-container" aria-label="قائمة السائقين">
        @if (Model != null && Model.Any())
        {
            foreach (var driver in Model)
            {
                <article class="driver-card" data-name="@driver.FullName" data-id="@driver.NationalId">
                    <div class="btnAndArticle">
                        <div class="driver-avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                            </svg>
                        </div>
                        <div class="card-details">
                            <h2 class="driver-name">@driver.FullName</h2>
                            <div class="driver-meta">
                                <div class="meta-item">
                                    <!-- أيقونة الموبايل -->
                                    <svg class="type-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                                    <span>@driver.Phone</span>
                                </div>
                                <div class="meta-item">
                                    <!-- أيقونة البطاقة -->
                                    <svg class="type-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M21 3H3c-1.11 0-2 .89-2 2v14c0 1.11.89 2 2 2h18c1.11 0 2-.89 2-2V5c0-1.11-.89-2-2-2zm-9 15H4v-2h8v2zm0-4H4v-2h8v2zm0-4H4V8h8v2zm7 8h-4v-6h4v6zm0-8h-4V8h4v2z" /></svg>
                                    <span>@driver.NationalId</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-action">
                        <button class="select-btn" type="button" aria-label="اختيار السائق">اختيار السائق</button>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="text-center mt-5" style="color: var(--dark-text); font-size: 1.2rem;">
                لا يوجد سائقين مسجلين لهذا المورد.
            </div>
        }
    </section>
</main>

<!-- Two-Step Modal System -->
<div id="custom-modal-overlay" class="custom-modal-overlay" aria-hidden="true">

    <!-- Modal 1: Data Confirmation -->
    <div id="confirmation-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-question-lg" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M4.475 5.458c-.284 0-.514-.237-.47-.517C4.28 3.24 5.576 2 7.825 2c2.25 0 3.767 1.36 3.767 3.215 0 1.344-.665 2.288-1.79 2.973-1.1.659-1.414 1.118-1.414 2.01v.03a.5.5 0 0 1-.5.5h-.77a.5.5 0 0 1-.5-.495l-.003-.2c-.043-1.221.477-2.001 1.645-2.712 1.03-.632 1.397-1.135 1.397-2.028 0-.979-.758-1.698-1.926-1.698-1.009 0-1.71.529-1.938 1.402-.066.254-.278.461-.54.461h-.777ZM7.496 14c.622 0 1.095-.474 1.095-1.09 0-.618-.473-1.092-1.095-1.092-.606 0-1.087.474-1.087 1.091S6.89 14 7.496 14" />
                </svg>
            </div>
        </div>

        <div class="modal-header-icon01">
            <div class="icon-circle01"></div>
        </div>

        <!-- Content Grid -->
        <div class="modal-body data-grid mt-4 firstModelcontent">
            <div class="data-row">
                <span class="data-label">الشركة :</span>
                <span class="data-value" id="confirm-company"></span>
            </div>
            <div class="data-row">
                <span class="data-label">السيارة :</span>
                <span class="data-value" id="confirm-truck"></span>
            </div>
            <div class="data-row">
                <span class="data-label">السائق :</span>
                <span class="data-value" id="confirm-driver-name"></span>
            </div>
        </div>

        <div class="modal-actions">
            <button id="btn-edit" class="btn-secondary-custom" aria-label="تعديل البيانات">تعديل</button>
            <button id="btn-confirm" class="btn-primary-custom" aria-label="تأكيد البيانات">تأكيد</button>
        </div>
    </div>

    <!-- Modal 2: Success & Ticket -->
    <div id="success-modal" class="custom-modal-container d-none" role="dialog" aria-modal="true" aria-labelledby="success-modal-title">
        <div class="modal-header-icon">
            <div class="icon-circle green-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
        </div>

        <div class="modal-body text-center w-100 mt-4">
            <h2 id="success-modal-title" class="modal-title success-text">تم تأكيد البيانات بنجاح</h2>
            <div class="ticket-box">
                <span id="ticket-number" class="ticket-number-text"></span>
            </div>
        </div>

        <div class="modal-actions">
            <button id="btn-back" class="btn-secondary-custom" aria-label="الرجوع">الرجوع</button>
            <button id="btn-print" class="btn-primary-custom" aria-label="طباعة البون">طباعة</button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- بيانات وهمية ثابتة لتغذية المودال (بديل للـ Model) -->
    <script>
        window.pageData = {
            companyName: '@ViewBag.SupplierName',
            truckName: '@ViewBag.TruckName',
            dockName: 'A'
        };

        window.routes = {
            supplierIndex: '@Url.Action("Index", "Supplier")',
            authSupOrTra: '@Url.Action("SupOrTra", "Authentication")'
        };

        <script src="~/js/companyDrivers.js" asp-append-version="true"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>

    </script>

    <script src="~/js/companyDrivers.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
} 